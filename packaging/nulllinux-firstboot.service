[Unit]
# The machine half of the installation, which cannot happen any earlier.
#
# A machine profile is generated from the attached display, and there is no
# display in the chroot an ISO is built in -- so this waits for the first boot
# that has one. It also selects the atlas and the hero for the strike that
# profile chooses, from the sets the package ships.
#
# After=graphical.target is wrong here: this must finish BEFORE a session
# starts, or the first login draws with no atlas. It needs the DRM devices,
# not a compositor.
Description=nullLinux first boot: machine profile and surfaces
After=systemd-udev-settle.service local-fs.target
Wants=systemd-udev-settle.service
ConditionPathExists=!/var/lib/nulllinux/firstboot-done

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=NULL_ROOT=/opt/nulllinux
ExecStart=/opt/nulllinux/bin/null-firstboot
# A failure here must not be silent, and must not be fatal to the boot: a
# machine that cannot generate a profile should still reach a login prompt
# where someone can read the journal and fix it.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
