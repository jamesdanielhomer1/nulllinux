[Unit]
Description=nullLinux: the virtual console's sixteen colours
Documentation=man:setvtrgb(8)
# THE PALETTE MUST BE SET BEFORE ANYTHING DRAWS ON THE CONSOLE.
#
# systemd-vconsole-setup owns the font and keymap and reads /etc/vconsole.conf,
# which has no field for colours at all -- so this is a separate unit rather
# than a setting. After it, because vconsole-setup resets the console.
After=systemd-vconsole-setup.service
Before=getty.target display-manager.service
ConditionPathExists=/etc/vconsole/vtrgb
ConditionVirtualization=!container

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/setvtrgb /etc/vconsole/vtrgb
# A console that keeps the kernel's colours is worse-looking, not broken, so a
# failure here must never hold up the boot or fail the target.
SuccessExitStatus=0 1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
