# Derived files are never committed (NULL.md §5.7). Anything listed here must
# be rebuildable, byte-identically, from a committed source.
#
# A DISTRIBUTION SHIPS THEM ANYWAY (§0.5): the bake runs once on the build
# host and its output goes into the package, not into git. The rule is about
# history, not about what reaches a user's disk.

/bake/out/
/bake/frames/
*.hdr
/assets/master.hdrcells
/assets/palette.bin
/assets/*.png
/assets/*.ans
/target/
/render/target/
/bake/gpu/target/
*.o
__pycache__/
*.pyc
*.swp
.DS_Store
/assets/placeholder.cells
/assets/placeholder-report.json
/assets/atlas-*.bin
/config/sway/colours.conf
/assets/master.cells
/assets/target-*.cells
/assets/tty.cells
/assets/logo.cells
/assets/*-report.json
/system/plymouth-theme/
/system/sddm-theme/

# Build products of the distribution itself.
/packaging/build/
/packaging/*.iso
/packaging/rpmbuild/

# The prebuilt assets that ship in the package (§0.5, §5.7).
#
# DERIVED, so they are not committed -- and 13 MB of them would be the largest
# thing in this repository by an order of magnitude. They are made by
# bin/null-prebake on a machine with a GPU and travel as the package's Source1,
# which is where a built artefact belongs.
/assets/prebuilt/

# Build products of the packaging itself. An RPM in git is the same mistake as
# a baked asset in git, and this one was 8.9 MB -- larger than every source
# file in the repository put together.
/packaging/repo/
/packaging/rpmbuild/
/packaging/*.iso
