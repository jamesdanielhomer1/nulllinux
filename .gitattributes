# Keep Linux script and build-input line endings valid on Windows checkouts.
* text=auto eol=lf
*.png binary
*.gz binary
*.bin binary
*.cells binary
*.hero binary
*.hdrcells binary
licenses/OFL.txt -text
# Upstream notice bytes include original line endings and trailing whitespace.
licenses/adwaita/COPYING* -text whitespace=-blank-at-eol,-blank-at-eof
licenses/rust-stdlib/** -text whitespace=-blank-at-eol,-blank-at-eof
