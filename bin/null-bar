#!/usr/bin/env bash
# Start the bar -- ONE PER SCREEN (NULL.md §7.2).
#
# The bar named no output, so with two monitors both bars landed on whichever
# screen the compositor chose and the other had none. It is per-screen
# furniture: every screen gets one, pinned to it.
#
# Each also gets the interface strike that suits ITS screen. A 4K monitor and a
# 1366x768 laptop want different sized type, and one installed atlas can only
# ever be right for one of them (`machine choose-interface`).
#
# Stops any instance of ITSELF first, matched on the EXECUTABLE rather than the
# command line: a command-line match catches any shell that merely mentions the
# name, including the one doing the matching (§8.6).
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
BIN="$ROOT/render/target/release/bar"
RENDER="$ROOT/render/target/release/render"
TAG=null-bar

# THIS TAKES NO ARGUMENTS, AND SAYS SO.
#
# It used to take any and ignore all of them. `null-bar --help` therefore did
# not print help: it displaced the running component and supervised for ever,
# so asking a question restarted a piece of the desktop and then hung. A typo'd
# flag did the same thing in silence, which is the failure this project keeps
# finding in other clothes.
case "${1:-}" in
  '') ;;
  -h|--help)
    echo "usage: null-bar"
    echo
    echo "  the bar, on every output."
    echo "#   Supervises one bar process per connected output, restarting
#   any that dies and following screens as they are plugged in." | sed 's/^#   //'
    echo
    echo "  Takes no arguments. The compositor starts it (config/sway/config),"
    echo "  and starting it again displaces the copy that is running."
    exit 0 ;;
  *)
    echo "null-bar: unknown argument '$1' -- this command takes none" >&2
    exit 2 ;;
esac
[ -x "$BIN" ] || { echo "$TAG: $BIN not built" >&2; exit 1; }

SELF=$(readlink -f "$BIN")
for pid in $(pgrep -x -u "$(id -u)" bar 2>/dev/null || true); do
  exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null | sed 's/ (deleted)$//') || continue
  [ "$exe" = "$SELF" ] && kill "$pid" 2>/dev/null || true
done

. "$ROOT/lib/supervise.sh"

start_one() {  # <output-name> <w> <h>
  local name=$1 w=$2 h=$3 pick atlas ramp cw ch cols
  pick=$("$ROOT/bin/machine" choose-interface "$w" "$h" 2>/dev/null) || {
    echo "$TAG: no interface strike fits ${w}x${h} on $name" >&2; return 1; }
  read -r atlas ramp cw ch cols <<<"$pick"
  env NULL_ROOT="$ROOT" "$BIN" --atlas "$atlas" --ramp "$ramp" --output "$name" &
  CHILD["$name"]=$!
  printf '%s: %-12s %sx%s  cell %sx%s  %s cols  %s\n' \
    "$TAG" "$name" "$w" "$h" "$cw" "$ch" "$cols" "$(basename "$atlas")"
}

supervise
