#!/usr/bin/env bash
# What is left for one user, after null-install has done the rest.
#
# ALMOST NOTHING IS LEFT, and that is the point. bin/null-install puts the
# compositor configuration, the GTK theme, the icon theme, the settings-key
# defaults, the terminal, notifier and monitor configuration, and the file
# manager defaults where the SYSTEM looks for them -- so a new account gets
# this desktop by logging in, not by running a script.
#
# One thing genuinely cannot be done that way: a browser reads userChrome.css
# only from inside a profile, and a profile belongs to a person. So that is
# what this does, and it is optional -- skip it and the browser is simply left
# alone.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}

# WHERE THIS REPORTS TO.
#
# It is started by `exec` from the compositor configuration, so everything it
# printed went to sway's own output -- the session journal, if anything was
# capturing it. It says useful things: which joins it made, which it skipped,
# whether the audio daemon answered. All of it went somewhere no person would
# think to look, on the one run of the one tool that sets a new account up.
#
# So: a transcript at a findable path, and a NOTIFICATION only when something
# went wrong. Silent when it worked, because a notification on every login for
# a thing that succeeded is a notification people learn to dismiss unread.
#
# The previous run is kept as .1. Two runs is enough to compare "it worked
# yesterday" against today, and an unbounded log in a home directory is litter.
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/nulllinux/firstrun.log"
if mkdir -p "$(dirname "$LOG")" 2>/dev/null; then
  [ -f "$LOG" ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
  exec > >(tee "$LOG") 2>&1
fi

# Anything matching this is worth interrupting somebody for. Deliberately
# narrow: "skipped" is a normal outcome here and must not fire it.
TROUBLE='could not|cannot|failed|refus|no such|permission denied|does not answer'

report_trouble() {
  [ -r "$LOG" ] || return 0
  # DISTINCT problems, not lines. One missing D-Bus session produces the same
  # "Failed to init libxfconf" seven times, and "7 things to look at" for one
  # thing is how a notification becomes something people dismiss unread.
  local n first
  n=$(grep -iE "$TROUBLE" "$LOG" 2>/dev/null | sed 's/^ *//' | sort -u | grep -c . || echo 0)
  [ "${n:-0}" -gt 0 ] || return 0
  first=$(grep -iE "$TROUBLE" "$LOG" 2>/dev/null | sed 's/^ *//' | sort -u | head -1)
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u normal -a nullLinux "First-run setup: $n thing(s) to look at" \
      "$first
Full transcript: $LOG"
  fi
  printf '\n%s\n' "  $n thing(s) worth reading in $LOG"
}
trap report_trouble EXIT

# THE SHELL AND GIT JOINS, which nothing called until a clean machine showed
# that nothing called them. §9.8 describes joining nullLinux's shell prompt and
# git colours into files that belong to the user -- and like the browser
# chrome, those files are per-user and cannot be installed system-wide. This is
# the tool for things in that category, so this is where they belong.
#
# THESE RUN FOR ROOT TOO. The refusal below is about a BROWSER PROFILE, which
# belongs to a person; root has a shell and a git configuration like anybody
# else, and on a machine with no other account yet -- which every machine is,
# once -- refusing outright left root with no prompt and no way to get one.
# null-join now declines when /etc/profile.d/nulllinux.sh already reaches every
# account, so on an installed system this prints one line and touches nothing;
# on a development checkout, where /etc belongs to another installation, it
# still does the per-user join it was written for.
"$ROOT/bin/null-join" join

# THE FILE MANAGER'S OWN SETTINGS, for the same reason. null-install writes
# thunar's system-wide defaults, and two of its keys -- the location bar and
# the side pane -- are ones thunar only ever writes per user, so the
# system-wide file cannot set them and nothing else did. `check` reported them
# unset on a clean machine and was right to.
"$ROOT/bin/null-filemanager" apply

# THE SETTINGS KEYS, which had no caller at all.
#
# §8.10: a settings key outranks a configuration file wherever both exist, so a
# font or icon theme left in the settings database by a previous desktop wins
# over everything null-install wrote -- silently, because nothing reports it.
# bin/null-toolkit was written for exactly that and then nothing ever ran it.
#
# ABOVE THE ROOT EARLY-EXIT, for the reason the joins are: root has settings
# keys like anybody else. Placed below it, this ran for nobody on a machine
# whose only account was root -- which every machine is, once.
#
# ONCE PER ACCOUNT, not every session. These are the user's own keys: correcting
# a stale value inherited from another desktop is the job, and overwriting a
# deliberate choice on every login is not. The stamp is what makes this a
# first run rather than a policy.
stamp="${XDG_STATE_HOME:-$HOME/.local/state}/nulllinux/toolkit-keys"
echo "== toolkit settings keys (§8.10)"
if [ -e "$stamp" ]; then
  echo "  already applied once for $(id -un) -- leaving this account's keys alone"
  echo "  (delete $stamp to re-apply)"
else
  if "$ROOT/bin/null-toolkit" --apply; then
    mkdir -p "$(dirname "$stamp")" && : > "$stamp"
  else
    echo "  not applied -- see the refusal above; no stamp written, so this retries"
  fi
fi

if [ "$(id -u)" -eq 0 ]; then
  echo
  echo "The browser chrome is NOT applied: it lives inside a browser profile,"
  echo "and a profile belongs to a person. Run this again as that person."
  exit 0
fi

echo "user: $(id -un)"
echo "system install: $ROOT"
echo

if [ ! -r /etc/sway/config ] || ! grep -q "$ROOT" /etc/sway/config 2>/dev/null; then
  echo "NOTE: /etc/sway/config does not point at $ROOT."
  echo "      Run 'sudo $ROOT/bin/null-install --apply' first -- otherwise this"
  echo "      account gets the distribution's desktop, not this one."
  echo
fi

# CONFIGURATION FOR PROGRAMS THAT HAVE NO SYSTEM-WIDE PATH.
#
# btop reads $XDG_CONFIG_HOME/btop and nothing else -- there is no /etc for it.
# null-install wrote /etc/xdg/btop/btop.conf anyway, for as long as the file
# has existed, and btop never read a line of it: outside the column it came up
# in its own colours with the braille glyphs this system bans.
#
# So it is seeded here, once, and then it belongs to the user. Never
# overwritten: a config a person has edited is theirs, and silently replacing
# it at every login is the behaviour that makes people delete the tool that
# does it.
echo
echo "== configuration for programs with no system-wide path"
for pair in "btop|btop.conf"; do
  app=${pair%%|*}; f=${pair##*|}
  src="$ROOT/config/$app/$f"
  dst="${XDG_CONFIG_HOME:-$HOME/.config}/$app/$f"
  if [ ! -r "$src" ]; then
    echo "  $app: no $src -- nothing to seed"
  elif [ -e "$dst" ]; then
    echo "  $app: $dst exists already -- left alone"
  else
    mkdir -p "$(dirname "$dst")"
    if cp -a "$src" "$dst"; then echo "  $app: seeded $dst"
    else echo "  $app: could not write $dst" >&2; fi
  fi
done

echo
echo "== browser chrome (the one per-user piece)"
"$ROOT/bin/null-firefox" --apply || echo "  skipped"

echo
echo "== audio, which is why the session is not root"
if command -v wpctl >/dev/null && wpctl status >/dev/null 2>&1; then
  echo "  the audio daemon answers"
else
  echo "  the audio daemon does not answer -- if this is a root session, that is why"
fi

echo
echo "Nothing else is per-user. If you want to diverge from the system"
echo "configuration, write your own ~/.config/sway/config and it takes over."
