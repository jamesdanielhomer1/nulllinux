#!/usr/bin/env bash
# Reconcile this machine's profile and surfaces with the hardware that is here.
#
# WHAT CANNOT BE DONE EARLIER. A machine profile is generated from the display
# that is actually attached, and an ISO is built in a chroot that has none. The
# strike that profile selects then decides which atlas and which prebuilt hero
# are correct -- so the package ships all of them and this picks.
#
# THIS RUNS ON EVERY BOOT, NOT ONCE.
#
# It was a first-boot job, and that was wrong for a reason that only shows up
# when a disk moves: the profile is keyed on hostname, the hostname travels
# with the disk, and a stale profile therefore still resolves. Pull this drive
# into another machine and it would keep the strikes, the atlas and the hero
# chosen for a panel that is no longer attached -- silently, because a profile
# that exists looks like a profile that is right.
#
# The cost of running every boot is one `machine check-profile`: read the
# profile, read one DRM connector, compare. When they agree this exits in
# milliseconds having touched nothing. When they do not, the machine has moved,
# and everything below re-runs against the hardware that is actually present.
#
# NOTHING HERE IS EXPENSIVE. The choosing is a handful of file copies; the
# raytrace was done when the package was built. On a machine with no prebuilt
# hero for its strike this says so and leaves the placeholder, rather than
# starting a two-hour bake on a machine someone is waiting to log into.
set -uo pipefail
ROOT=${NULL_ROOT:-/opt/nulllinux}
# NOT "firstboot-done": this runs every boot. The stamp records that the
# SURFACES have been placed, which is a different question from whether the
# profile is current -- a moved disk has a stamp and a wrong profile.
STAMP=/var/lib/nulllinux/surfaces-placed
cd "$ROOT" || exit 1

echo "nullLinux: reconciling with the hardware"

# 1. The profile, from the hardware that is actually here.
#
# THE TEST IS "does it still describe this machine", not "does it exist". The
# second is true on a disk that has been moved, which is the whole problem.
# THE ORDINARY BOOT IS THE ONE TO MAKE CHEAP.
#
# Every boot after the first has nothing to do, and this ran two `bin/machine`
# subprocesses to find that out -- each one a shell that re-derives its root,
# re-reads the profile and probes DRM. Measured at ~300 ms of "nothing to do"
# on every boot, on the path that gates the greeter.
#
# The stamp is a single stat, and without it there is work to do regardless of
# what the profile says. So it is checked FIRST, and the expensive question is
# only asked when the answer can still change the outcome.
if [ -e "$STAMP" ] && bin/machine check-profile >/dev/null 2>&1; then
  echo "  profile matches the hardware, surfaces already placed -- nothing to do"
  exit 0
fi

if ! bin/machine profile >/dev/null 2>&1; then
  echo "  no profile yet"
  bin/machine generate || { echo "  could not generate a machine profile" >&2; exit 1; }
elif bin/machine check-profile; then
  # Nothing has changed. If the surfaces were placed on an earlier boot there
  # is nothing left to do, and this is the path every ordinary boot takes.
  if [ -e "$STAMP" ]; then
    echo "  nothing to do"
    exit 0
  fi
  echo "  profile is current, but the surfaces have not been placed"
else
  echo "  regenerating for the hardware that is here"
  bin/machine generate || { echo "  could not generate a machine profile" >&2; exit 1; }
fi

iface=$(bin/machine get interface_strike) || exit 1
bake=$(bin/machine get bake_strike)       || exit 1

# The interface strike is named for fontconfig; its atlas is named for the
# console font, which is the same strike with a `1` for the `u` (§6.2).
iface_psf=$iface; case $iface_psf in ter-u*) iface_psf="ter-1${iface_psf#ter-u}" ;; esac

P="$ROOT/assets/prebuilt"
took=0
# SAME-FILE IS NOT AN ERROR. Source0 already carries assets/palette.json, and
# Source1 carries an identical copy under prebuilt/ -- rpm hardlinks files with
# identical content, so cp is sometimes asked to copy a file onto itself and
# refuses. That is not a failure; it means the file is already right.
copy() {
  [ -e "$1" ] || return 0
  [ "$1" -ef "$2" ] && return 0
  cp -a --remove-destination "$1" "$2" && took=$((took+1))
}

# 2. The palette and the two strikes' atlases and ramps.
copy "$P/strikes/palette.bin"                 assets/palette.bin
copy "$P/strikes/palette.json"                assets/palette.json
copy "$P/strikes/atlas-$iface_psf.bin"        assets/atlas-interface.bin
copy "$P/strikes/ramp-$iface_psf.json"        assets/ramp-interface.json
copy "$P/strikes/atlas-$bake.bin"             assets/atlas-bake.bin
echo "  strikes: $iface (interface, atlas $iface_psf) + $bake (bake)"

# 3. The hero, for this machine's bake strike.
if [ -d "$P/$bake" ]; then
  for f in master.cells target-2.cells target-4.cells tty.cells logo.cells ramp-bake.json; do
    copy "$P/$bake/$f" "assets/$f"
  done
  echo "  hero: prebuilt for $bake"
else
  # STATED, not silently substituted. A desktop drawing the placeholder looks
  # like a working desktop, and someone should be able to find out why.
  echo "  hero: NO PREBUILT SET FOR $bake"
  echo "        The package ships heroes for the bake strikes common panels"
  echo "        select. This machine chose one outside that set."
  echo "        Bake it with:  $ROOT/bin/null-build --force"
fi

# 4. The palette-derived surfaces, TAKEN FROM THE PACKAGE rather than rebuilt.
#
# The compositor's colours, both GTK themes, the terminal's configuration, the
# shell's and the icon theme are functions of the palette alone -- no strike, no
# geometry, no hardware. Deriving them here would produce the same bytes from
# the same input and would need numpy, pillow and gobject on a machine that
# needs none of them for anything else.
T="$P/theme"
if [ -d "$T" ]; then
  for f in config/sway/colours.conf config/foot/foot.ini config/shell/colours.sh; do
    copy "$T/$f" "$f"
  done
  for d in config/gtk-3.0 config/gtk-4.0; do
    [ -d "$T/$d" ] && mkdir -p "$d" && cp -a "$T/$d/." "$d/" && took=$((took+1))
  done
  echo "  theme: prebuilt"
else
  echo "  theme: not in the package -- deriving it here (needs python)"
  python3 bake/export_theme.py >/dev/null 2>&1 || echo "  warning: export_theme did not complete"
fi

# 5. The boot splash and the login greeter, which are the first two surfaces
#    anyone sees and were the two that never got installed. bin/null-system
#    puts them where plymouth and sddm look; it was only ever SUGGESTED, by a
#    line bin/null-bootstrap prints, so on every machine installed from an ISO
#    both were stock Fedora.
if [ -d "$P/boot" ]; then
  mkdir -p system
  cp -a "$P/boot/plymouth-theme" system/ 2>/dev/null
  cp -a "$P/boot/sddm-theme" system/ 2>/dev/null
  if bin/null-system sddm --apply >/dev/null 2>&1; then
    echo "  greeter: installed and selected"
  else
    echo "  greeter: could NOT be installed"
  fi
  # PLYMOUTH IS NOT APPLIED HERE, and that is deliberate.
  #
  # The splash lives in the initramfs, so a bad one is not a cosmetic problem:
  # it is a machine that does not boot. null-system refuses without
  # --fallback-verified, meaning somebody has confirmed the fallback entry
  # works BY ACTUALLY REBOOTING INTO IT. A first-boot service is exactly the
  # wrong place to make that promise on a user's behalf.
  #
  # So the theme is placed where it can be applied, and the machine says how.
  if [ -d /usr/share/plymouth/themes ]; then
    echo "  splash:  staged, not applied -- it rewrites the initramfs, so it"
    echo "           waits for someone to verify the fallback boot entry:"
    echo "             null-system plymouth --check"
    echo "             null-system plymouth --apply --fallback-verified"
  fi
else
  echo "  boot surfaces: not in the package -- splash and greeter stay stock"
fi

# 6. The system-wide install, which is what makes a new account need no setup.
# NOT >/dev/null. This discarded every line null-install prints, including
# "no <file> -- skipping", which is how a missing session entry produced a
# greeter offering Fedora's Sway on a fresh install with nothing said anywhere:
# the tool reported the problem and the caller threw the report away.
#
# Run ONCE, output kept, then filtered to the lines that report a problem -- so
# an ordinary boot stays quiet and an unusual one does not.
install_log=$(bin/null-install --apply 2>&1); install_rc=$?
printf '%s\n' "$install_log" \
  | grep -iE '^[[:space:]]*(no |could not|refus|warn|fail)' \
  | sed 's/^/    /' || true
[ "$install_rc" -eq 0 ] && echo "  installed system-wide" \
  || echo "  warning: the system-wide install did not complete (exit $install_rc)"

mkdir -p "$(dirname "$STAMP")" && date -Iseconds > "$STAMP"
echo "  done ($took prebuilt files placed)"
