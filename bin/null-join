#!/usr/bin/env bash
# Join a file that is not ours (NULL.md §9.8).
#
# Adds ONE line pointing at a file this system owns, guarded by a marker so a
# second run is a no-op, backing up first. Never overwrites.
#
# The corresponding check is phrased as "is the join still there", not "does
# our file exist" -- the second is true in every case that matters and in the
# failure case too.
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
MARK="# >>> nullLinux >>>"

join_one() {  # <target> <line>
  local target=$1 line=$2
  # AN EXISTING BLOCK IS REPLACED, NOT SKIPPED.
  #
  # Skipping meant a join could never be repaired. When the shell fragment was
  # renamed, every machine that had already been joined kept sourcing a path
  # that no longer existed -- and printed an error on every shell it opened --
  # while this reported "already joined" and did nothing about it.
  #
  # The block is delimited, so replacing it is exact: everything between the
  # marker and its closing line goes, and the current content takes its place.
  if [ -e "$target" ] && grep -qF "$MARK" "$target"; then
    if grep -qF "$line" "$target"; then
      echo "  already joined: $target"; return 0
    fi
    cp -a "$target" "$target.null-backup.$(date +%Y%m%d-%H%M%S)"
    # Delete the old block, then fall through and append the current one.
    sed -i "/^$(printf '%s' "$MARK" | sed 's/[][\.*^$\/]/\\&/g')\$/,/^# <<< nullLinux <<<\$/d" "$target"
    echo "  replacing a stale join in $target"
  fi
  if [ -e "$target" ]; then
    cp -a "$target" "$target.null-backup.$(date +%Y%m%d-%H%M%S)"
  fi
  { echo ""; echo "$MARK"; echo "$line"; echo "# <<< nullLinux <<<"; } >> "$target"
  echo "  joined: $target"
}

check_one() {  # is the JOIN still there
  local target=$1
  if [ ! -e "$target" ]; then
    # NOT THE SAME FAILURE as a file that exists without the join.
    #
    # A cloud image's root has no .bashrc at all, and there is nothing to join
    # into; a machine where someone deleted the join has a file that should
    # contain it and does not. Reporting both as "MISSING" made the first look
    # like a broken install, and it is not one.
    echo "  absent:  $target -- nothing to join into"; return 0
  fi
  if grep -qF "$MARK" "$target"; then
    echo "  present: $target"; return 0
  fi
  echo "  MISSING: $target -- the file exists but the join is not in it"; return 1
}

# IS THIS SYSTEM ACTUALLY RUNNING NULLLINUX?
#
# A join is missing on two very different machines: one where nullLinux is
# installed and someone removed the join -- a real fault -- and a BUILD HOST,
# which is only a checkout and has nothing to join into yet. Reporting both as
# a failure made the verification suite permanently red on the machine the
# suite is run from, and a suite that is always red is a suite nobody reads.
#
# The test is whether /etc/sway/config points at THIS checkout, which is what
# `null-install --apply` does and the only thing that makes the joins expected.
installed_here() {
  [ -r /etc/sway/config ] && grep -qF "$ROOT/config/sway/config" /etc/sway/config
}

# THE SYSTEM-WIDE ROUTE, which is now the primary one (bin/null-install).
#
# /etc/profile.d and /etc/gitconfig reach every account, including accounts
# that do not exist yet, without touching a single file that belongs to a user.
# Where that is in place there is nothing to join and joining anyway would put
# a redundant block in somebody's .bashrc.
system_wide() {
  [ -r /etc/profile.d/nulllinux.sh ] &&
  grep -qF "$ROOT/config/shell/null.sh" /etc/profile.d/nulllinux.sh
}

case "${1:-join}" in
  join)
    if system_wide; then
      echo "  system-wide already: /etc/profile.d/nulllinux.sh reaches every account"
      echo "  (nothing to join; run null-join only where /etc is not ours to write)"
      exit 0
    fi
    join_one "$HOME/.bashrc" "NULL_ROOT=$ROOT . \"$ROOT/config/shell/null.sh\""
    join_one "$HOME/.gitconfig" "[include]
	path = $ROOT/config/git/config"
    ;;
  check)
    # The question is "does the shell reach this user", not "is there a join".
    # A system-wide install answers it without one.
    if system_wide; then
      echo "  present: /etc/profile.d/nulllinux.sh -> $ROOT/config/shell/null.sh"
      if git config --system --get include.path 2>/dev/null | grep -qF "$ROOT/config/git/config"; then
        echo "  present: /etc/gitconfig include.path -> $ROOT/config/git/config"
      else
        echo "  MISSING: /etc/gitconfig does not include $ROOT/config/git/config"
        exit 1
      fi
      exit 0
    fi
    if ! installed_here; then
      echo "  not installed here -- /etc/sway/config does not include $ROOT"
      echo "  (a checkout, not an installed system; nothing is expected to be joined)"
      exit 0
    fi
    fail=0
    check_one "$HOME/.bashrc" || fail=1
    check_one "$HOME/.gitconfig" || fail=1
    exit $fail ;;
  *) echo "usage: null-join [join|check]" >&2; exit 2 ;;
esac
