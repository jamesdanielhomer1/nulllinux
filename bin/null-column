#!/usr/bin/env bash
# Start the column (NULL.md §7.3).
#
# Stops any instance of ITSELF first, matched on the executable rather than the
# command line -- a command-line match catches any shell that merely mentions
# the name, including the one doing the matching (§8.6).
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
BIN="$ROOT/render/target/release/column"
[ -x "$BIN" ] || { echo "null-column: $BIN not built" >&2; exit 1; }
SELF=$(readlink -f "$BIN")
for pid in $(pgrep -x column 2>/dev/null || true); do
  exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null | sed 's/ (deleted)$//') || continue
  [ "$exe" = "$SELF" ] && kill "$pid" 2>/dev/null || true
done
exec env NULL_ROOT="$ROOT" "$BIN"
