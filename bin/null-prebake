#!/usr/bin/env bash
# Produce the prebuilt hero assets that ship in the package (NULL.md §0.5).
#
# WHY ANY OF THIS SHIPS. The hero is 0.39 s a frame on a discrete GPU and
# 28.27 s a frame on software Vulkan -- two minutes against two hours for the
# full 240. A machine with a real Vulkan device can bake its own; a virtual
# machine or a headless install cannot be asked to. So the expensive part is
# done once, here, on a machine that has a GPU, and travels in the package.
#
# WHAT SHIPS IS THE QUANTISED HERO, NOT THE HDR MASTER. The master is 423 MB
# and is the thing worth keeping (§5.1) -- but it is an INTERMEDIATE, and
# everything downstream of it re-runs in about a minute. What a machine needs
# is the .cells files, which are a thousandth of the size.
#
# ONE SET PER BAKE STRIKE, AND EVERY STRIKE. The quantiser measures ink against
# the strike's own ramp (derive_targets passes assets/ramp-bake.json), so a
# quantised hero belongs to one strike and cannot be reused across others.
#
# Twelve common panel sizes select only four distinct bake strikes between
# them, and the first version of this shipped those four. That was wrong, and
# James put it plainly: the master always comes out the same, so why would any
# machine ever bake? It should just be shipped.
#
# He is right, and it is now demonstrated rather than assumed -- two bakes of
# the 240-frame master are BIT-IDENTICAL, same sha256 (NULL.md 5.6). So the
# expensive step happens once in the life of the project, and the only reason
# to ship four rather than nine was to save four megabytes. Nine leaves no
# machine without a hero and no fallback path to get wrong.
#
# Everything else -- palette, ramps, atlases, the compositor colours, the icon
# theme, the boot surfaces -- is seconds of work and is NOT shipped. Shipping a
# thing that is cheap to derive is how a package comes to disagree with the
# source it was built from.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
cd "$ROOT"

MASTER=${1:-assets/master.hdrcells}
OUT=assets/prebuilt

# The bake strikes real hardware selects. Derived by asking bin/machine's own
# chooser for every common panel size, not by picking sizes that seemed likely.
STRIKES=$(for f in /usr/lib/kbd/consolefonts/ter-1*n.psf.gz; do
            [ -r "$f" ] && basename "$f" .psf.gz; done | sort -u | tr '\n' ' ')

[ -d "$MASTER" ] || { echo "null-prebake: no HDR master at $MASTER" >&2
                      echo "  Run the bake first: bin/null-build" >&2; exit 1; }

# The tone curve is swept ONCE, against the master, and the same curve is used
# for every strike. It is a property of the emission model (§4.1, Appendix A),
# not of the font -- so sweeping it per strike would be four answers to one
# question, and they would differ only by quantisation noise.
echo "sweeping the tone curve against $MASTER"
TONE=$(python3 bake/tune.py --frames-dir "$MASTER" 2>/dev/null \
       | grep -oE -- '--black-pct [0-9.]+ --white-pct [0-9.]+ --gamma [0-9.]+' | head -1)
[ -n "$TONE" ] || { echo "null-prebake: the tone sweep produced nothing" >&2; exit 1; }
echo "  $TONE"
echo

# THE MASTER ITSELF, which is the thing a screen derives its own grid from.
#
# The forty-five quantised grids below are FIXED, and a screen that matches
# none of them gets the nearest -- exact on 1920x1080 and 2560x1440 and on
# nothing else. This is nine megabytes, smaller than all forty-five together,
# and any grid can be derived from it exactly (bake/derive_for_screen.py).
#
# The swept tone curve goes INSIDE it. The curve is a property of the emission
# model rather than of a grid (§4.1), so every derived grid must use the one
# that was swept here -- a machine deriving its own cannot re-run the sweep,
# and the defaults blank a third of the subject.
echo "packing the master ($TONE)"
if ! python3 bake/pack_master.py --frames-dir "$MASTER" --out "$OUT/master.hero" \
     $(printf '%s' "$TONE" | sed 's/--black-pct/--black-pct/') 2>&1 | sed 's/^/  /'; then
  echo "null-prebake: packing the master failed" >&2; exit 1
fi
echo

saved_ramp=$(mktemp); cp assets/ramp-bake.json "$saved_ramp" 2>/dev/null || true
restore() { [ -s "$saved_ramp" ] && cp "$saved_ramp" assets/ramp-bake.json; rm -f "$saved_ramp"; }
trap restore EXIT

# The strike the splash and greeter are rendered at. One of the nine, chosen
# because 6x12 with target-4 gives 960x540 -- small enough to fit any screen
# worth booting, and the frames are rasterised PNGs by the time anyone sees
# them, so nothing downstream depends on which strike drew them.
BOOT_STRIKE=${BOOT_STRIKE:-ter-112n}

fail=0
for strike in $STRIKES; do
  font="/usr/lib/kbd/consolefonts/$strike.psf.gz"
  if [ ! -r "$font" ]; then
    printf '  %-10s SKIPPED -- %s is not installed\n' "$strike" "$font"; fail=1; continue
  fi
  printf '  %-10s ' "$strike"
  d="$OUT/$strike"; mkdir -p "$d"

  # The ramp for THIS strike, then the hero quantised against it. Both stages
  # write to the tree's fixed paths, so the result is moved into place after.
  if ! python3 bake/derive_ramp.py --font "$font" --out assets/ramp-bake.json >/dev/null 2>&1; then
    printf 'FAILED (ramp)\n'; fail=1; continue
  fi
  if ! python3 bake/derive_targets.py --master "$MASTER" $TONE >/dev/null 2>&1; then
    printf 'FAILED (targets)\n'; fail=1; continue
  fi
  cp assets/ramp-bake.json "$d/ramp-bake.json"
  for f in master.cells target-2.cells target-4.cells tty.cells logo.cells; do
    [ -e "assets/$f" ] && cp "assets/$f" "$d/$f"
  done
  printf 'ok  (%s)\n' "$(du -sh "$d" | cut -f1)"
done


# THE BOOT SPLASH AND THE LOGIN GREETER.
#
# These are the first two things anyone sees, and they were stock Fedora on
# every installed machine: bake/make_boot_assets.py built them into system/ on
# the BUILD HOST, system/ was not in the package, and nothing called
# bin/null-system to install them. Written, generated, shipped nowhere.
#
# One set, from one strike, rather than nine. A splash is a centred image and
# does not have to match the panel -- and a brand that looks the same on every
# machine is the better answer anyway. 1.3 MB.
#
# IT MUST FIT, WHICH IS NOT THE SAME AS FILLING. Both themes place the frames
# with fillMode Pad, because resampling a cell grid turns crisp glyphs into
# mush -- so an image LARGER than the screen is cropped, not shrunk. The first
# greeter was rendered from target-2 at 8x16, which is 2560x1440, and on a
# 1280x800 panel the login fields sat in the middle of a cropped hero.
#
# target-4 at 6x12 is 960x540: it fits inside anything from a 1024x600 netbook
# upward, and is centred with void around it on everything larger, which is
# what the surface is meant to look like anyway.
echo "the boot splash and the greeter"
if ! python3 bake/make_boot_assets.py \
     --plymouth-cells "$OUT/$BOOT_STRIKE/target-4.cells" \
     --sddm-cells "$OUT/$BOOT_STRIKE/target-4.cells" \
     --atlas "$OUT/strikes/atlas-$BOOT_STRIKE.bin" \
     --palette assets/palette.json \
     --out "$OUT/boot" 2>&1 | sed 's/^/  /'; then
  echo "null-prebake: the boot assets failed" >&2; exit 1
fi
echo

# THE ATLASES AND RAMPS FOR EVERY STRIKE, because they are tiny and because
# the alternative is a compiler on the target.
#
# Which strike a machine uses depends on its panel, which is unknown when the
# package is built -- so the choice is made at install time from a set that
# contains all of them. Nine strikes is about 400 kB; requiring python, numpy
# and a font parser on every installed machine to save that is a bad trade.
#
# The palette goes with them: it is derived from the Planckian locus and has no
# machine in it at all.
echo
echo "atlases and ramps, for every strike"
mkdir -p "$OUT/strikes"
python3 bake/derive_palette.py >/dev/null 2>&1 \
  && cp assets/palette.bin assets/palette.json "$OUT/strikes/" \
  && echo "  palette    ok"
for f in /usr/lib/kbd/consolefonts/ter-1*n.psf.gz; do
  [ -r "$f" ] || continue
  name=$(basename "$f" .psf.gz)
  printf '  %-10s ' "$name"
  if python3 bake/derive_ramp.py --font "$f" --out "$OUT/strikes/ramp-$name.json" >/dev/null 2>&1 \
     && python3 bake/bake_atlas.py --font "$f" --out "$OUT/strikes/atlas-$name.bin" >/dev/null 2>&1; then
    printf 'ok  (%s)\n' "$(du -h "$OUT/strikes/atlas-$name.bin" | cut -f1)"
  else
    printf 'FAILED\n'; fail=1
  fi
done


# THE PALETTE-DERIVED SURFACES, which are machine-independent and were the last
# reason the target needed Python.
#
# export_theme writes the compositor's colours, both GTK themes, the terminal's
# configuration and the shell's; make_icons recolours an icon theme. Every one
# of them is a function of the palette alone -- no strike, no geometry, no
# hardware -- so building them on each machine derives the same bytes from the
# same input and requires numpy, pillow and gobject to do it.
echo
echo "palette-derived surfaces"
printf '  %-10s ' theme
if python3 bake/export_theme.py >/dev/null 2>&1; then
  mkdir -p "$OUT/theme"
  for f in config/sway/colours.conf config/foot/foot.ini config/shell/colours.sh; do
    [ -e "$f" ] && install -D -m 0644 "$f" "$OUT/theme/$f"
  done
  for d in config/gtk-3.0 config/gtk-4.0; do
    [ -d "$d" ] && mkdir -p "$OUT/theme/$d" && cp -a "$d/." "$OUT/theme/$d/"
  done
  printf 'ok\n'
else printf 'FAILED\n'; fail=1; fi

printf '  %-10s ' icons
# --out is given explicitly: make_icons defaults to the running user's own
# ~/.local/share/icons, which is the last place a package should collect from.
rm -rf "$OUT/theme/icons"
if python3 bake/make_icons.py --out "$OUT/theme/icons" >/dev/null 2>&1 && [ -d "$OUT/theme/icons" ]; then
  printf 'ok  (%s)\n' "$(du -sh "$OUT/theme/icons" | cut -f1)"
else printf 'FAILED\n'; fail=1; fi

echo
echo "total: $(du -sh "$OUT" 2>/dev/null | cut -f1) in $OUT"
[ "$fail" -eq 0 ] || echo "null-prebake: some strikes did not build" >&2
exit $fail
