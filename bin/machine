#!/usr/bin/env bash
# machine -- machine identity, output geometry, and runtime hardware probes
#            (NULL.md §0.2)
#
# Selection is by hostname, with an explicit override via $NULL_MACHINE.
#
# The profile carries identity and geometry. It does NOT carry hardware
# capability: §0.2 requires components to degrade by absence of hardware,
# discovered at runtime. `machine probe <capability>` is that discovery.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)

die() { printf 'machine: %s\n' "$*" >&2; exit 1; }

# READ ONCE. `check-profile` runs on every boot, before the display manager,
# and it used to spend 670 ms of that boot doing this: three `get` calls, each
# one running `hostname`, `sed` and `awk` over the same twenty-line file. The
# file does not change between the first read and the third.
declare -A PROFILE=()
PROFILE_PATH=""
PROFILE_LOADED=0

profile_path() {
  if [ -z "$PROFILE_PATH" ]; then
    local n=${NULL_MACHINE:-$(hostname -s 2>/dev/null || hostname)}
    local p="$ROOT/machines/$n.conf"
    [ -r "$p" ] || die "no profile for '$n' (expected $p; set NULL_MACHINE to override)"
    PROFILE_PATH=$p
  fi
  printf '%s\n' "$PROFILE_PATH"
}

load_profile() {
  [ "$PROFILE_LOADED" = 1 ] && return 0
  local p; p=$(profile_path) || return 1
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    case $line in *=*) ;; *) continue ;; esac
    k=${line%%=*}; v=${line#*=}
    # Trim, without spawning anything to do it.
    k=${k#"${k%%[![:space:]]*}"}; k=${k%"${k##*[![:space:]]}"}
    v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
    [ -n "$k" ] || continue
    PROFILE["$k"]=$v
  done < "$p"
  PROFILE_LOADED=1
}

# Read one key. Strips comments and surrounding whitespace. Fails loudly on a
# key that is not there, rather than returning empty -- an empty geometry that
# silently becomes zero is worse than a stopped program.
get() {
  load_profile
  [ -n "${PROFILE[$1]+set}" ] || die "profile has no key '$1'"
  printf '%s\n' "${PROFILE[$1]}"
}

# Derived, never stored. A grid that is written down in two places is a grid
# that will eventually disagree with itself.
derive() {
  local w h cw ch
  case $1 in
    interface_cols) w=$(get width);  cw=$(get interface_cell_w); echo $(( w / cw )) ;;
    interface_rows) h=$(get height); ch=$(get interface_cell_h); echo $(( h / ch )) ;;
    bake_cols)      w=$(get width);  cw=$(get bake_cell_w);      echo $(( w / cw )) ;;
    bake_rows)      h=$(get height); ch=$(get bake_cell_h);      echo $(( h / ch )) ;;
    *) die "unknown derived value '$1'" ;;
  esac
}

# Does the geometry divide exactly? §2.1 requires it: a grid that does not
# divide leaves a partial cell, and a partial cell is either clipped or
# scaled. Both are wrong.
# The strikes this font ships, cell width x height, measured from the files
# rather than remembered: `fc-query` gives the pixel size and the advance is
# the width. Terminus is a bitmap face and comes in exactly these.
STRIKES="6x12:ter-u12n:ter-112n 8x14:ter-u14n:ter-114n 8x16:ter-u16n:ter-116n
         10x18:ter-u18n:ter-118n 10x20:ter-u20n:ter-120n 11x22:ter-u22n:ter-122n
         12x24:ter-u24n:ter-124n 14x28:ter-u28n:ter-128n 16x32:ter-u32n:ter-132n"

# Detect the output WITHOUT a compositor if need be, because this has to run on
# a machine that has not started one yet -- which is every machine, once, and
# is the whole difficulty of installing onto hardware nobody has seen.
detect_output() {
  # ASK THE COMPOSITOR, NOT sway.
  #
  # This used to shell out to `swaymsg -t get_outputs -r` and parse the JSON
  # with python3 -- two processes and a Python interpreter start, about 140ms,
  # on a path that runs before the display manager. `render outputs` is a
  # wl_output listener over the running compositor's own protocol: it costs a
  # few milliseconds, it needs no sway, and it prints name/width/height/scale
  # tab-separated, which is the shape this function returns anyway.
  local rbin="$ROOT/render/target/release/render" line
  if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -x "$rbin" ]; then
    if line=$("$rbin" outputs 2>/dev/null | head -1) && [ -n "$line" ]; then
      printf '%s\n' "$line" | tr '\t' ' '
      return 0
    fi
  fi
  # No compositor: ask DRM directly. The connector that is "connected" and has
  # a mode is the one a compositor would pick too.
  #
  # WAIT FOR IT, BRIEFLY, RATHER THAN FOR THE WHOLE DEVICE QUEUE.
  #
  # This used to be guaranteed by systemd-udev-settle, which the unit pulled in
  # and which cost 3.5 s of every boot -- the largest single item on the
  # critical path -- to wait for every device on the machine. What is actually
  # needed is one connected connector. So: look, and if the graphics driver has
  # not finished coldplugging yet, look again for up to NULL_DRM_WAIT seconds.
  #
  # A machine with a display pays one pass. A machine without one pays the wait
  # once and then reports honestly that it cannot detect an output, which the
  # unit treats as success (SuccessExitStatus=0 1).
  local waited=0 limit=${NULL_DRM_WAIT:-5}
  while [ ! -d /sys/class/drm ] || ! grep -qsx connected /sys/class/drm/card*-*/status; do
    [ "$waited" -ge "$limit" ] && break
    sleep 0.25
    waited=$(awk "BEGIN{print $waited + 0.25}")
  done

  local d
  for d in /sys/class/drm/card*-*/; do
    [ -r "$d/status" ] || continue
    [ "$(cat "$d/status" 2>/dev/null)" = connected ] || continue
    local mode; mode=$(head -1 "$d/modes" 2>/dev/null)
    [ -n "$mode" ] || continue
    local name; name=$(basename "$d"); name=${name#card*-}
    echo "$name ${mode%x*} ${mode#*x} 1.0"
    return 0
  done
  return 1
}

# Choose the strike pair for a given geometry.
#
# EXACT DIVISION IS PREFERRED AND NOT ALWAYS POSSIBLE. 1366x768 -- one of the
# commonest laptop panels ever made -- is divided exactly by none of these
# strikes, because 1366 = 2 x 683 and 683 is prime. The old rule said both
# strikes must divide the output exactly, which is true of this machine and
# cannot be true of every machine.
#
# So: prefer exact, and where nothing is exact take the smallest leftover and
# SAY how many pixels it is. The remainder is painted background; it is not a
# defect to hide, it is a strip of screen the grid does not reach.
choose_strike() {
  local w=$1 h=$2 want_cols=$3
  local best="" best_score=""
  local e cell iface console cw ch cols rem score
  for e in $STRIKES; do
    cell=${e%%:*}; iface=${e#*:}; console=${iface#*:}; iface=${iface%%:*}
    cw=${cell%x*}; ch=${cell#*x}
    cols=$(( w / cw ))
    [ "$cols" -ge 40 ] || continue
    rem=$(( (w % cw) + (h % ch) ))
    # Legibility first, exactness as a tiebreak -- both in the same unit, so
    # neither can swamp the other.
    #
    # Weighting the remainder heavily was the first attempt and it was wrong:
    # on 1366x768 it chose a 6x12 strike for 227 columns of tiny text, to save
    # four pixels at the screen edge that nobody can see. A dozen unreached
    # pixels behind the frame cost nothing; text too small to read costs the
    # whole desktop.
    score=$(( (cols > want_cols ? cols - want_cols : want_cols - cols) + rem ))
    if [ -z "$best_score" ] || [ "$score" -lt "$best_score" ]; then
      best_score=$score; best="$cell:$iface:$console:$rem:$cols"
    fi
  done
  [ -n "$best" ] || return 1
  echo "$best"
}

generate() {
  local out w h scale name
  read -r out w h scale < <(detect_output) || die "cannot detect an output (no compositor, no connected DRM connector)"
  [ "${w:-0}" -gt 0 ] && [ "${h:-0}" -gt 0 ] || die "detected output has no mode ($out ${w}x${h})"
  name=${NULL_MACHINE:-$(hostname -s 2>/dev/null || hostname)}
  local p="$ROOT/machines/$name.conf"

  local i b icell iname icon irem icols bcell bname bcon brem bcols
  i=$(choose_strike "$w" "$h" 190) || die "no strike gives a usable grid at ${w}x${h}"
  b=$(choose_strike "$w" "$h" 320) || die "no bake strike at ${w}x${h}"
  IFS=: read -r icell iname icon irem icols <<<"$i"
  IFS=: read -r bcell bname bcon brem bcols <<<"$b"

  cat > "$p" <<PROFILE
# Machine profile: $name
#
# GENERATED by \`machine generate\` from the hardware, on $(date +%Y-%m-%d).
# Identity, hero and output geometry ONLY -- hardware capability is probed at
# runtime, never declared here (NULL.md 0.2).

name    = $name
hero    = null

output  = $out
width   = $w
height  = $h
scale   = $scale

interface_strike = $iname
interface_cell_w = ${icell%x*}
interface_cell_h = ${icell#*x}

bake_strike      = $bcon
bake_cell_w      = ${bcell%x*}
bake_cell_h      = ${bcell#*x}
PROFILE
  printf 'wrote %s\n' "$p"
  printf '  output     %s  %sx%s  scale %s\n' "$out" "$w" "$h" "$scale"
  printf '  interface  %-9s %s  %s cols%s\n' "$iname" "$icell" "$icols" \
    "$([ "$irem" -eq 0 ] && echo ", exact" || echo ", ${irem}px not reached")"
  printf '  bake       %-9s %s  %s cols%s\n' "$bcon" "$bcell" "$bcols" \
    "$([ "$brem" -eq 0 ] && echo ", exact" || echo ", ${brem}px not reached")"
}

# Does the recorded profile still describe the hardware that is here?
#
# THE PROFILE IS KEYED ON HOSTNAME, AND THE HOSTNAME TRAVELS WITH THE DISK.
# Move a drive to another machine and `machines/$(hostname).conf` is still
# found, still parsed, and still describes a panel that is no longer attached
# -- silently, because a profile that exists looks like a profile that is
# right. That is the failure this answers.
#
# Compares the OUTPUT NAME and the MODE only. Scale is deliberately excluded:
# the DRM path cannot report it (it always says 1.0) while the compositor path
# can, so comparing it would declare a mismatch on every boot before a
# compositor exists and regenerate the profile for no reason.
check_profile() {
  local p; p=$(profile_path 2>/dev/null) || { echo "  no profile for $(hostname -s 2>/dev/null || hostname)"; return 1; }
  # Read the array directly rather than through three `$(get ...)`, each of
  # which is a subshell that would parse the file again and throw the result
  # away. The caching only helps if the cache survives the read.
  local rout rw rh
  load_profile
  rout=${PROFILE[output]-} ; rw=${PROFILE[width]-} ; rh=${PROFILE[height]-}
  if [ -z "$rout" ] || [ -z "$rw" ] || [ -z "$rh" ]; then
    echo "  $p is missing output/width/height"
    return 1
  fi
  local dout dw dh dscale
  if ! read -r dout dw dh dscale < <(detect_output); then
    # NOT A MISMATCH. Nothing is attached, or nothing can be read -- and
    # regenerating from a detection that failed would replace a good profile
    # with a guess. Say so and leave it alone.
    echo "  cannot detect an output; leaving $p as it is"
    return 0
  fi
  printf '  recorded  %-12s %sx%s\n' "$rout" "$rw" "$rh"
  printf '  detected  %-12s %sx%s\n' "$dout" "$dw" "$dh"
  if [ "$rout" = "$dout" ] && [ "$rw" = "$dw" ] && [ "$rh" = "$dh" ]; then
    echo "  the profile matches the hardware"
    return 0
  fi
  echo "  MISMATCH -- this profile was written for different hardware"
  return 1
}

# The best prebuilt (hero, atlas) pair for a screen of this size.
#
# WHY THIS EXISTS. The wallpaper draws a fixed cell grid, so it fills a screen
# exactly when `cols x cell_w` and `rows x cell_h` ARE the screen's dimensions.
# The old code chose a strike aiming at 320 columns because that is target-2's
# width, and then always drew target-2 -- which works on 1920x1080 and 2560x1440
# and fails everywhere else. On a 1366x768 panel it asked for a 1920x1080
# surface and the hero was drawn CROPPED, off the side of the screen.
#
# 1366 = 2 x 683 and 683 is prime, so nothing divides it. The honest answer is
# not to insist on an exact fit but to take the pair that covers the most of
# this screen without overflowing it, and to SAY how much is left over.
#
# Every rung of the ladder is prebuilt for every strike, so this is a choice
# among files that already exist -- no bake, no GPU, on any machine.
#
# Prints:  <cells-file> <atlas-file> <pixel-w> <pixel-h> <coverage-percent>
choose_assets() {  # <screen-w> <screen-h>
  local W=$1 H=$2
  local P="$ROOT/assets/prebuilt"
  [ -d "$P/strikes" ] || { echo "no prebuilt assets in $P" >&2; return 1; }

  local best_score=-1 best=""
  local e cell name con cw ch t cells cols rows pw ph area
  for e in $STRIKES; do
    cell=${e%%:*}; name=${e#*:}; con=${name#*:}; name=${name%%:*}
    cw=${cell%x*}; ch=${cell#*x}
    [ -r "$P/strikes/atlas-$con.bin" ] || continue
    # EVERY RUNG, not just the three big ones. tty (80x24) and logo (40x16)
    # are the same hero re-rendered at their own framing -- derive_targets.py
    # traces them separately precisely because 180 rows does not divide by 24 --
    # and leaving them out meant nothing at all fitted a 640x480 or 800x600
    # screen, so those got no wallpaper whatsoever.
    for t in master target-2 target-4 tty logo; do
      cells="$P/$con/$t.cells"
      [ -r "$cells" ] || continue
      # Grid read from the FILE, not from a table here: a table would drift
      # away from the assets it claims to describe.
      cols=$(od -An -tu2 -j6 -N2 "$cells" | tr -d ' ')
      rows=$(od -An -tu2 -j8 -N2 "$cells" | tr -d ' ')
      [ -n "$cols" ] && [ -n "$rows" ] || continue
      pw=$((cols * cw)); ph=$((rows * ch))
      # Must not overflow: a surface larger than the screen is drawn cropped,
      # which is worse than one that is smaller and complete.
      [ "$pw" -le "$W" ] && [ "$ph" -le "$H" ] || continue
      area=$((pw * ph))
      if [ "$area" -gt "$best_score" ]; then
        best_score=$area
        best="$cells $P/strikes/atlas-$con.bin $pw $ph"
      fi
    done
  done
  [ -n "$best" ] || { echo "no prebuilt hero fits ${W}x${H}" >&2; return 1; }
  set -- $best
  printf '%s %s %s %s %s\n' "$1" "$2" "$3" "$4" "$(( 100 * $3 * $4 / (W * H) ))"
}

# The interface strike for a screen of this size, as prebuilt file paths.
#
# The bar and the column draw TEXT, so what matters is not filling the screen
# but how many columns of readable type it holds. choose_strike already scores
# that; this turns its answer into the two files a surface needs, so one bar
# per screen can each be given the strike that suits that screen.
#
# Prints:  <atlas-file> <ramp-file> <cell-w> <cell-h> <columns>
choose_interface() {  # <screen-w> <screen-h>
  local W=$1 H=$2 P="$ROOT/assets/prebuilt"
  local i cell name con rem cols
  i=$(choose_strike "$W" "$H" 190) || { echo "no interface strike fits ${W}x${H}" >&2; return 1; }
  IFS=: read -r cell name con rem cols <<<"$i"
  local a="$P/strikes/atlas-$con.bin" r="$P/strikes/ramp-$con.json"
  # Fall back to the installed pair rather than failing: a machine that has no
  # prebuilt tree still has the one strike null-machine-sync placed.
  [ -r "$a" ] || a="$ROOT/assets/atlas-interface.bin"
  [ -r "$r" ] || r="$ROOT/assets/ramp-interface.json"
  printf '%s %s %s %s %s\n' "$a" "$r" "${cell%x*}" "${cell#*x}" "$cols"
}

# The EXACT hero grid for a screen, now that grids are derived and not chosen.
#
# choose_assets picks the best of the prebuilt rungs, and no rung fits most
# screens. With the master shipped (bake/pack_master.py) the grid is simply
# what the screen is: width divided by the cell, height divided by the cell.
# The only thing still to choose is the STRIKE, because that sets the cell size
# and so how much detail the screen gets -- scored the same way as before,
# against a ~320 column target.
#
# Prints:  <atlas> <ramp> <cell-w> <cell-h> <cols> <rows> <unreached-w> <unreached-h>
choose_bake() {  # <screen-w> <screen-h>
  local W=$1 H=$2 P="$ROOT/assets/prebuilt"
  local b cell name con rem cols cw ch rows
  b=$(choose_strike "$W" "$H" 320) || { echo "no bake strike fits ${W}x${H}" >&2; return 1; }
  IFS=: read -r cell name con rem cols <<<"$b"
  cw=${cell%x*}; ch=${cell#*x}
  cols=$(( W / cw )); rows=$(( H / ch ))
  local a="$P/strikes/atlas-$con.bin" r="$P/strikes/ramp-$con.json"
  [ -r "$a" ] || a="$ROOT/assets/atlas-bake.bin"
  [ -r "$r" ] || r="$ROOT/assets/ramp-bake.json"
  printf '%s %s %s %s %s %s %s %s\n' \
    "$a" "$r" "$cw" "$ch" "$cols" "$rows" "$(( W - cols * cw ))" "$(( H - rows * ch ))"
}

check_grid() {
  local w h ok=0
  w=$(get width); h=$(get height)
  for s in interface bake; do
    local cw ch
    cw=$(get "${s}_cell_w"); ch=$(get "${s}_cell_h")
    # A REMAINDER IS NOT A FAILURE, and used to be treated as one.
    #
    # The rule was that both strikes divide the output exactly. That is true of
    # this machine and cannot be true of every machine: 1366x768 is divided
    # exactly by none of Terminus's nine strikes, because 1366 = 2 x 683 and
    # 683 is prime. A rule no hardware can satisfy is a rule that stops the
    # desktop from installing rather than one that keeps it honest.
    #
    # So the remainder is REPORTED, in pixels, and the grid must simply fit.
    # Those pixels are painted background: a strip the grid does not reach, not
    # a defect to hide.
    if [ $(( w / cw )) -lt 40 ] || [ $(( h / ch )) -lt 20 ]; then
      printf '  %-10s %sx%s px  ->  TOO FEW CELLS (%s x %s)\n' \
        "$s" "$cw" "$ch" "$(( w / cw ))" "$(( h / ch ))"
      ok=1
    elif [ $(( w % cw )) -ne 0 ] || [ $(( h % ch )) -ne 0 ]; then
      printf '  %-10s %sx%s px  ->  %s x %s cells, %s px unreached\n' \
        "$s" "$cw" "$ch" "$(( w / cw ))" "$(( h / ch ))" \
        "$(( (w % cw) + (h % ch) ))"
    else
      printf '  %-10s %sx%s px  ->  %s x %s cells, exact\n' \
        "$s" "$cw" "$ch" "$(( w / cw ))" "$(( h / ch ))"
    fi
  done
  return $ok
}

# --- runtime hardware probes -------------------------------------------
# Each answers by looking at the machine, never at a configuration value.
# Exit 0 = present, 1 = absent. A component that draws a row for absent
# hardware is drawing a permanent complaint about a missing feature (§8.4).

probe() {
  case $1 in
    battery)      compgen -G '/sys/class/power_supply/BAT*'        >/dev/null ;;
    mains)        compgen -G '/sys/class/power_supply/A[CD]*'      >/dev/null ;;
    backlight)    compgen -G '/sys/class/backlight/*'              >/dev/null ;;
    # The keyboard's own light, which is a LED class device and not a
    # backlight -- a machine can have either, both or neither, and this one
    # has the screen's and not the keyboard's. Probed rather than assumed so
    # the settings panel does not offer a control for a light that is not
    # there (§8.4).
    kbd-backlight) compgen -G '/sys/class/leds/*kbd_backlight*'      >/dev/null ;;
    lid)          [ -e /proc/acpi/button/lid ] || compgen -G '/proc/acpi/button/lid/*' >/dev/null ;;
    wireless)     compgen -G '/sys/class/net/*/wireless'           >/dev/null ;;
    bluetooth)    compgen -G '/sys/class/bluetooth/*'              >/dev/null ;;
    discrete-gpu) [ "$(ls -d /sys/class/drm/card[0-9] 2>/dev/null | wc -l)" -gt 1 ] ;;
    *) die "unknown capability '$1' (try: machine capabilities)" ;;
  esac
}

CAPABILITIES="battery mains backlight kbd-backlight lid wireless bluetooth discrete-gpu"

usage() {
  cat <<'USAGE'
usage: machine <verb> [argument]

  get <key>            read a key from the profile
  derive <name>        interface_cols | interface_rows | bake_cols | bake_rows
  probe <capability>   exit 0 if the hardware is present, 1 if absent
  capabilities         list probeable capabilities, with their current state
  check-grid           verify the grid fits, and report any unreached pixels
  check-profile        does the recorded profile still match the hardware?
  choose-bake W H      the EXACT hero grid for that screen, and its strike
  choose-assets W H    best prebuilt hero+atlas for a screen of that size
  choose-interface W H best prebuilt interface atlas+ramp for that size
  generate             write machines/<hostname>.conf from the detected hardware
  profile              path to the profile in use
  show                 everything
USAGE
}

[ $# -ge 1 ] || { usage; exit 2; }
verb=$1; shift

case $verb in
  get)      [ $# -eq 1 ] || die "get needs a key";        get "$1" ;;
  derive)   [ $# -eq 1 ] || die "derive needs a name";    derive "$1" ;;
  probe)    [ $# -eq 1 ] || die "probe needs a capability"; probe "$1" ;;
  profile)  profile_path ;;
  check-grid) check_grid ;;
  check-profile) check_profile ;;
  choose-interface) [ $# -eq 2 ] || die "choose-interface needs <width> <height>"; choose_interface "$1" "$2" ;;
  choose-bake) [ $# -eq 2 ] || die "choose-bake needs <width> <height>"; choose_bake "$1" "$2" ;;
  choose-assets) [ $# -eq 2 ] || die "choose-assets needs <width> <height>"; choose_assets "$1" "$2" ;;
  generate)   generate ;;
  capabilities)
      for c in $CAPABILITIES; do
        if probe "$c"; then printf '  %-14s present\n' "$c"; else printf '  %-14s absent\n' "$c"; fi
      done ;;
  show)
      printf 'profile   %s\n' "$(profile_path)"
      for k in name hero output width height scale interface_strike bake_strike; do
        printf '  %-18s %s\n' "$k" "$(get "$k")"
      done
      printf '\ngrid\n'; check_grid || true
      printf '\nhardware (probed now, not declared)\n'
      for c in $CAPABILITIES; do
        if probe "$c"; then printf '  %-14s present\n' "$c"; else printf '  %-14s absent\n' "$c"; fi
      done ;;
  -h|--help|help) usage ;;
  *) die "unknown verb '$verb'" ;;
esac
