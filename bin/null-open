#!/usr/bin/env bash
# Open a role using the person's default, then an installed fallback (§8.4).
set -euo pipefail
role=${1:?usage: null-open ROLE TARGET}
target=${2:-}
SELF_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
cmd=()
launch_dir=""

first() {
  local candidate
  for candidate in "$@"; do
    # These candidates are fixed program/flag strings, never desktop Exec text.
    read -r -a cmd <<<"$candidate"
    command -v "${cmd[0]}" >/dev/null 2>&1 && return 0
  done
  cmd=(); return 1
}
prefer() {
  mapfile -d '' -t cmd < <("$SELF_DIR/null-defaults" resolve-launch "$1" "${@:2}" 2>/dev/null)
  [ ${#cmd[@]} -gt 1 ] || { cmd=(); return 1; }
  launch_dir=${cmd[0]}; cmd=("${cmd[@]:1}")
  command -v "${cmd[0]}" >/dev/null 2>&1
}

if [ "$role" = file ]; then
  [ -n "$target" ] || { echo "null-open: file needs a path" >&2; exit 2; }
  [ -e "$target" ] || { echo "null-open: no such file: $target" >&2; exit 1; }
  if [ -d "$target" ]; then role=dir
  else
    mime=$(file -b --mime-type -- "$target" 2>/dev/null || echo '')
    case $mime in
      image/*) role=image ;; video/*) role=video ;; audio/*) role=audio ;;
      application/pdf|application/x-pdf) role=pdf ;;
      application/zip|application/x-tar|application/gzip|application/x-bzip*|\
      application/x-xz|application/zstd|application/x-7z-compressed|\
      application/vnd.rar|application/x-rar*) role=archive ;;
      text/*|application/json|application/xml|inode/x-empty) role=editor ;;
      *) echo "null-open: no role for '${mime:-unknown}' -- opening the folder instead" >&2
         role=dir; target=$(dirname -- "$target") ;;
    esac
  fi
fi

if [ "$role" = reveal ]; then
  if command -v thunar >/dev/null; then exec thunar "$(dirname -- "$target")"; fi
  if command -v nemo >/dev/null; then exec nemo --no-desktop "$target"; fi
  if command -v nautilus >/dev/null; then exec nautilus --select "$target"; fi
  if command -v dolphin >/dev/null; then exec dolphin --select "$target"; fi
  role=dir; target=$(dirname -- "$target")
fi

args=()
if [ -n "$target" ] && [ "$role" != browser ] && [[ $target != *://* ]]; then
  target=$(realpath -m -- "$target")
fi
[ -z "$target" ] || args=("$target")
if ! prefer "$role" "${args[@]}"; then
  launch_dir=""
  case $role in
    browser) first firefox chromium chromium-browser epiphany brave-browser org.mozilla.firefox || : ;;
    dir) first thunar nemo dolphin nautilus yazi "foot -e ls -la" || : ;;
    editor) first nano nvim vim vi || : ;;
    image) first imv imv-wayland swayimg nsxiv feh || : ;;
    pdf) first zathura mupdf evince okular || : ;;
    video|audio) first mpv vlc ffplay || : ;;
    archive) first xarchiver file-roller ark || : ;;
    terminal) first foot alacritty kitty wezterm gnome-terminal xterm || : ;;
    *) echo "null-open: unknown role $role" >&2; exit 2 ;;
  esac
  [ ${#cmd[@]} -gt 0 ] || { echo "null-open: nothing installed for role $role" >&2; exit 1; }
  cmd+=("${args[@]}")
fi

[ -z "$launch_dir" ] || cd -- "$launch_dir"
case "${cmd[0]##*/}" in
  nvim|vim|vi|nano|micro|hx|yazi)
    [ -t 1 ] || exec foot -e "${cmd[@]}" ;;
esac
exec "${cmd[@]}"
