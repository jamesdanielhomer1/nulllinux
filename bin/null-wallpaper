#!/usr/bin/env bash
# Start the wallpaper surface -- ONE PER SCREEN (NULL.md §6.3, §6.4).
#
# This used to exec a single `render` naming no output. A layer surface with no
# output is placed by the compositor on whichever screen it likes, so with two
# monitors the desktop appeared on one and the other showed bare background for
# ever -- and nothing reported it, because the process was running, drawing and
# costing CPU exactly as it does on a one-monitor machine.
#
# Each screen also gets the hero grid that fits IT, so the monitors need not
# match: a 4K panel beside a 1366x768 laptop is two different rungs of the same
# prebuilt ladder, chosen per screen by `machine choose-assets`.
#
# Stops any instance of ITSELF first, matched on the EXECUTABLE rather than the
# command line: a command-line match catches any shell that merely mentions the
# name, including the one doing the matching (§8.6).
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
RENDER="$ROOT/render/target/release/render"
TAG=null-wallpaper
[ -x "$RENDER" ] || { echo "$TAG: $RENDER not built" >&2; exit 1; }

SELF=$(readlink -f "$RENDER")
for pid in $(pgrep -x render 2>/dev/null || true); do
  # A rebuild replaces the inode, so the instance that most needs stopping is
  # exactly the one whose /proc/pid/exe no longer resolves -- strip the marker.
  exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null | sed 's/ (deleted)$//') || continue
  [ "$exe" = "$SELF" ] && kill "$pid" 2>/dev/null || true
done

. "$ROOT/lib/supervise.sh"

start_one() {  # <output-name> <w> <h>
  local name=$1 w=$2 h=$3
  local batlas bramp cw ch cols rows shortw shorth exact

  # THE EXACT GRID FOR THIS SCREEN, derived from the master rather than picked
  # from a ladder. Cached, because deriving 240 frames costs about two minutes.
  if bake=$("$ROOT/bin/machine" choose-bake "$w" "$h" 2>/dev/null); then
    read -r batlas bramp cw ch cols rows shortw shorth <<<"$bake"
    exact=$("$ROOT/bin/null-hero" path "$cols" "$rows" "$bramp" 2>/dev/null)
  fi

  if [ -n "${exact:-}" ] && [ -s "$exact" ]; then
    "$RENDER" --file "$exact" --atlas "$batlas" layershell --output "$name" &
    CHILD["$name"]=$!
    printf '%s: %-12s %sx%s  hero %sx%s cells at %sx%s, exact%s\n' \
      "$TAG" "$name" "$w" "$h" "$cols" "$rows" "$cw" "$ch" \
      "$([ "$shortw" = 0 ] && [ "$shorth" = 0 ] && echo "" || echo " (${shortw}x${shorth}px unreached)")"
    return 0
  fi

  # NOT DERIVED YET, so start on the nearest prebuilt rung NOW and derive in the
  # background. A login that blocked two minutes on a wallpaper would be a worse
  # defect than the one this fixes. When the derivation lands it kills this
  # renderer, and the supervisor -- which already restarts a child that died --
  # brings it back on the exact grid.
  local pick cells atlas pw ph cov
  pick=$("$ROOT/bin/machine" choose-assets "$w" "$h" 2>/dev/null) || {
    echo "$TAG: no prebuilt hero fits ${w}x${h} on $name" >&2; return 1; }
  read -r cells atlas pw ph cov <<<"$pick"
  "$RENDER" --file "$cells" --atlas "$atlas" layershell --output "$name" &
  CHILD["$name"]=$!
  printf '%s: %-12s %sx%s  hero %sx%s (%s%%) from a prebuilt rung\n' \
    "$TAG" "$name" "$w" "$h" "$pw" "$ph" "$cov"

  if [ -n "${exact:-}" ]; then
    local pid=${CHILD[$name]}
    printf '%s: %-12s deriving %sx%s in the background\n' "$TAG" "$name" "$cols" "$rows"
    # THE REASON GOES SOMEWHERE. Sending stderr to /dev/null here meant a
    # derivation that failed left no trace at all -- the wallpaper simply stayed
    # on the rung for ever, looking like a working desktop. It is a background
    # job, so it cannot report to a terminal; it reports to a file.
    local derr="${XDG_RUNTIME_DIR:-/tmp}/null-hero-$name.log"
    (
      if "$ROOT/bin/null-hero" ensure "$cols" "$rows" "$bramp" >/dev/null 2>"$derr"; then
        echo "$TAG: $name derived ${cols}x${rows}, restarting on it"
        rm -f "$derr"
        kill "$pid" 2>/dev/null
      else
        echo "$TAG: $name could NOT derive ${cols}x${rows} -- staying on the rung."
        echo "$TAG: $name why: $(tail -1 "$derr" 2>/dev/null)"
        echo "$TAG: $name full output in $derr"
      fi
    ) &
  fi
}

supervise
