#!/usr/bin/env bash
# The installer this system shows a person (NULL.md §0.5, §7.4).
#
# WHAT THIS IS, SAID PLAINLY, BECAUSE THE ALTERNATIVE WOULD BE A LIE.
#
# This is the FACE. Anaconda is the machinery. Everything a person sees during
# an install is drawn here, in Terminus, on the palette, beside the same hero
# every other surface is a projection of -- and then the answers are written as
# a kickstart and handed to anaconda, which partitions the disk, runs the
# package transaction and installs the bootloader.
#
# That split is deliberate and is not laziness. Partitioning is where an
# installer destroys somebody's data, and bootloader installation is where it
# leaves a machine that will not start. Those are solved problems with one
# careful implementation per distribution, and writing a second one to own the
# whole stack would trade a real risk for an aesthetic.
#
# HOW IT IS REACHED. anaconda's own kickstart %pre runs on a console before
# anything is written to disk, and can produce a file the kickstart then
# %includes. So the boot entry hands anaconda a kickstart whose %pre is this
# program: the person answers here, and anaconda never shows a screen.
#
# NOTHING IS DESTROYED BEFORE THE CONFIRMATION. This program writes exactly one
# file, to a path it is given. Every question can be gone back on until the
# last one, which names the disk and what is on it.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
# TWO LAYOUTS, BECAUSE THIS RUNS IN TWO PLACES.
#
# In the checkout it is bin/null-installer beside lib/menu.sh. On the ISO it is
# three files in one directory -- there is no tree to have a lib/ in -- so the
# shared menu chrome sits next to it. Looking only in lib/ meant the installer
# on the medium silently lost the picker styling and fell back to a numbered
# list even where fzf existed.
# shellcheck source=/dev/null
for _m in "$ROOT/lib/menu.sh" "$(dirname -- "$(readlink -f -- "$0")")/menu.sh"; do
  [ -r "$_m" ] && { . "$_m"; break; }
done

OUT=""
DRY=0
CONSOLE=""
while [ $# -gt 0 ]; do
  case $1 in
    --generate) OUT=${2:?--generate needs a path}; shift ;;
    --console)  CONSOLE=${2:?--console needs a device}; shift ;;
    --dry-run)  DRY=1 ;;
    -h|--help)
      cat <<'U'
usage: null-installer --generate <path> [--dry-run]

  Asks what an install needs and writes those answers as a kickstart
  fragment, for anaconda to %include. Writes nothing else, anywhere.

  --dry-run   do not require a real disk; useful for looking at it
U
      exit 0 ;;
    *) echo "null-installer: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$OUT" ] || { echo "null-installer: --generate <path> is required" >&2; exit 2; }
# An earlier attempt is not confirmation for this attempt. Only the output
# fragment is invalidated here; no disk operation happens in this program.
rm -f -- "$OUT" || { echo "null-installer: cannot clear $OUT" >&2; exit 1; }

# OPEN THE CONSOLE OURSELVES WHEN TOLD WHICH ONE.
#
# Relying on the caller to redirect worked on a development machine and not in
# anaconda's installer environment: %pre bound stdin and stdout to /dev/tty6,
# chvt reported success, and this program still decided neither was a terminal
# and exited 3. Rather than keep guessing at why the handover differs, it is
# removed: --console names the device and the program opens it, so what it has
# is what it opened.
if [ -n "$CONSOLE" ]; then
  if ! exec <"$CONSOLE" >"$CONSOLE" 2>&1; then
    echo "null-installer: cannot open $CONSOLE" >&2
    exit 3
  fi
fi

# A HANG IS THE WORST OUTCOME, SO IT IS REFUSED INSTEAD.
#
# This program asks questions. Started somewhere with no terminal -- which is
# exactly what anaconda's %pre gives it, because %pre's stdout goes to a log
# and its stdin is not a console -- every read either returns EOF at once or
# blocks for ever. Observed on a real boot: the install sat at "Running
# pre-installation scripts" with nothing on screen and no way to tell why.
#
# An install that stops with a reason can be fixed. An install that hangs
# cannot even be diagnosed without a second machine.
#
# --dry-run is exempt, because that is how the checks drive it from a pipe.
if [ "$DRY" != 1 ] && [ -z "$CONSOLE" ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  echo "null-installer: no terminal on stdin/stdout -- refusing to hang." >&2
  echo "  This program asks questions and must be given a console." >&2
  echo "  From anaconda's %pre, bind it to one first:" >&2
  echo "    exec </dev/tty6 >/dev/tty6 2>&1; chvt 6" >&2
  exit 3
fi

# The boot runtime has its own console defaults. Apply the ISO's staged font
# and palette to this installer's VT before drawing; never reconfigure a PTY.
installer_console() {
  [ "${DRY:-0}" != 1 ] || return 0
  [ -e "$ROOT/console-palette.ansi" ] || return 0
  local console
  console=$(tty 2>/dev/null) || return 0
  case $console in /dev/tty[0-9]*) ;; *) return 0 ;; esac
  if [ ! -r "$ROOT/console.psf" ] || ! command -v setfont >/dev/null 2>&1; then
    echo "null-installer: the console font or setfont is missing" >&2
    return 1
  fi
  setfont -C "$console" "$ROOT/console.psf" || {
    echo "null-installer: could not apply the installer console font" >&2
    return 1
  }
  cat "$ROOT/console-palette.ansi" || return 1
  # Palette changes affect newly drawn cells; repaint the blank screen too.
  printf '\033[0m\033[2J\033[H'
}
installer_console || exit 1

# --- the surface -----------------------------------------------------------
#
# Colours by NAME, from config/sway/colours.conf, resolved once. Writing an
# escape with a hex value in it would be the one thing this project does not
# do -- and on a virtual console the sixteen slots ARE the palette, because
# the installed system's boot arguments or the ISO's console setup put them there.
C_RESET=$'\033[0m'; C_DIM=$'\033[33m'; C_TEXT=$'\033[37m'
C_ACCENT=$'\033[34m'; C_ERROR=$'\033[31m'; C_LINE=$'\033[90m'

rule()  { printf '%s%s%s\n' "$C_LINE" "$(printf '%.0s-' $(seq "${1:-64}"))" "$C_RESET"; }
title() { printf '\n%s%s%s\n' "$C_ACCENT" "$1" "$C_RESET"; rule 64; }
say()   { printf '  %s%s%s\n' "$C_TEXT" "$1" "$C_RESET"; }
hint()  { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_RESET"; }
oops()  { printf '  %s%s%s\n' "$C_ERROR" "$1" "$C_RESET"; }

# THE HERO, if it can be drawn. An installer that refuses to run because it
# could not find a picture is an installer that does not run.
banner() {
  # A SHIPPED STILL FIRST. The installer environment is anaconda's runtime: it
  # has no render binary, no atlas, and no cells file, because none of those
  # are part of an install image. So the hero travels as what it will be shown
  # as -- one frame, already ANSI, 1.6 KB -- rendered at ISO build time by the
  # same renderer every other surface uses.
  # BESIDE THE SCRIPT AS WELL AS UNDER $ROOT, for the same reason menu.sh is
  # looked for twice: on the medium there is no tree, just three files in a
  # directory, and NULL_ROOT is not always set by whoever runs it. Found only
  # under $ROOT, the installer fell back to printing its own name.
  local here still
  here=$(dirname -- "$(readlink -f -- "$0")")
  for still in "$ROOT/hero.ansi" "$here/hero.ansi" "${NULL_INSTALLER_HERO:-}"; do
    [ -n "$still" ] && [ -r "$still" ] && break
    still=""
  done
  if [ -n "$still" ]; then cat "$still"; return 0; fi

  # On a development checkout the renderer IS here, so draw it live rather than
  # showing a worse thing than the machine can manage.
  local cells atlas
  cells=$(ls "$ROOT"/assets/prebuilt/ter-118n/logo.cells 2>/dev/null | head -1)
  atlas="$ROOT/assets/prebuilt/strikes/atlas-ter-118n.bin"
  if [ -n "$cells" ] && [ -r "$atlas" ] && [ -x "$ROOT/render/target/release/render" ]; then
    local t; t=$(mktemp)
    if "$ROOT/render/target/release/render" --file "$cells" --atlas "$atlas" \
         still --frame 0 --out "$t" >/dev/null 2>&1; then
      cat "$t"; rm -f "$t"; return 0
    fi
    rm -f "$t"
  fi
  printf '\n%s      nullLinux%s\n' "$C_ACCENT" "$C_RESET"
}

# --- asking ----------------------------------------------------------------
#
# One picker for choices, one prompt for text. Both are the ones every other
# surface in this system uses, so the installer does not introduce a second
# idiom for the same job.
#
# THE PICKER ITSELF NOW LIVES IN lib/menu.sh as null_pick, because a second
# caller appeared: bin/null-drive, which chooses a drive to erase. Two copies
# of a picker means two places to learn that fzf needs a tty, and only one of
# them ever does.
ask() {  # <prompt> <default> -> stdout
  local p=$1 d=${2:-} a
  if [ -n "$d" ]; then printf '  %s%s%s [%s]: ' "$C_TEXT" "$p" "$C_RESET" "$d" >&2
  else printf '  %s%s%s: ' "$C_TEXT" "$p" "$C_RESET" >&2; fi
  IFS= read -r a || return 1
  printf '%s\n' "${a:-$d}"
}

ask_secret() {  # <prompt> -> stdout, twice, matching
  local p=$1 a b
  while :; do
    printf '  %s%s%s: ' "$C_TEXT" "$p" "$C_RESET" >&2; IFS= read -rs a || return 1; echo >&2
    [ -n "$a" ] || { oops "empty" >&2; continue; }
    printf '  %sand again%s: ' "$C_TEXT" "$C_RESET" >&2; IFS= read -rs b || return 1; echo >&2
    [ "$a" = "$b" ] && { printf '%s\n' "$a"; return 0; }
    oops "they do not match" >&2
  done
}

# --- what is here ----------------------------------------------------------
#
# DERIVED FROM THE MACHINE, never declared. The same rule as the rest of this
# project: ask the hardware, print what it said, refuse on anything unexpected.
# WHAT COUNTS AS A DISK SOMEBODY MIGHT INSTALL ON.
#
# `lsblk TYPE==disk` alone listed sixteen /dev/nbd* at 0B, a zram swap device
# and a loop device before the one real drive -- a list to scroll past to reach
# the answer, at the one question where scrolling past things is dangerous.
#
# So: zero-size devices are gone (an nbd with nothing attached), and the
# virtual classes are named and excluded rather than guessed at. A real disk
# that this filter hides would be worse than the noise, so the exclusions are
# specific: zram is compressed RAM, nbd is a network block device, loop is a
# file, ram is a ramdisk, sr is optical, fd is a floppy.
# THE MEDIUM THIS IS RUNNING FROM IS NOT SOMEWHERE TO INSTALL.
#
# In a VM the installer arrives on a virtual CD and `sr0` is filtered out. On
# real hardware it arrives on a USB STICK, which is a disk like any other -- so
# the list offered both the stick and the machine's own drive, told apart only
# by size and model. Choosing the stick means erasing the installer while it
# runs.
#
# Found by writing down what the list was supposed to do (docs/installing-on-nox.md)
# and then reading the code that does it.
#
# DERIVED, not guessed: anaconda mounts the medium at /run/install/repo, and the
# whole disk behind that mount is the one to leave alone. If that mount is not
# there -- a network install, a test -- nothing is excluded and nothing is
# claimed.
booted_from() {
  local src disk
  # THE INSTALLER'S OWN MOUNTS, AND NOT `/`.
  #
  # The first version fell through to `/` when neither was present -- and on any
  # ordinary machine `/` is the system disk, so `disks()` excluded the only disk
  # there was and the installer said "no disks found -- there is nothing here to
  # install onto". The comment already said nothing would be claimed without
  # those mounts; the code disagreed with it.
  for m in /run/install/repo /run/install/sources/mount-0000-cdrom; do
    src=$(findmnt -no SOURCE --mountpoint "$m" 2>/dev/null | head -1) || continue
    [ -b "$src" ] || continue
    if [ "$(lsblk -ndo TYPE "$src" 2>/dev/null)" = disk ]; then
      printf '%s\n' "$src"; return 0
    fi
    disk=$(lsblk -ndo PKNAME "$src" 2>/dev/null)
    [ -n "$disk" ] && { echo "/dev/$disk"; return 0; }
  done
  return 1
}

disks() {
  local self; self=$(booted_from || true)
  lsblk -dnpo NAME,SIZE,MODEL,TYPE 2>/dev/null \
    | awk '$NF=="disk" { $NF=""; sub(/[ \t]+$/,""); print }' \
    | grep -vE '^/dev/(zram|nbd|loop|ram|sr|fd)[0-9]' \
    | grep -vE ' 0B( |$)' \
    | { if [ -n "$self" ]; then grep -vE "^$self( |$)"; else cat; fi; }
}

# ===========================================================================
banner
title "nullLinux"
say "This installs nullLinux onto a disk in this machine."
hint "Nothing is written until the last question, which names the disk."

# --- 1. the disk -----------------------------------------------------------
title "Which disk"
mapfile -t DISKS < <(disks)
if [ "${#DISKS[@]}" -eq 0 ]; then
  if [ "$DRY" = 1 ]; then DISKS=("/dev/sda 20G (dry run)")
  else oops "no disks found -- there is nothing here to install onto"; exit 1; fi
fi
# SAID OUT LOUD, because a disk that is missing from a list is otherwise
# indistinguishable from a disk the machine cannot see.
_self=$(booted_from || true)
[ -n "$_self" ] && hint "$_self is the medium this installer is running from, and is not listed"
DISK=$(null_pick "disk" "everything on the disk you choose will be erased" "" "${DISKS[@]}" | awk '{print $1}')
[ -n "$DISK" ] || { oops "no disk chosen"; exit 1; }
DISK_DESC=$(printf '%s\n' "${DISKS[@]}" | grep -F "$DISK" | head -1)

# --- 2. who this machine is ------------------------------------------------
title "This machine"
HOSTNAME=$(ask "hostname" "nulllinux") || exit 1
case $HOSTNAME in ''|*[!a-zA-Z0-9.-]*) oops "a hostname is letters, digits, dots and dashes"; exit 1 ;; esac

title "You"
USERNAME=$(ask "username" "${SUDO_USER:-null}") || exit 1
case $USERNAME in ''|*[!a-z0-9_-]*) oops "a username is lowercase letters, digits, _ and -"; exit 1 ;; esac
FULLNAME=$(ask "full name" "$USERNAME") || exit 1
PASSWORD=$(ask_secret "password") || exit 1

# --- 3. where it is --------------------------------------------------------
title "Where you are"
TZ_DEFAULT=$(cat /etc/timezone 2>/dev/null || timedatectl show -p Timezone --value 2>/dev/null || echo Europe/London)
if command -v timedatectl >/dev/null 2>&1; then
  mapfile -t ZONES < <(timedatectl list-timezones 2>/dev/null)
  TIMEZONE=$(null_pick "timezone" "enter alone keeps $TZ_DEFAULT" "$TZ_DEFAULT" "${ZONES[@]}")
else
  TIMEZONE=$(ask "timezone" "$TZ_DEFAULT")
fi
TIMEZONE=${TIMEZONE:-$TZ_DEFAULT}
KEYMAP=$(ask "keyboard layout" "gb") || exit 1
case $KEYMAP in ''|*[!A-Za-z0-9_-]*) oops "invalid keyboard layout"; exit 1 ;; esac

# THE LOCALE, WHICH WAS NOT ASKED AND WAS NOT NEUTRAL EITHER.
#
# packaging/nulllinux-install.ks says `lang en_GB.UTF-8`, and the interactive
# kickstart kept that line -- so this installer asked a person for their
# timezone and their keyboard and then gave them a British locale whatever they
# answered. Dates, numbers, the first day of the week and the default paper
# size all come from it.
#
# A TEXT QUESTION WITH A DERIVED DEFAULT, not a list. In anaconda's runtime
# `locale -a` reports what the INSTALLER image carries, which is not what the
# installed system will have, so a picker built from it would offer a list
# wrong in both directions. The keyboard answer is the best evidence available
# of where somebody is, and they can type anything else.
case $KEYMAP in
  gb)        LOCALE_DEFAULT=en_GB.UTF-8 ;;
  us)        LOCALE_DEFAULT=en_US.UTF-8 ;;
  de|de-*)   LOCALE_DEFAULT=de_DE.UTF-8 ;;
  fr|fr-*)   LOCALE_DEFAULT=fr_FR.UTF-8 ;;
  es|es-*)   LOCALE_DEFAULT=es_ES.UTF-8 ;;
  it|it-*)   LOCALE_DEFAULT=it_IT.UTF-8 ;;
  pt)        LOCALE_DEFAULT=pt_PT.UTF-8 ;;
  br)        LOCALE_DEFAULT=pt_BR.UTF-8 ;;
  se)        LOCALE_DEFAULT=sv_SE.UTF-8 ;;
  no)        LOCALE_DEFAULT=nb_NO.UTF-8 ;;
  dk)        LOCALE_DEFAULT=da_DK.UTF-8 ;;
  fi)        LOCALE_DEFAULT=fi_FI.UTF-8 ;;
  nl)        LOCALE_DEFAULT=nl_NL.UTF-8 ;;
  pl)        LOCALE_DEFAULT=pl_PL.UTF-8 ;;
  ca)        LOCALE_DEFAULT=en_CA.UTF-8 ;;
  *)         LOCALE_DEFAULT=en_US.UTF-8 ;;
esac
hint "nullLinux's own text is English; a locale sets dates, numbers and paper size"
LOCALE=$(ask "locale" "$LOCALE_DEFAULT") || exit 1
case $LOCALE in *[!A-Za-z0-9_.@-]*) oops "invalid locale"; exit 1 ;; esac
case $LOCALE in
  *_*.*) ;;
  *) oops "a locale looks like en_GB.UTF-8"; exit 1 ;;
esac

# --- 4. the one that cannot be undone --------------------------------------
title "This erases the disk"
say "disk      $DISK_DESC"
say "hostname  $HOSTNAME"
say "user      $USERNAME ($FULLNAME)"
say "timezone  $TIMEZONE"
say "keyboard  $KEYMAP"
say "locale    $LOCALE"
echo
oops "Everything currently on $DISK will be destroyed."
hint "Type the disk's name to confirm, or anything else to stop."
CONFIRM=$(ask "confirm by typing $DISK" "") || exit 1
if [ "$CONFIRM" != "$DISK" ]; then
  echo; say "Nothing has been changed."
  exit 1
fi

# --- 5. write the answers --------------------------------------------------
#
# A FRAGMENT, not a whole kickstart. It carries only what a person answered;
# everything else -- the package set, the firewall, the initramfs, the boot
# menu -- lives in packaging/nulllinux-install.ks, which is the same file the
# unattended install uses. One description of what nullLinux is, answered two
# ways.
umask 077
TMP_OUT=$(mktemp "${OUT}.XXXXXX") || { oops "cannot create the answers file"; exit 1; }
trap 'rm -f -- "$TMP_OUT"' EXIT
# Kickstart uses shell-style quoting. Preserve the exact password and name,
# including quotes and backslashes, without evaluating either as shell code.
ks_quote() {
  local value=$1
  value=${value//\\/\\\\}; value=${value//\"/\\\"}
  printf '"%s"' "$value"
}
if ! ( set -e
  echo "# GENERATED by bin/null-installer. Do not edit."
  echo "# The answers a person gave; everything else is in the kickstart that"
  echo "# %includes this."
  echo
  echo "ignoredisk --only-use=${DISK#/dev/}"
  echo "zerombr"
  echo "clearpart --all --initlabel --drives=${DISK#/dev/}"
  echo "autopart --type=plain --noswap"
  # NO --location. IT IS BIOS-ONLY, AND ON AN EFI MACHINE IT TAKES THE REST
  # OF THIS FILE WITH IT.
  #
  # A UEFI install with `--location=mbr` applied everything BEFORE this line
  # and nothing after it. Measured on the resulting disk:
  #
  #   before   ignoredisk, zerombr, clearpart, autopart -- applied. A 600M ESP,
  #            a 2G /boot and a 17.4G /, ext4, no swap: exactly what
  #            `autopart --type=plain --noswap` asks for.
  #   after    network --hostname, timezone, keyboard, user -- none applied. No
  #            /etc/hostname, no /etc/localtime, vconsole.conf still systemd's
  #            fallback, and not one account with a shell but root.
  #
  # The greeter came up saying `localhost` and refused the password, because
  # the person it was asked to create was never created.
  #
  # anaconda picks the right place for the firmware it is on: the MBR on a BIOS
  # machine, the ESP on an EFI one. Naming it here can only be wrong on one of
  # them, and nox boots EFI.
  echo "bootloader --boot-drive=${DISK#/dev/} --timeout=1"
  echo
  echo "network --bootproto=dhcp --device=link --activate --hostname=$HOSTNAME"
  echo "timezone $(ks_quote "$TIMEZONE") --utc"
  echo "keyboard --vckeymap=$KEYMAP --xlayouts='$KEYMAP'"
  echo "lang $LOCALE"
  echo
  # ROOT IS LOCKED, not given a password nobody will remember. The user is in
  # wheel, so `sudo` is the way in, and there is one fewer credential on the
  # machine that exists only because installers have always asked for it.
  echo "rootpw --lock"
  echo "user --name=$USERNAME --gecos=$(ks_quote "$FULLNAME") --groups=wheel --password=$(ks_quote "$PASSWORD") --plaintext"
) > "$TMP_OUT"; then
  oops "could not write the answers"; exit 1
fi
mv -fT -- "$TMP_OUT" "$OUT" || { oops "could not publish the answers"; exit 1; }
unset PASSWORD

echo
say "Written to $OUT"
hint "anaconda takes it from here: partitioning, packages, bootloader."

# SUCCESS SAID OUT LOUD. Without this the script's status is whatever the last
# printf returned, which is a decorative statement standing in for a verdict.
exit 0
