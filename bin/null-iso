#!/usr/bin/env bash
# Build the nullLinux live ISO (NULL.md §0.5).
#
# THE ISO IS THE LAST STEP, NOT THE FIRST. It is a way of shipping an
# installation that already works: null-bootstrap and the package come first,
# and this puts them on a disc. Building an ISO around an installer that has
# never installed anything is how you get an ISO that boots to a broken
# desktop and cannot tell you why.
#
# It needs the package to exist, and the package needs the prebuilt assets, so
# the order is null-prebake -> null-package -> null-iso and each refuses
# rather than guessing when the one before it has not run.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
cd "$ROOT"
NAME=nulllinux
VERSION=$(rpmspec -q --qf '%{version}\n' packaging/$NAME.spec 2>/dev/null | head -1)
WORK=${NULL_ISO_WORK:-/var/lib/nulllinux-iso}

# Parse arguments before creating build state. Each compose keeps its own
# intermediate images and logs; the last published ISO survives a failed run.
usage() {
  echo "usage: null-iso [--yes]"
  echo
  echo "  --yes, -y   accepted for compatibility; earlier builds are retained"
  echo
  echo "  Builds a Try / Install live ISO in a fresh compose directory."
  echo "  Publishes the final image only after success. Run bin/null-package first."
}
while [ $# -gt 0 ]; do
  case $1 in
    --yes|-y)  : ;;
    -h|--help) usage; exit 0 ;;
    *) echo "null-iso: unknown argument '$1'" >&2; echo >&2; usage >&2; exit 2 ;;
  esac
  shift
done

need() { command -v "$1" >/dev/null 2>&1 || { echo "null-iso: $1 is not installed" >&2; return 1; }; }
fail=0
need livemedia-creator || fail=1
need createrepo_c || fail=1
need mkksiso || fail=1
need ksvalidator || fail=1
need git || fail=1
need python3 || fail=1
[ -d packaging/repo/repodata ] || { echo "null-iso: no local repository at packaging/repo" >&2
  echo "  Build the package first:  bin/null-package" >&2; fail=1; }
[ "$(id -u)" -eq 0 ] || { echo "null-iso: must be root -- anaconda needs mounts and loop devices" >&2; fail=1; }
[ "$fail" -eq 0 ] || exit 1

# The image's scripts and its RPM must describe the same source revision.
revision=$(git rev-parse --verify HEAD) || exit 1
[ -z "$(git status --porcelain --untracked-files=normal)" ] || {
  echo "null-iso: commit working changes and rebuild the package first" >&2; exit 1;
}
# Space. An ISO build writes the whole installed tree, then an image of it,
# then squashfs -- several times the size of the result.
mkdir -p "$WORK" || exit 1
WORK=$(cd "$WORK" && pwd -P) || exit 1
avail=$(df --output=avail -BG "$WORK" 2>/dev/null | tail -1 | tr -dc '0-9')
[ "${avail:-0}" -ge 20 ] || { echo "null-iso: ${avail}G free; an ISO build wants 20G or more" >&2; exit 1; }

compose=$(mktemp -d "$WORK/compose.XXXXXX") || exit 1
KS="$compose/$NAME-live.ks"
repository="$compose/repo"
# Package publication can replace the shared repository while this image is
# building. Copy its contents once; Anaconda and the final sidecar use only
# this compose's copy. Staying in the source directory avoids following a
# replacement of the repository path halfway through the copy.
( cd "$ROOT/packaging/repo" && cp -aL --reflink=auto . "$repository" ) || {
  echo "null-iso: could not snapshot the package repository" >&2; exit 1;
}
python3 - "$repository/BUILD-INFO.json" "$revision" <<'PROVENANCE' || exit 1
import json, sys
from pathlib import Path
info = json.loads(Path(sys.argv[1]).read_text())
if info['source_commit'] != sys.argv[2]:
    raise SystemExit('null-iso: the package is stale; run bin/null-package for this revision')
PROVENANCE

# The kickstart names the repository by absolute path, which is only known
# here. Substituted rather than hard-coded so the tree can live anywhere.
REL=$("$ROOT/bin/pkg" distro-version 2>/dev/null || echo 44)
python3 - "$ROOT" "$KS" "$REL" "$repository" <<'KICKSTART' || exit 1
import os, sys
from pathlib import Path
root, output = map(Path, sys.argv[1:3])
release = sys.argv[3]
if not release.isdecimal():
    raise SystemExit('null-iso: invalid Fedora release')
source = (root/'packaging/nulllinux-live.ks').read_text()
source = source.replace('file://NULLLINUX_REPO', Path(sys.argv[4]).as_uri())
source = source.replace('$releasever', release).replace('$basearch', 'x86_64')
source = source.replace('https://download.fedoraproject.org/pub/fedora/linux',
                        os.environ.get('NULL_MIRROR', 'https://dl.fedoraproject.org/pub/fedora/linux').rstrip('/'))
output.write_text(source)
KICKSTART
ksvalidator "$KS" >/dev/null 2>&1 || { echo "null-iso: the kickstart does not validate" >&2
  ksvalidator "$KS" >&2; exit 1; }

echo "building $NAME-$VERSION.iso"
echo "  work:  $WORK"
echo "  repo:  $repository ($(ls "$repository"/*.rpm 2>/dev/null | wc -l) package(s))"
echo

# --no-virt: build in a chroot on this machine rather than by booting a virtual
# machine. It is the faster path and the one that works on a host that is
# already inside a hypervisor, which a build machine often is.
# Fedora's release, for the package repos -- and, because livemedia-creator has
# no separate product version, the number lorax puts in the boot-menu titles.
# The post-build step below puts the product's own version there instead.
( cd "$compose" && livemedia-creator \
  --ks "$KS" \
  --no-virt \
  --resultdir "$compose/results" \
  --project "nullLinux" \
  --releasever "$REL" \
  --volid "nullLinux-$VERSION" \
  --iso-name "$NAME-$VERSION.iso" \
  --make-iso \
  --compression zstd \
  --lorax-templates /usr/share/lorax/templates.d/99-generic \
  --logfile "$compose/livemedia.log" )
st=$?

echo
if [ $st -eq 0 ] && built=$(find "${compose:-$WORK}/results" -name '*.iso' | head -1) && [ -n "$built" ]; then
  # A SHIPPABLE NAME. In --no-virt mode livemedia-creator writes the live image
  # as results/images/boot.iso and does NOT honour --iso-name, so left alone the
  # artefact ships as "boot.iso". It is moved to the product's own name, beside
  # the installer ISO which is named the same way. The filename does not affect
  # booting: root=live:CDLABEL finds the squashfs by the VOLUME ID
  # (nullLinux-$VERSION), which is baked into the image and independent of what
  # the file on disk is called.
  iso="$WORK/$NAME-$VERSION.iso"
  tmpiso="$iso.new"
  rm -f "$tmpiso" || exit 1

  # THE MEDIUM'S OWN MENU, given the installer's opinion (bin/null-installer-iso;
  # verify/check-boot-menu.sh §6-8). lorax writes `set default="1"` -- the media
  # check, a full read of three gigabytes before a desktop appears -- and
  # `set timeout=60`, and titles every entry "$product $releasever":
  # "Start nullLinux 44". That last is Fedora's release number standing in for
  # the product's version, which this distribution is never to do (the installer
  # says "Install nullLinux 0.1.0"); it happens because --releasever must stay
  # Fedora's for the package repos and livemedia-creator has no other knob.
  #
  # So the built image is rewritten: entry 0 (Start) by default, five seconds,
  # and the product's own version in the titles. mkksiso does the rewrite
  # properly -- both grub.cfg copies AND the grub.cfg inside the EFI boot image
  # -- and re-implants the md5 the media check relies on. With no --ks it embeds
  # nothing; it only edits. A failure here is a failure of the build: an image
  # that announces the wrong version is not shippable.
  if mkksiso -R 'set default="1"' 'set default="0"' \
            -R 'set timeout=60'   'set timeout=5' \
            -R "nullLinux $REL"   "nullLinux $VERSION" \
            "$built" "$tmpiso" >"$WORK/mkksiso-live.log" 2>&1 \
     && [ -s "$tmpiso" ] && mv -fT "$tmpiso" "$iso"; then
    echo "  boot menu: starts nullLinux $VERSION in 5s (entry 0, not the media check)"
  else
    echo "null-iso: mkksiso FAILED to rewrite the boot menu -- $WORK/mkksiso-live.log" >&2
    tail -10 "$WORK/mkksiso-live.log" >&2
    rm -f "$tmpiso"
    exit 1
  fi
  echo "built: $iso"
  echo "  $(du -h "$iso" | cut -f1)"
  sha256sum "$iso" > "$iso.sha256" || exit 1
  cp "$repository/BUILD-INFO.json" "$iso.build-info.json" || exit 1
  echo
  echo "Write it to a stick with:"
  echo "  dd if=$iso of=/dev/sdX bs=4M status=progress oflag=sync"
else
  st=1
  echo "null-iso: the build FAILED -- last lines of ${compose:-$WORK}/livemedia.log" >&2
  tail -25 "${compose:-$WORK}/livemedia.log" 2>/dev/null >&2
fi
exit $st
