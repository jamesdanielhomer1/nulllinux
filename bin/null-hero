#!/usr/bin/env bash
# This screen's hero, derived from the master and cached (NULL.md §5.3, §0.5).
#
# The package ships the MASTER, not forty-five fixed grids, so the grid for a
# given screen is derived on that screen -- exactly, rather than by picking the
# nearest rung of a ladder that fits almost nothing.
#
# DERIVING COSTS ABOUT TWO MINUTES for 240 frames, so it happens ONCE per
# (grid, strike) and the answer is cached. Nothing waits on it: the wallpaper
# starts immediately on the nearest prebuilt rung and is restarted on the exact
# one when it is ready. A login that blocks for two minutes on a wallpaper
# would be a worse defect than the one this fixes.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
MASTER="$ROOT/assets/prebuilt/master.hero"

# System-wide where possible: the grid depends on the screen, not on who is
# logged in, and two accounts on one machine should not derive it twice.
if [ -w /var/cache ] || [ -w /var/cache/nulllinux ] 2>/dev/null; then
  CACHE=/var/cache/nulllinux/hero
else
  CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/nulllinux/hero"
fi

die() { printf 'null-hero: %s\n' "$*" >&2; exit 1; }

key() {  # <cols> <rows> <ramp-file>
  local cols=$1 rows=$2 ramp=$3 h
  # The ramp is part of the key: the same grid quantised against a different
  # strike's ramp is a different picture, and handing one to the other's atlas
  # is exactly the §2.3 inversion this project already has a check for.
  # Changes to the master, palette or derivation implementation also change
  # the picture. Old cache entries must not survive those inputs changing.
  h=$(sha256sum "$MASTER" "$ramp" "$ROOT/assets/palette.json" \
        "$ROOT/assets/palette.bin" "$ROOT/render/target/release/render" 2>/dev/null \
        | awk '{print $1}' | sha256sum | cut -c1-24) \
    || die "cannot fingerprint the hero inputs"
  [ -n "$h" ] || die "cannot fingerprint the hero inputs"
  printf '%sx%s-%s' "$cols" "$rows" "$h"
}

path() { local k; k=$(key "$@") || return 1; printf '%s/%s.cells\n' "$CACHE" "$k"; }

case "${1:-}" in
  path)
    [ $# -eq 4 ] || die "path needs <cols> <rows> <ramp>"
    path "$2" "$3" "$4" ;;

  have)
    [ $# -eq 4 ] || die "have needs <cols> <rows> <ramp>"
    p=$(path "$2" "$3" "$4") || exit 1; [ -s "$p" ] ;;

  ensure)
    [ $# -eq 4 ] || die "ensure needs <cols> <rows> <ramp>"
    cols=$2; rows=$3; ramp=$4
    [ -r "$MASTER" ] || die "no master at $MASTER -- this package shipped without one"
    p=$(path "$cols" "$rows" "$ramp") || exit 1
    [ -s "$p" ] && { echo "$p"; exit 0; }
    mkdir -p "$CACHE" || die "cannot create $CACHE"

    # ONE DERIVATION AT A TIME for a given grid. Two outputs of the same size,
    # or a restart racing the first run, would otherwise do the same two
    # minutes of work twice and write the same file underneath each other.
    lock="$p.lock"
    exec 9>"$lock" || die "cannot lock $lock"
    if ! flock -w 600 9; then die "timed out waiting for another derivation"; fi
    [ -s "$p" ] && { echo "$p"; exit 0; }

    # THE RUST DERIVER, not the Python one.
    #
    # They do the same work and agree to within one ramp step
    # (verify/check-derive-parity.sh). The Python needs numpy -- about 30 MB on
    # every installed machine, to run for two minutes once per screen, when
    # nothing else installed needs numpy at all. The Rust does it in twelve
    # seconds with no dependency beyond what the renderer already links.
    #
    # bake/derive_for_screen.py stays as the reference the parity check
    # measures against, and is what a build host uses.
    tmp="$p.partial.$$"
    RENDER="$ROOT/render/target/release/render"
    [ -x "$RENDER" ] || die "$RENDER is not built"
    if "$RENDER" derive \
         --master "$MASTER" --cols "$cols" --rows "$rows" \
         --ramp "$ramp" \
         --palette-meta "$ROOT/assets/palette.json" \
         --palette "$ROOT/assets/palette.bin" \
         --out "$tmp" >&2; then
      # Rename, never write in place: a reader that opens a half-written cells
      # file sees a truncated animation rather than an error.
      mv -f "$tmp" "$p" && echo "$p"
    else
      rm -f "$tmp"; die "deriving ${cols}x${rows} failed"
    fi ;;

  where)  echo "$CACHE" ;;
  list)   ls -la "$CACHE" 2>/dev/null || echo "  nothing derived yet" ;;
  clear)  rm -rf "$CACHE" && echo "cleared $CACHE" ;;
  *) cat >&2 <<USAGE
usage: null-hero <verb> [args]

  have   <cols> <rows> <ramp>   exit 0 if this grid is already derived
  path   <cols> <rows> <ramp>   where it would be
  ensure <cols> <rows> <ramp>   derive it if absent, print the path
  where                          the cache directory
  list                           what has been derived
  clear                          throw it all away
USAGE
    exit 2 ;;
esac
