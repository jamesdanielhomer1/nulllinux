#!/usr/bin/env bash
# Install this desktop SYSTEM-WIDE, for every user (NULL.md §9.4).
#
# The point is that a NEW USER GETS THIS WITH NO SETUP AT ALL. Not "runs a
# script once" -- nothing. A desktop that belongs to one account is a desktop
# that has to be reinstalled per person, and the reinstall is where it drifts.
#
# So each piece goes where the system already looks for it:
#
#   sway     /etc/sway/config is what sway reads when a user has no
#            ~/.config/sway/config of their own.
#   GTK      a real theme in /usr/share/themes, selected by a settings key --
#            not a per-user gtk.css, which only exists in one home.
#   icons    /usr/share/icons, not ~/.local/share/icons.
#   settings /etc/dconf/db/local.d, which the dconf profile here already reads
#            (`system-db:local`), so the keys are DEFAULTS rather than writes
#            into one person's database. A user can still override them.
#   thunar   its own system-wide xfconf defaults.
#
# Same promises as bin/null-system: reports with no --apply, snapshots first,
# backs up what it replaces, and refuses rather than guesses.
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP=/root/.null-install-backup-$STAMP
APPLY=0
[ "${1:-}" = "--apply" ] && APPLY=1

say()  { printf '  %s\n' "$*"; }
head_(){ printf '\n== %s\n' "$*"; }
refuse(){ printf 'REFUSING: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || refuse "must run as root -- it writes under /etc and /usr"

backup() {
  [ -e "$1" ] || return 0
  [ "$APPLY" -eq 1 ] || { say "would back up $1"; return 0; }
  mkdir -p "$BACKUP$(dirname "$1")"; cp -a "$1" "$BACKUP$1"; say "backed up $1"
}
# Snapshots, and their pruning, are shared with bin/null-system (lib/snapshot.sh)
# -- one copy, and the one that keeps the pile bounded.
. "$ROOT/lib/snapshot.sh"
snapshot() { null_snapshot install; }
restore_selinux() { command -v restorecon >/dev/null && restorecon -RF "$1" 2>/dev/null || true; }

# The checkout must be readable by every user, or none of this works.
head_ "the checkout"
say "location: $ROOT"
mode=$(stat -c %a "$ROOT")
case "$ROOT" in
  /home/*|/root/*) refuse "$ROOT is inside a home directory. Other users cannot read it,
          which is the whole problem this is meant to solve. Put it somewhere
          shared -- /opt/nulllinux -- and run this again." ;;
esac
say "mode $mode, owner $(stat -c '%U:%G' "$ROOT")"
sudo -u nobody test -r "$ROOT/config/sway/config" 2>/dev/null \
  && say "readable by an unprivileged user" \
  || refuse "not readable by an unprivileged user; every other step would be pointless"

# IS THIS MACHINE ALREADY SOMEBODY ELSE'S?
#
# This installs itself as the system-wide desktop: /etc/sway/config, the
# greeter theme, the GTK and icon themes, a dconf drop-in, /etc/profile.d, an
# /etc/gitconfig include. On a machine running a DIFFERENT checkout that is not
# an install, it is a takeover -- and it is silent, because every step succeeds.
#
# It happened: running bin/null-machine-sync on a build host repointed
# /etc/sway/config from the other installation to this one, added a second
# sddm theme and a second dconf drop-in, and would have handed that machine a
# different desktop at its next login. Nothing failed; there was nothing to
# notice.
#
# So: if /etc/sway/config includes a checkout that is not this one AND that
# checkout is still there, refuse. NULL_REPLACE=1 says you mean it.
#
# EVERY include, NOT THE FIRST ONE.
#
# This took `head -1`, and Fedora's stock sway config opens with
# `include /etc/sway/config.d/*`. That is not a checkout, so the guard passed
# and went on to overwrite the installation named on the NEXT line -- the exact
# thing it was written to stop, disarmed by a line that was already there.
# Quotes are stripped too: `include "/opt/rice/..."` kept its quote, the
# directory test failed on the quoted name, and the guard passed again.
if [ -r /etc/sway/config ]; then
  other_root=""
  while read -r inc; do
    inc=${inc#\"}; inc=${inc%\"}       # include "path"
    inc=${inc#\'}; inc=${inc%\'}       # include 'path'
    case $inc in */config/sway/config) ;; *) continue ;; esac
    cand=${inc%/config/sway/config}
    [ -n "$cand" ] && [ "$cand" != "$ROOT" ] && [ -d "$cand" ] || continue
    other_root=$cand
    break
  done <<EOF
$(grep -oE '^[[:space:]]*include[[:space:]]+\S+' /etc/sway/config 2>/dev/null | awk '{print $2}')
EOF
  if [ -n "$other_root" ]; then
    if [ "${NULL_REPLACE:-0}" != 1 ]; then
      head_ "this machine already runs a different installation"
      say "/etc/sway/config includes $other_root/config/sway/config"
      say "and that checkout is still present. Installing over it would replace"
      say "someone else's desktop -- silently, because every step would succeed."
      say ""
      say "  NULL_REPLACE=1 $0 --apply    to replace it deliberately"
      exit 3
    fi
    say "NULL_REPLACE=1: replacing the installation at $other_root"
  fi
fi

head_ "sway, for users with no configuration of their own"
say "/etc/sway/config is what sway reads when ~/.config/sway/config is absent"
if [ "$APPLY" -eq 1 ]; then
  snapshot; backup /etc/sway/config
  cat > /etc/sway/config <<EOF
# Installed by $ROOT/bin/null-install -- do not edit.
#
# This is sway's fallback: it is read by any user who has no
# ~/.config/sway/config of their own, which is how a new account gets this
# desktop without running anything.
#
# A user who wants to diverge creates their own file, and this stops applying
# to them -- which is the correct escape hatch, and the reason this is a
# fallback rather than something forced into every home directory.
include $ROOT/config/sway/config
EOF
  say "installed /etc/sway/config -> includes $ROOT/config/sway/config"
else
  say "would replace /etc/sway/config with an include of $ROOT/config/sway/config"
fi

head_ "names this system used to use, and no longer does"
# A RENAME LEAVES THE OLD ONE BEHIND. The themes were installed lowercase
# before the case-sensitivity bug was found, and a stale /usr/share/themes/
# nulllinux is not inert: it is a directory that RESOLVES, so any setting still
# holding the old spelling silently gets an out-of-date copy of the theme
# instead of failing loudly and being fixed.
say "a superseded name that still resolves is worse than one that does not"
for legacy in /usr/share/themes/nulllinux /usr/share/icons/nulllinux; do
  [ -e "$legacy" ] || continue
  # Case-insensitive filesystems would make these the same path as the current
  # one; deleting then would delete what was just installed.
  [ "$legacy" -ef "$(dirname "$legacy")/nullLinux" ] && continue
  if [ "$APPLY" -eq 1 ]; then
    rm -rf "$legacy" && say "removed superseded $legacy"
  else
    say "would remove superseded $legacy"
  fi
done
# The stamp was renamed when the first-boot job became a per-boot one.
if [ -e /var/lib/nulllinux/firstboot-done ]; then
  if [ "$APPLY" -eq 1 ]; then
    rm -f /var/lib/nulllinux/firstboot-done && say "removed the old firstboot-done stamp"
  else
    say "would remove the old firstboot-done stamp"
  fi
fi

head_ "the shell and git, where the SYSTEM looks -- not in anyone's home"
# §9.8 says HOW to join a file that belongs to a user. It does not say the
# shell prompt has to be joined at all, and joining it was wrong: the join
# happens per account, nothing ran it on a freshly installed machine, and root
# came up with no prompt and no colours. Both of these have a system-wide home
# that every account reads without any file of theirs being touched:
#
#   /etc/profile.d/  every login shell sources it, including accounts that do
#                    not exist yet.
#   /etc/gitconfig   git's system level, below ~/.gitconfig, so a user's own
#                    settings still win.
#
# bin/null-join stays for a development checkout, where /etc belongs to another
# installation and must not be written.
say "/etc/profile.d is read by every login shell; /etc/gitconfig sits below the user's own"
if [ "$APPLY" -eq 1 ]; then
  backup /etc/profile.d/nulllinux.sh
  cat > /etc/profile.d/nulllinux.sh <<EOF
# Installed by $ROOT/bin/null-install -- do not edit.
# Sourced by every login shell. A user who wants none of it sets NULL_NO_SHELL.
[ -n "\${NULL_NO_SHELL:-}" ] || {
  NULL_ROOT=$ROOT
  . "$ROOT/config/shell/null.sh"
}
EOF
  chmod 0644 /etc/profile.d/nulllinux.sh
  say "installed /etc/profile.d/nulllinux.sh -> $ROOT/config/shell/null.sh"
  git config --system --replace-all include.path "$ROOT/config/git/config" 2>/dev/null \
    && say "set include.path in /etc/gitconfig -> $ROOT/config/git/config" \
    || say "could not set /etc/gitconfig (git absent?); the colours are the only loss"
else
  say "would install /etc/profile.d/nulllinux.sh and set include.path in /etc/gitconfig"
fi

head_ "something has to start the desktop"
# A DESKTOP NOBODY CAN REACH IS NOT INSTALLED.
#
# Every other step here puts configuration where the system looks, so a new
# account "gets this desktop by logging in". That promise assumed something was
# offering a login. Nothing was: a machine installed from the ISO had sway and
# the whole desktop and booted to a text console, because no display manager
# was installed and the default target was multi-user.
#
# Invisible on the build host, which had sddm from before, and in every VM
# test, which started sway by hand over ssh.
say "sddm offers the login; graphical.target is what makes the machine boot to it"
if [ -f /usr/lib/systemd/system/sddm.service ]; then
  say "currently: default target $(systemctl get-default 2>/dev/null), display-manager $(systemctl is-enabled display-manager.service 2>/dev/null || echo not-found)"
  if [ "$APPLY" -eq 1 ]; then
    systemctl enable sddm.service >/dev/null 2>&1 && say "enabled sddm.service" || refuse "could not enable sddm.service"
    systemctl set-default graphical.target >/dev/null 2>&1 && say "default target is now graphical.target" || refuse "could not set the default target"
  else
    say "would enable sddm.service and set graphical.target as the default"
  fi
else
  # NAMED, not silently skipped: the package Requires it, so its absence means
  # the install did not finish rather than a choice anyone made.
  say "sddm is NOT INSTALLED -- this machine will boot to a text console."
  say "  The package requires it; if it is missing the install did not finish."
  [ "$APPLY" -eq 0 ] || refuse "sddm is missing"
fi

head_ "the GTK theme, as a theme"
say "a per-user gtk.css lives in one home; a theme in /usr/share/themes is everyone's"
# THE SAME NAMING BUG AS THE ICONS, and it hid for the same reason.
#
# The stylesheet installs as a theme, and a GTK theme is looked up by its
# DIRECTORY NAME, case-sensitively. This wrote /usr/share/themes/nulllinux
# while the settings key below says 'nullLinux', so the lookup missed and GTK
# used its own default -- meaning the stylesheet that themes the file manager
# and every menu was loaded by nothing, on every machine.
#
# It hid because there was a THIRD answer that nothing read: config/gtk-*/
# settings.ini said Default and was installed nowhere at all, so it could
# contradict both of the others without consequence. It is installed now
# (below), and verify/check-theme-names.sh requires all of them to agree.
for v in 3.0 4.0; do
  src="$ROOT/config/gtk-$v/gtk.css"
  [ -r "$src" ] || { say "no $src -- skipping gtk-$v"; continue; }
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p "/usr/share/themes/nullLinux/gtk-$v"
    chmod 0755 /usr/share/themes/nullLinux "/usr/share/themes/nullLinux/gtk-$v"
    cp -a "$src" "/usr/share/themes/nullLinux/gtk-$v/gtk.css"
    chmod 0644 "/usr/share/themes/nullLinux/gtk-$v/gtk.css"
    say "installed /usr/share/themes/nullLinux/gtk-$v/gtk.css"
  else
    say "would install /usr/share/themes/nullLinux/gtk-$v/gtk.css"
  fi
done
if [ "$APPLY" -eq 1 ]; then
  printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=nullLinux\nComment=Derived from the hero\n' \
    > /usr/share/themes/nullLinux/index.theme
  chmod 0644 /usr/share/themes/nullLinux/index.theme
  restore_selinux /usr/share/themes/nullLinux
fi

head_ "the icon theme"
if [ "$APPLY" -eq 1 ]; then
  # THE DIRECTORY NAME IS THE THEME NAME, and it is case-sensitive.
  #
  # GTK resolves gtk-icon-theme-name against the DIRECTORY in /usr/share/icons,
  # not against the Name= field inside index.theme. This installed to
  # `nulllinux` while the settings key said `nullLinux`, so the lookup found
  # nothing and GTK fell back to its default set -- silently, which is the §8.10
  # trap this project already knew about and fell into anyway. Meanwhile the
  # settings.ini files named Adwaita, a third answer again. The baked icon
  # theme was reaching nothing at all.
  #
  # One spelling now, everywhere, and verify/check-icon-theme-name.sh fails if
  # they ever disagree again.
  #
  # SHIPPED ICONS ARE USED WHERE THEY EXIST. The theme is a function of the
  # palette alone, so regenerating it on the target derives the same bytes from
  # the same input -- and requires python, pillow and gobject on a machine that
  # otherwise needs none of them.
  if [ -d "$ROOT/assets/prebuilt/theme/icons" ]; then
    rm -rf /usr/share/icons/nullLinux
    cp -a "$ROOT/assets/prebuilt/theme/icons" /usr/share/icons/nullLinux \
      || refuse "could not install the icon theme"
    echo "    installed /usr/share/icons/nullLinux (prebuilt)"
    gtk-update-icon-cache -f -t /usr/share/icons/nullLinux >/dev/null 2>&1 || true
    # The generated branch below restores SELinux contexts and this must too:
    # a theme copied into /usr/share with the wrong label is a theme the
    # toolkit cannot read, and the failure looks like a missing icon set.
    restore_selinux /usr/share/icons/nullLinux
  elif python3 "$ROOT/bake/make_icons.py" --out /usr/share/icons/nullLinux 2>&1 | sed 's/^/    /'; then
    gtk-update-icon-cache -f -t /usr/share/icons/nullLinux >/dev/null 2>&1 || true
    restore_selinux /usr/share/icons/nullLinux
    say "installed /usr/share/icons/nullLinux"
  else
    refuse "icon generation failed -- the theme key would name a theme that is not there"
  fi
else
  say "would generate /usr/share/icons/nullLinux"
fi

head_ "settings keys, as system DEFAULTS"
say "written to /etc/dconf/db/local.d, which this machine's dconf profile reads"
say "as system-db:local -- so they are defaults a user may still override"
if [ "$APPLY" -eq 1 ]; then
  backup /etc/dconf/db/local.d/00-nulllinux
  mkdir -p /etc/dconf/db/local.d
  cat > /etc/dconf/db/local.d/00-nulllinux <<'EOF'
# Installed by null-install -- do not edit.
[org/gnome/desktop/interface]
gtk-theme='nullLinux'
icon-theme='nullLinux'
cursor-theme='Adwaita'
cursor-size=24
font-name='Terminus 12'
document-font-name='Terminus 12'
monospace-font-name='Terminus 12'
color-scheme='prefer-dark'
enable-animations=false
EOF
  dconf update || refuse "could not rebuild the dconf database"
  say "dconf database rebuilt"
else
  say "would write /etc/dconf/db/local.d/00-nulllinux and run dconf update"
fi

head_ "the other applications' configuration, system-wide"
say "each reads /etc/xdg as well as the user's own directory (XDG_CONFIG_DIRS),"
say "so this is a DEFAULT a user can still override by writing their own"
# fzf is deliberately absent: it is configured by environment variables from
# the shell profile, not by a file, so it comes in through the shell join.
# GTK's settings.ini, which was written and then installed nowhere.
#
# Not the same mechanism as the settings KEYS: gsettings needs a settings
# daemon or a portal to be answering, and on a bare compositor session there
# often is not one -- in which case settings.ini is what GTK actually reads.
# Both must therefore say the same thing, and until now the file said Default
# while the key said nullLinux and neither resolved to the shipped theme.
#
# Only settings.ini is copied, deliberately: gtk.css goes in as a THEME, and
# copying it here as well would apply the same stylesheet twice.
for v in 3.0 4.0; do
  src="$ROOT/config/gtk-$v/settings.ini"
  [ -r "$src" ] || continue
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p "/etc/xdg/gtk-$v"; backup "/etc/xdg/gtk-$v/settings.ini"
    chmod 0755 "/etc/xdg/gtk-$v"
    cp -a "$src" "/etc/xdg/gtk-$v/settings.ini"
    chmod 0644 "/etc/xdg/gtk-$v/settings.ini"
    restore_selinux "/etc/xdg/gtk-$v"
    say "installed /etc/xdg/gtk-$v/settings.ini"
  else
    say "would install /etc/xdg/gtk-$v/settings.ini"
  fi
done

# EACH APPLICATION IS ASKED WHERE IT LOOKS, rather than all of them being
# assumed to read /etc/xdg.
#
# This was `for app in btop dunst foot` writing /etc/xdg/$app for all three,
# and only two of the three were right. btop reads $XDG_CONFIG_HOME/btop and
# nothing else -- no system-wide path at all -- so /etc/xdg/btop/btop.conf was
# written on every install and read by nothing, for as long as the file has
# existed. Verified against each program's own manual page, not from memory:
#
#   dunst    /etc/xdg/dunst/dunstrc     (man 5 dunst names XDG_CONFIG_DIRS)
#   foot     /etc/xdg/foot/foot.ini     (man 5 foot names it)
#   mpv      /etc/mpv/mpv.conf          (man 1 mpv; NOT /etc/xdg)
#   imv      /etc/imv_config            (a FILE, and not even under a directory)
#   zathura  /etc/zathurarc             (a FILE)
#   btop     -- none. Seeded per user by bin/null-firstrun.
#   nano     /etc/nanorc                (man 5 nanorc names it first, ahead of
#                                        ~/.nanorc and the XDG path)
#
# Format: <config subdirectory>|<destination>. A destination ending in / is a
# directory to fill; anything else is a single file to write.
for entry in \
    "dunst|/etc/xdg/dunst/" \
    "foot|/etc/xdg/foot/" \
    "mpv|/etc/mpv/" \
    "imv/config|/etc/imv_config" \
    "zathura/zathurarc|/etc/zathurarc" \
    "swaynag/config|/etc/swaynag/config" \
    "systemd/10-null-lid.conf|/etc/systemd/logind.conf.d/10-null-lid.conf" \
    "vconsole/vtrgb|/etc/vconsole/vtrgb" \
    "nano/nanorc|/etc/nanorc" \
    "firefox/policies.json|/etc/firefox/policies/policies.json" \
    "mimeapps.list|/etc/xdg/mimeapps.list" \
    "fastfetch|/etc/xdg/fastfetch/" \
  ; do
  from=${entry%%|*}; to=${entry##*|}
  src="$ROOT/config/$from"
  [ -e "$src" ] || { say "no $src -- skipping"; continue; }
  case $to in
    */)
      if [ "$APPLY" -eq 1 ]; then
        backup "${to%/}"; mkdir -p "$to"
        cp -a "$src"/. "$to"
        chmod 0755 "$to"
        restore_selinux "${to%/}"
        say "installed $to ($(ls "$src" | tr '\n' ' '))"
      else
        say "would install $to"
      fi ;;
    *)
      if [ "$APPLY" -eq 1 ]; then
        backup "$to"; mkdir -p "$(dirname "$to")"
        cp -a "$src" "$to"
        restore_selinux "$to"
        say "installed $to"
      else
        say "would install $to"
      fi ;;
  esac
done

head_ "the virtual console's sixteen colours"
say "before the greeter appears, on every tty, and any time the desktop fails"
say "to start, the console used the kernel's own palette -- the bright"
say "primaries every Linux machine has had since 1992"
say ""
say "THE KERNEL COMMAND LINE, NOT setvtrgb."
say "  setvtrgb changes the console it is given, and each virtual console gets"
say "  its palette from the kernel's DEFAULTS when it is allocated -- so a tty"
say "  a person switches to later is created with the old colours. A unit"
say "  running setvtrgb at boot reported success and changed nothing that"
say "  anyone would go on to look at. vt.default_red/grn/blu set the defaults"
say "  themselves, so every console has them from the moment it exists."
say ""
say "THE FONT IS NOT TOUCHED HERE. A console font over 256 glyphs loses bright"
say "backgrounds (§9.5), so it stays an opt-in \`null-system tty\`. Colours"
say "cannot break a console; a font can."
VTRGB="$ROOT/config/vconsole/vtrgb"
if [ -r "$VTRGB" ] && command -v grubby >/dev/null 2>&1; then
  vt_r=$(sed -n 1p "$VTRGB"); vt_g=$(sed -n 2p "$VTRGB"); vt_b=$(sed -n 3p "$VTRGB")
  if [ -z "$vt_r" ] || [ -z "$vt_g" ] || [ -z "$vt_b" ]; then
    say "$VTRGB is not three lines -- leaving the console alone"
  elif [ "$APPLY" -eq 1 ]; then
    if grubby --update-kernel=ALL \
         --args="vt.default_red=$vt_r vt.default_grn=$vt_g vt.default_blu=$vt_b" >/dev/null 2>&1; then
      # AND CHECK IT. grubby exits 0 on a good deal more than it should.
      if grubby --info=DEFAULT 2>/dev/null | grep -q "vt.default_red=$vt_r"; then
        say "set vt.default_red/grn/blu on every boot entry"
      else
        say "grubby reported success but the argument is not on the default entry"
      fi
    else
      say "could not set the console palette on the kernel command line"
    fi
  else
    say "would set vt.default_red/grn/blu on every boot entry"
  fi
else
  say "no $VTRGB or no grubby -- the console keeps the kernel's colours"
fi

head_ "the session the greeter offers"
say "without this the greeter lists Fedora's generic \"Sway\", which runs bare"
say "sway -- so the session has no name of ours and nowhere to set environment"
SESSION_SRC="$ROOT/packaging/nulllinux-session.desktop"
SESSION_DST=/usr/share/wayland-sessions/nulllinux.desktop
if [ -r "$SESSION_SRC" ]; then
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p /usr/share/wayland-sessions
    backup "$SESSION_DST"
    # The Exec path is written from $ROOT rather than assumed, so a checkout
    # somewhere other than /opt/nulllinux produces a session entry that works.
    sed "s|/opt/nulllinux/bin/null-session|$ROOT/bin/null-session|g" \
        "$SESSION_SRC" > "$SESSION_DST"
    chmod 0644 "$SESSION_DST"
    restore_selinux "$SESSION_DST"
    say "installed $SESSION_DST -> $ROOT/bin/null-session"
  else
    say "would install $SESSION_DST -> $ROOT/bin/null-session"
  fi
else
  say "no $SESSION_SRC -- the greeter will offer Fedora's Sway instead"
fi

head_ "the screen lock's PAM stack"
# The session-lock client authenticates through PAM as the service "null-lock".
# With no /etc/pam.d/null-lock the handle falls to /etc/pam.d/other, which on
# Fedora denies every request -- so the locker refuses every password and the
# machine cannot be unlocked by its own screen lock. The RPM ships this via
# %files; the in-place install has to do it too, or a machine set up this way
# locks and never opens. (Found doing exactly that on the build host.)
pamsrc="$ROOT/config/pam.d/null-lock"
if [ -r "$pamsrc" ]; then
  if [ "$APPLY" -eq 1 ]; then
    mkdir -p /etc/pam.d; backup /etc/pam.d/null-lock
    cp -a "$pamsrc" /etc/pam.d/null-lock
    restore_selinux /etc/pam.d/null-lock
    say "installed /etc/pam.d/null-lock"
  else
    say "would install /etc/pam.d/null-lock"
  fi
else
  say "no PAM stack at $pamsrc -- the lock would deny every password"
fi

head_ "file manager defaults"
xd=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml
if [ "$APPLY" -eq 1 ]; then
  mkdir -p "$xd"; backup "$xd/thunar.xml"
  cat > "$xd/thunar.xml" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!-- Installed by null-install -- do not edit. -->
<channel name="thunar" version="1.0">
  <property name="default-view" type="string" value="ThunarDetailsView"/>
  <property name="misc-date-style" type="string" value="THUNAR_DATE_STYLE_YYYYMMDD"/>
  <property name="misc-single-click" type="bool" value="false"/>
  <property name="last-show-hidden" type="bool" value="true"/>
  <property name="misc-text-beside-icons" type="bool" value="false"/>
</channel>
EOF
  say "installed $xd/thunar.xml"
else
  say "would install $xd/thunar.xml"
fi

echo
if [ "$APPLY" -eq 0 ]; then
  echo "Nothing was written. Re-run with --apply."
else
  echo "Done. A NEW USER NOW NEEDS NO SETUP: sway, the GTK theme, the icons,"
  echo "the settings keys and the file manager defaults are all system-wide."
  echo
  echo "The one thing that is still per-user is the browser chrome, because"
  echo "Firefox reads userChrome.css only from inside a profile. Run"
  echo "  $ROOT/bin/null-firefox --apply"
  echo "  $ROOT/bin/null-thunderbird --apply"
  echo "as that user, or skip it and the browser is simply untouched."
fi
