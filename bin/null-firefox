#!/usr/bin/env bash
# Install the web-class theming into the browser profile (NULL.md §8.10, §9.8).
#
# The work is in lib/gecko.sh. Thunderbird needs exactly the same thing done to
# exactly the same shape of profile -- same profiles.ini, same chrome/, same
# pref deciding whether the stylesheet is read at all -- and two copies of
# ninety lines differing by a path is the shape that drifts. Every drift in this
# project has been silent.
#
# Report-first: with no --apply, nothing is written.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
. "$ROOT/lib/gecko.sh"

APPLY=0
case "${1:-}" in
  --apply)      APPLY=1 ;;
  ''|--dry-run) ;;
  -h|--help)    echo "usage: null-firefox [--apply]"; exit 0 ;;
  *) echo "null-firefox: unknown argument '$1'" >&2; exit 2 ;;
esac

null_gecko_apply firefox "$ROOT/config/firefox" "$HOME/.mozilla/firefox" firefox "$APPLY"
