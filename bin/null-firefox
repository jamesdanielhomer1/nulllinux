#!/usr/bin/env bash
# Install the web-class theming into the browser profile (NULL.md §8.10, §9.8).
#
# A browser profile is the USER'S, not ours. So:
#
#   * chrome/ is ours entirely and is symlinked, because nothing else writes
#     there;
#   * user.js may already hold the user's own preferences, so our block is
#     written BETWEEN MARKERS and rewritten in place on every run. Appending a
#     copy instead would drift the moment the generator changed, and
#     overwriting would take settings that are not ours to take.
#
# Report-first: with no --apply, nothing is written.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
APPLY=0
[ "${1:-}" = "--apply" ] && APPLY=1
SRC="$ROOT/config/firefox"
MARK_A="// >>> nullLinux (generated by bin/null-firefox) -- do not edit inside"
MARK_B="// <<< nullLinux"

[ -d "$SRC/chrome" ] || { echo "null-firefox: no $SRC (run bake/make_web.py)" >&2; exit 1; }

MOZ="$HOME/.mozilla/firefox"
find_profile() {
  local ini="$MOZ/profiles.ini"
  [ -r "$ini" ] || return 1
  # Prefer the profile the installation actually starts with, not the first
  # one listed: a profiles.ini can carry several and only one is default.
  local p
  p=$(awk -F= '/^\[Install/{i=1} i&&/^Default=/{print $2; exit}' "$ini")
  [ -n "$p" ] || p=$(awk -F= '/^Default=1/{found=1} /^Path=/{path=$2} found&&path{print path; exit}' "$ini")
  [ -n "$p" ] || p=$(awk -F= '/^Path=/{print $2; exit}' "$ini")
  [ -n "$p" ] || return 1
  case "$p" in /*) echo "$p" ;; *) echo "$MOZ/$p" ;; esac
}

PROFILE=$(find_profile) || PROFILE=""
if [ -z "$PROFILE" ] || [ ! -d "$PROFILE" ]; then
  echo "no browser profile found"
  if [ "$APPLY" -eq 0 ]; then
    echo "would create one at $MOZ/nulllinux"
    exit 0
  fi
  mkdir -p "$MOZ"
  firefox --headless --CreateProfile "nullLinux $MOZ/nulllinux" >/dev/null 2>&1
  PROFILE="$MOZ/nulllinux"
  [ -d "$PROFILE" ] || { echo "REFUSING: could not create a profile" >&2; exit 1; }
  echo "created $PROFILE"
fi
echo "profile: $PROFILE"

if [ "$APPLY" -eq 0 ]; then
  echo "would link  $PROFILE/chrome -> $SRC/chrome"
  if [ -e "$PROFILE/user.js" ]; then
    if grep -qF "$MARK_A" "$PROFILE/user.js" 2>/dev/null; then
      echo "would rewrite the existing nullLinux block in $PROFILE/user.js"
    else
      echo "would append a marked nullLinux block to $PROFILE/user.js (backing it up)"
    fi
  else
    echo "would create $PROFILE/user.js with a marked nullLinux block"
  fi
  echo
  echo "nothing written. Re-run with --apply."
  exit 0
fi

ln -sfn "$SRC/chrome" "$PROFILE/chrome"
echo "  linked $PROFILE/chrome"

TARGET="$PROFILE/user.js"
if [ -e "$TARGET" ] && ! grep -qF "$MARK_A" "$TARGET"; then
  cp -a "$TARGET" "$TARGET.null-backup-$(date +%Y%m%d-%H%M%S)"
  echo "  backed up the existing user.js"
fi
python3 - "$TARGET" "$SRC/user.js" "$MARK_A" "$MARK_B" <<'PY'
import sys, pathlib
target, src, a, b = sys.argv[1:5]
p = pathlib.Path(target)
block = a + "\n" + pathlib.Path(src).read_text().rstrip() + "\n" + b + "\n"
old = p.read_text() if p.exists() else ""
if a in old and b in old:
    head, rest = old.split(a, 1)
    _, tail = rest.split(b, 1)
    new = head + block + tail.lstrip("\n")
    what = "rewrote the nullLinux block"
else:
    new = (old.rstrip() + "\n\n" if old.strip() else "") + block
    what = "added the nullLinux block"
p.write_text(new)
print(f"  {what} in {target}")
PY

echo
echo "The chrome stylesheet is ignored entirely, and in silence, unless"
echo "toolkit.legacyUserProfileCustomizations.stylesheets is true -- which the"
echo "block above sets. It takes effect at the next browser start."
