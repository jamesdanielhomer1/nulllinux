#!/usr/bin/env bash
# What opens what (NULL.md §8.4).
#
# IT OWNS ALMOST NOTHING. For a kind of file the desktop's own registry has the
# answer: xdg-mime reads and writes ~/.config/mimeapps.list, and the file
# manager, the browser and every picker consult that same file -- so this asks
# it and tells it. Two roles have no MIME type, because they are not files: the
# terminal and the editor. Those two are one line each in
# ~/.config/nulllinux/defaults, and bin/null-open reads them.
#
# THE ROLE KEYS ARE null-open's ROLES (dir, editor, image, pdf, video, audio,
# archive), so null-open can ask `null-defaults resolve <role>` and honour a
# person's choice before its own order of preference. The two extra keys --
# browser and terminal -- are things the desktop opens that null-open does not.
# A friendlier word is shown for the three whose role key reads oddly (dir is
# "files", image is "images", audio is "music").
#
# WHY THIS EXISTS. On the build host a PDF or a screenshot opened from the file
# manager landed in the BROWSER: the distribution's mimeapps.list names viewers
# this system does not install (eog, evince), and the fallback after those is
# whichever entry claims the type first -- Firefox. Nothing in the desktop said
# so, and nothing let a person change it. config/mimeapps.list now ships the
# right answer system-wide, and this reads and changes a person's own.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nulllinux/defaults"

# Order is the order they are shown: the everyday ones first.
ROLES="browser dir terminal editor image pdf video audio archive"
U="--"

# The word a person reads for a role whose key reads oddly.
label() {
  case $1 in dir) echo files ;; image) echo images ;; audio) echo music ;; *) echo "$1" ;; esac
}

# The MIME types a role answers for. The FIRST is the one asked about; a default
# is written for ALL of them, because a viewer set for application/pdf alone
# leaves the next kind of document opening somewhere else. terminal and editor
# have none -- they are not files.
mimes() {
  case $1 in
    browser) echo "text/html x-scheme-handler/http x-scheme-handler/https" ;;
    dir)     echo "inode/directory" ;;
    image)   echo "image/png image/jpeg image/gif image/webp image/bmp image/tiff image/svg+xml" ;;
    pdf)     echo "application/pdf" ;;
    video)   echo "video/mp4 video/x-matroska video/webm video/quicktime video/x-msvideo" ;;
    audio)   echo "audio/mpeg audio/flac audio/ogg audio/x-wav audio/mp4 audio/aac" ;;
    archive) echo "application/zip application/x-tar application/gzip application/x-xz application/zstd application/x-7z-compressed application/vnd.rar" ;;
    *) return 1 ;;
  esac
}

# The programs that could be the terminal or the editor, in null-open's order of
# preference. vi is here because vim-minimal from @core provides it and no
# `vim`; nano first because it is the one the package list declares.
progs() {
  case $1 in
    terminal) echo "foot alacritty kitty wezterm gnome-terminal xterm" ;;
    editor)   echo "nano nvim vim vi micro hx emacs" ;;
  esac
}

# A field of a desktop entry, read from the file rather than guessed from its id.
entry_field() { python3 "$ROOT/lib/desktop.py" field "$1" "$2"; }
entry_exec() { python3 "$ROOT/lib/desktop.py" exec "$1"; }

# NUL-delimited argv is the internal launch contract; resolve remains readable.
resolve_argv() {
  local format=$1; shift
  local role=$1 v
  case $role in
    terminal|editor)
      v=$(resolve "$role") || return
      [ "$format" != launch-argv ] || printf '\0'
      printf '%s\0' "$v"
      [ $# -lt 2 ] || printf '%s\0' "$2" ;;
    *) v=$(get "$role") || return
       [ -n "$v" ] || return 1
       python3 "$ROOT/lib/desktop.py" "$format" "$v" "${@:2}" ;;
  esac
}

get() {  # <role> -> what is SET: a desktop id, or a program; nothing when unset
  case $1 in
    terminal|editor) sed -n "s/^${1^^}=//p" "$CONF" 2>/dev/null | tail -1 ;;
    *) local m; m=$(mimes "$1") || return 2
       xdg-mime query default "${m%% *}" 2>/dev/null ;;
  esac
}

# What would OPEN: the setting when it names something installed, else the first
# installed candidate. null-open runs exactly this before its own list.
resolve() {  # <role> -> a command
  local role=$1 v p
  case $role in
    terminal|editor)
      v=$(get "$role")
      [ -n "$v" ] && command -v "$v" >/dev/null 2>&1 && { echo "$v"; return 0; }
      for p in $(progs "$role"); do command -v "$p" >/dev/null 2>&1 && { echo "$p"; return 0; }; done
      return 1 ;;
    *)
      v=$(get "$role") || return 2
      [ -n "$v" ] || return 1
      entry_exec "$v" ;;
  esac
}

# What could answer for a role. For a MIME role, every desktop entry whose
# MimeType names the role's first type -- NoDisplay entries INCLUDED: imv and
# zathura hide themselves from the launcher because they want a file argument,
# and they are exactly the handlers wanted here. Rows are id<TAB>name.
candidates() {  # <role>
  case $1 in
    terminal|editor)
      local p; for p in $(progs "$1"); do
        command -v "$p" >/dev/null 2>&1 && printf '%s\t%s\n' "$p" "$p"
      done ;;
    *)
      local m; m=$(mimes "$1") || return 2
      python3 "$ROOT/lib/desktop.py" candidates "${m%% *}"
      ;;
  esac
}

shown() {  # <role> -> the name a person reads for what is set
  local role=$1 v
  case $role in
    terminal|editor) resolve "$role" 2>/dev/null || echo "$U" ;;
    *) v=$(get "$role" 2>/dev/null)
       [ -n "$v" ] && { entry_field "$v" Name 2>/dev/null || echo "$v"; } || echo "$U" ;;
  esac
}

set_default() {  # <role> <id.desktop | program>
  local role=$1 pick=$2 m temp
  case $role in
    terminal|editor)
      command -v "$pick" >/dev/null 2>&1 || { echo "null-defaults: $pick is not installed" >&2; return 1; }
      [[ $pick != *$'\n'* && $pick != *$'\r'* ]] || return 2
      mkdir -p "$(dirname "$CONF")" || return 1
      [ ! -e "$CONF" ] || { [ -f "$CONF" ] && [ -r "$CONF" ]; } \
        || { echo "null-defaults: not a readable configuration file: $CONF" >&2; return 1; }
      temp=$(mktemp "${CONF}.XXXXXX") || return 1
      if ! { grep -v "^${role^^}=" "$CONF" 2>/dev/null; printf '%s=%s\n' "${role^^}" "$pick"; } > "$temp" \
          || ! mv -fT -- "$temp" "$CONF"; then
        rm -f -- "$temp"; echo "null-defaults: could not save $CONF" >&2; return 1
      fi
      echo "$(label "$role") is $pick" ;;
    browser)
      # The browser is also every http and https link, and xdg-settings knows
      # all the places that has to be written.
      xdg-settings set default-web-browser "$pick" 2>/dev/null \
        || { echo "null-defaults: could not make $pick the browser" >&2; return 1; }
      echo "browser is $(entry_field "$pick" Name 2>/dev/null || echo "$pick")" ;;
    *)
      m=$(mimes "$role") || { echo "null-defaults: no such role '$role'" >&2; return 2; }
      # shellcheck disable=SC2086
      xdg-mime default "$pick" $m 2>/dev/null \
        || { echo "null-defaults: xdg-mime refused $pick for $role" >&2; return 1; }
      echo "$(label "$role") is $(entry_field "$pick" Name 2>/dev/null || echo "$pick")" ;;
  esac
}

case "${1:-show}" in
  show)       for r in $ROLES; do printf '%s\t%s\n' "$(label "$r")" "$(shown "$r")"; done ;;
  roles)      echo "$ROLES" ;;
  label)      label "${2:?role}" ;;
  get)        get "${2:?role}" ;;
  shown)      shown "${2:?role}" ;;
  resolve)    resolve "${2:?role}" ;;
  resolve-argv) resolve_argv argv "${2:?role}" "${@:3}" ;;
  resolve-launch) resolve_argv launch-argv "${2:?role}" "${@:3}" ;;
  candidates) candidates "${2:?role}" ;;
  set)        set_default "${2:?role}" "${3:?what}" ;;
  -h|--help|help)
    cat <<USAGE
usage: null-defaults [show|roles|get ROLE|shown ROLE|resolve ROLE|candidates ROLE|set ROLE WHAT]
  roles: $ROLES
  show        every role and what opens it
  get         what is set for a role (a desktop id, or a program)
  shown       the same, as a name a person reads
  resolve     the command that would open the role (what null-open runs)
  candidates  what is installed that could, id and name, tab separated
  set         make WHAT the default for ROLE
USAGE
    ;;
  *) echo "null-defaults: unknown verb '$1'" >&2; exit 2 ;;
esac
