#!/usr/bin/env bash
# The idle ladder (NULL.md §8.5).
#
#     dim  ->  screensaver  ->  lock  ->  screen off  ->  suspend
#
# THE ORDERING IS AN INVARIANT AND NOTHING ENFORCES IT FOR YOU. Set the lock
# later than the screen-off and the lock never observably fires: the display
# went dark first and you return to an unlocked machine. So this tool -- the
# only thing that edits the ladder -- drags the later stages with it and SAYS
# that it did.
#
# Stages are identified by WHAT THEY DO, not by their timeout or their
# configuration key: every stage has the same key and only the numbers change.
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}

# A live boot's temporary account has no password. Do not start or restore
# an idle locker or automatic suspend from the desktop or settings panel.
# The root-owned boot service creates this marker only for rd.live.image.
. "$ROOT/lib/live.sh"
if null_is_live; then
  case ${1:-show} in
    start|apply|toggle)
      . "$ROOT/lib/once.sh"
      null_only_one 'swayidle -w -C'
      echo "the idle ladder is off in the live session (automatic lock and suspend are disabled)"
      exit 0 ;;
    state) echo "off (live session)"; exit 0 ;;
    show) echo "the idle ladder is off in the live session; these timings are inactive" ;;
  esac
fi

# WHERE THE LADDER IS WRITTEN, AND WHY IT IS NOT ALWAYS THE CHECKOUT.
#
# This wrote $ROOT/config/sway/idle.conf unconditionally. On an installed
# machine $ROOT is /opt/nulllinux, which is root-owned, so an ordinary user --
# which is every user of an installed machine, since the session deliberately
# does not run as root -- got "permission denied" trying to change their own
# screen timeout. The tool worked perfectly on the developer's checkout and
# not at all on the product.
#
# So: every session edits its own copy, seeded from the system default on the
# first write, so changing one stage does not silently reset the other four.
#
# ROOT TOO. This once let root write the shipped file, on the theory that root
# on the build host is a developer editing the default. Then the build host
# became a nullLinux daily driver whose session runs as root, and every idle
# change made from its panel landed in a TRACKED file: the shipped default
# drifted with one person's habits, and the tree was never clean. The shipped
# default changes only when asked to, explicitly: NULL_IDLE_SYSTEM=1.
SYSTEM_CONF="$ROOT/config/sway/idle.conf"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nulllinux/idle.conf"

# "OFF" HAS TO SURVIVE A RELOAD, or it is not off.
#
# `toggle` used to kill swayidle and nothing else, so the ladder came back at
# the next `swaymsg reload` or the next login -- and the only way to make it
# stay off was to comment the exec line out of the compositor's configuration.
# Which is what happened, in the file EVERY installed machine reads, so every
# nullLinux has shipped with no dim, no screensaver, no lock, no idle suspend
# and no lock before sleep.
#
# Measured: a guest suspended and resumed with the same boot_id and the same
# compositor, and came back with no lock screen at all.
#
# A marker file instead. One person's machine, one person's choice, and it
# outlives a reload without editing anything that ships.
IDLE_OFF="${XDG_CONFIG_HOME:-$HOME/.config}/nulllinux/idle-off"
if [ "${NULL_IDLE_SYSTEM:-0}" = 1 ]; then
  CONF="$SYSTEM_CONF"
else
  CONF="$USER_CONF"
fi
NULL_UNMEASURED_LOCAL="--"

# name:default-seconds, in ladder order. The order in this list IS the
# invariant; everything below derives from it.
STAGES=(dim:150 screensaver:240 lock:300 screenoff:330 suspend:1800)

# Both end with an explicit `return 0`.
#
# A shell function returns the status of its LAST command, so a loop whose
# final iteration ends in a failed test returns 1 -- and under `set -e` a
# command substitution assigning from it takes the whole script down. That is
# how the first version of this tool came to print nothing at all and look as
# though it had passed.
stage_names() {
  local s
  for s in "${STAGES[@]}"; do echo "${s%%:*}"; done
  return 0
}
stage_default() {
  local s
  for s in "${STAGES[@]}"; do
    if [ "${s%%:*}" = "$1" ]; then echo "${s##*:}"; fi
  done
  return 0
}

# The file the ladder is READ from: the user's if they have one, otherwise the
# system default. Writing and reading are deliberately not the same path --
# a user who has never changed anything reads the system's numbers.
effective_conf() {
  [ -r "$USER_CONF" ] && { printf '%s\n' "$USER_CONF"; return 0; }
  printf '%s\n' "$SYSTEM_CONF"; return 0
}

# THE ARRAY IS THE TRUTH WHILE THE TOOL RUNS.
#
# write_conf used to call current(), which reads the FILE -- so after set_stage
# had computed new values into STAGES, the write read the old ones straight
# back off disk and wrote those. `null-idle set lock 600` printed "set lock to
# 600s" and wrote 300. It only ever appeared to work on a machine whose config
# did not exist yet, where current() fell through to the compiled-in defaults.
#
# So the file is loaded into the array ONCE, up front, and everything after
# that works on the array.
load_stages() {
  local src n v; src=$(effective_conf)
  [ -r "$src" ] || return 0
  local -a loaded=()
  for n in $(stage_names); do
    v=$(sed -n "s/^# null-stage $n \([0-9]*\)$/\1/p" "$src" | head -1)
    [ -n "$v" ] || v=$(stage_default "$n")
    loaded+=("$n:$v")
  done
  STAGES=("${loaded[@]}")
  return 0
}

current() {  # stage -> seconds
  local n=$1 v="" src
  src=$(effective_conf)
  if [ -r "$src" ]; then
    v=$(sed -n "s/^# null-stage $n \([0-9]*\)$/\1/p" "$src" | head -1)
  fi
  if [ -n "$v" ]; then echo "$v"; else stage_default "$n"; fi
  return 0
}

# On a machine with no battery the ladder does not end in suspend (§8.5).
# Discovered at runtime, never declared.
has_battery() { "$ROOT/bin/machine" probe battery 2>/dev/null; }

write_conf() {
  local -a names=(); mapfile -t names < <(stage_names)
  # The directory may not exist: a user's ~/.config/nulllinux is created the
  # first time they change something, not at login. Made BEFORE the write, or
  # the temporary file has nowhere to go either.
  mkdir -p "$(dirname "$CONF")"
  {
    echo "# GENERATED by bin/null-idle -- do not edit by hand."
    echo "# The ordering dim < screensaver < lock < screenoff < suspend is an"
    echo "# INVARIANT (§8.5). Editing a stage here without dragging the later"
    echo "# ones is how a lock comes never to fire."
    echo
    for n in "${names[@]}"; do
      # stage_default reads the ARRAY, which set_stage has already updated.
      # current() reads the FILE, and reading the file here is the bug this
      # comment exists to stop coming back.
      local secs; secs=$(stage_default "$n")
      if [ "$n" = suspend ] && ! has_battery; then
        echo "# null-stage $n $secs   (omitted: no battery on this machine)"
        continue
      fi
      # OFF fires never: record the 0 so it survives a reload, and write NO
      # timeout line, so swayidle simply has one stage fewer. The marker stays a
      # bare number so it round-trips; the note on the next line is for a person
      # and the parser ignores it.
      if [ "$secs" -eq 0 ]; then
        echo "# null-stage $n 0"
        echo "#   (off -- this stage does not fire)"
        continue
      fi
      echo "# null-stage $n $secs"
      case $n in
        dim)         echo "timeout $secs 'brightnessctl -s set 10%' resume 'brightnessctl -r'" ;;
        screensaver) echo "timeout $secs '$ROOT/bin/null-screensaver' resume '$ROOT/bin/null-screensaver stop'" ;;
        # The lock stops the screensaver FIRST: a lock surface renders above
        # every layer surface and would otherwise leave it animating, unseen,
        # at full frame rate.
        lock)        echo "timeout $secs '$ROOT/bin/null-screensaver stop; $ROOT/bin/null-lock'" ;;
        screenoff)   echo "timeout $secs 'swaymsg \"output * dpms off\"' resume 'swaymsg \"output * dpms on\"'" ;;
        suspend)     echo "timeout $secs 'systemctl suspend'" ;;
      esac
    done
    echo
    echo "before-sleep '$ROOT/bin/null-screensaver stop; $ROOT/bin/null-lock'"
  } > "$CONF.tmp.$$"
  mv -f "$CONF.tmp.$$" "$CONF"
}

# Enforce the ladder: setting one stage drags every LATER stage up with it, and
# the tool says so rather than leaving the user to notice.
set_stage() {
  local target=$1 secs=$2
  load_stages
  local -a names=(); mapfile -t names < <(stage_names)
  local seen=0 prev=0 changed=()
  local -a newvals=()
  for n in "${names[@]}"; do
    local v; v=$(current "$n")
    if [ "$n" = "$target" ]; then v=$secs; seen=1; fi
    # OFF (0) means this stage does not fire. It LEAVES the ladder rather than
    # taking a place in it: it is not dragged forward, and it does not carry
    # `prev`, so the next stage that DOES fire is measured against the last one
    # that fires, not against a stage that never will. Without this, asking for
    # off hit the `<= prev` rule below and came back as prev+30 -- the panel
    # offered "off" and the ladder quietly refused it.
    if [ "$v" -eq 0 ]; then
      newvals+=("$n:0")
      continue
    fi
    if [ "$v" -le "$prev" ]; then
      v=$(( prev + 30 ))
      changed+=("$n -> ${v}s")
    fi
    newvals+=("$n:$v")
    prev=$v
  done
  [ "$seen" = 1 ] || { echo "null-idle: no such stage '$target'" >&2; exit 1; }
  STAGES=("${newvals[@]}")
  write_conf
  # The value it ACTUALLY took, which is not always the value asked for: a
  # stage that would land before the one ahead of it is raised. Reporting the
  # request rather than the result said "set lock to 120s" about a lock that
  # was then 270s, which is the panel lying about the thing it just did.
  local final; final=$(printf '%s\n' "${newvals[@]}" | sed -n "s/^$target://p")
  if [ "$final" = 0 ]; then
    echo "set $target off"
  elif [ "$final" = "$secs" ]; then
    echo "set $target to ${secs}s"
  else
    echo "set $target to ${final}s (asked for ${secs}s; the ladder allows no earlier)"
  fi
  if [ ${#changed[@]} -gt 0 ]; then
    # These may include the target itself, raised, as well as the stages after
    # it -- "later stages" named only half of what this list can contain.
    echo "adjusted to keep the ladder in order:"
    printf '  %s\n' "${changed[@]}"
  fi
}

case "${1:-show}" in
  show)
    printf '%-13s %8s\n' STAGE SECONDS
    while read -r n; do
      if [ "$n" = suspend ] && ! has_battery; then
        printf '  %-11s %8s   (not drawn: no battery)\n' "$n" "$NULL_UNMEASURED_LOCAL"
      else
        printf '  %-11s %8s\n' "$n" "$(current "$n")"
      fi
    done < <(stage_names)
    ;;
  set)   set_stage "${2:?stage}" "${3:?seconds}" ;;

  # WHAT THE COMPOSITOR CALLS. Not `swayidle` directly, because the answer to
  # "should the ladder run" belongs to this tool and to the person, not to a
  # line in a file that ships to everybody.
  start)
    if [ -e "$IDLE_OFF" ]; then
      echo "the idle ladder is off ($IDLE_OFF); null-idle toggle turns it on"
      exit 0
    fi
    load_stages; write_conf
    . "$ROOT/lib/once.sh" 2>/dev/null && null_only_one 'swayidle -w -C'
    setsid swayidle -w -C "$CONF" >/dev/null 2>&1 &
    echo "the idle ladder is on" ;;
  apply) load_stages; write_conf; echo "wrote $CONF"
         pkill -x -u "$(id -u)" swayidle 2>/dev/null || true
         # setsid, LIKE start AND toggle. Without it the new swayidle stays in
         # the caller's session -- and the caller is the settings panel hosted
         # in the column, whose PTY is the controlling terminal. When the panel
         # closes, the kernel hangs up the foreground group and swayidle dies:
         # changing ANY idle timing from the panel left the machine with no dim,
         # no lock and no suspend until the next login. Measured on the daily
         # driver: idle.conf freshly written by the panel, no swayidle running.
         #
         # AND RESPECT "OFF". apply is run after every `set`, so a timing change
         # while the ladder is deliberately off must not silently switch it on.
         if [ -e "$IDLE_OFF" ]; then
           echo "the idle ladder is off ($IDLE_OFF); timings saved, not started"
         else
           setsid swayidle -w -C "$CONF" >/dev/null 2>&1 &
           echo "swayidle restarted"
         fi ;;
  state)
    # Read from the process, not from a flag. A remembered flag and a dead
    # daemon disagree the moment anything restarts.
    if pgrep -x -u "$(id -u)" swayidle >/dev/null 2>&1; then echo on
    elif [ -e "$IDLE_OFF" ]; then echo "off (remembered)"
    else echo off; fi
    ;;
  toggle)
    # Stopping the daemon suspends the WHOLE ladder -- dim, screensaver, lock,
    # screen off and suspend -- which is what "stop locking me out" means. The
    # configuration is untouched, so turning it back on restores every stage.
    if pgrep -x -u "$(id -u)" swayidle >/dev/null 2>&1; then
      for p in $(pgrep -x -u "$(id -u)" swayidle); do kill "$p"; done 2>/dev/null || true
      # REMEMBERED, so a reload or a login does not undo it.
      mkdir -p "$(dirname "$IDLE_OFF")"; : > "$IDLE_OFF"
      echo "idle ladder off, and it stays off (configuration untouched)"
    else
      rm -f "$IDLE_OFF"
      load_stages; write_conf
      setsid swayidle -w -C "$CONF" >/dev/null 2>&1 &
      echo "idle ladder on"
    fi
    ;;
  check)
    # The invariant, checkable (§10.4).
    #
    # Written with plain `if`, not `a && b && c`: under `set -e` a false
    # condition at the end of a loop body takes the whole loop down, and the
    # `a && b || c` form runs c when b merely returns non-zero. Both are how a
    # check comes to report nothing and look like it passed.
    prev=0; bad=0
    while read -r n; do
      if [ "$n" = suspend ]; then
        if ! has_battery; then continue; fi
      fi
      v=$(current "$n")
      # An off stage (0) is not in the ladder: neither out of order, nor a rung
      # the next stage has to clear.
      if [ "$v" -eq 0 ]; then continue; fi
      if [ "$v" -le "$prev" ]; then
        echo "OUT OF ORDER: $n at ${v}s is not after the previous stage at ${prev}s"
        bad=1
      fi
      prev=$v
    done < <(stage_names)
    if [ "$bad" -eq 0 ]; then
      echo "PASS: the ladder is in order"
    else
      exit 1
    fi
    ;;
  *) echo "usage: null-idle [show|set STAGE SECONDS|apply|check]" >&2; exit 2 ;;
esac
