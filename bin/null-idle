#!/usr/bin/env bash
# The idle ladder (NULL.md §8.5).
#
#     dim  ->  screensaver  ->  lock  ->  screen off  ->  suspend
#
# THE ORDERING IS AN INVARIANT AND NOTHING ENFORCES IT FOR YOU. Set the lock
# later than the screen-off and the lock never observably fires: the display
# went dark first and you return to an unlocked machine. So this tool -- the
# only thing that edits the ladder -- drags the later stages with it and SAYS
# that it did.
#
# Stages are identified by WHAT THEY DO, not by their timeout or their
# configuration key: every stage has the same key and only the numbers change.
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
CONF="$ROOT/config/sway/idle.conf"
NULL_UNMEASURED_LOCAL="--"

# name:default-seconds, in ladder order. The order in this list IS the
# invariant; everything below derives from it.
STAGES=(dim:150 screensaver:240 lock:300 screenoff:330 suspend:1800)

# Both end with an explicit `return 0`.
#
# A shell function returns the status of its LAST command, so a loop whose
# final iteration ends in a failed test returns 1 -- and under `set -e` a
# command substitution assigning from it takes the whole script down. That is
# how the first version of this tool came to print nothing at all and look as
# though it had passed.
stage_names() {
  local s
  for s in "${STAGES[@]}"; do echo "${s%%:*}"; done
  return 0
}
stage_default() {
  local s
  for s in "${STAGES[@]}"; do
    if [ "${s%%:*}" = "$1" ]; then echo "${s##*:}"; fi
  done
  return 0
}

current() {  # stage -> seconds
  local n=$1 v=""
  if [ -r "$CONF" ]; then
    v=$(sed -n "s/^# null-stage $n \([0-9]*\)$/\1/p" "$CONF" | head -1)
  fi
  if [ -n "$v" ]; then echo "$v"; else stage_default "$n"; fi
  return 0
}

# On a machine with no battery the ladder does not end in suspend (§8.5).
# Discovered at runtime, never declared.
has_battery() { "$ROOT/bin/machine" probe battery 2>/dev/null; }

write_conf() {
  local -a names=(); mapfile -t names < <(stage_names)
  {
    echo "# GENERATED by bin/null-idle -- do not edit by hand."
    echo "# The ordering dim < screensaver < lock < screenoff < suspend is an"
    echo "# INVARIANT (§8.5). Editing a stage here without dragging the later"
    echo "# ones is how a lock comes never to fire."
    echo
    for n in "${names[@]}"; do
      local secs; secs=$(current "$n")
      if [ "$n" = suspend ] && ! has_battery; then
        echo "# null-stage $n $secs   (omitted: no battery on this machine)"
        continue
      fi
      echo "# null-stage $n $secs"
      case $n in
        dim)         echo "timeout $secs 'brightnessctl -s set 10%' resume 'brightnessctl -r'" ;;
        screensaver) echo "timeout $secs '$ROOT/bin/null-screensaver' resume '$ROOT/bin/null-screensaver stop'" ;;
        # The lock stops the screensaver FIRST: a lock surface renders above
        # every layer surface and would otherwise leave it animating, unseen,
        # at full frame rate.
        lock)        echo "timeout $secs '$ROOT/bin/null-screensaver stop; $ROOT/bin/null-lock'" ;;
        screenoff)   echo "timeout $secs 'swaymsg \"output * dpms off\"' resume 'swaymsg \"output * dpms on\"'" ;;
        suspend)     echo "timeout $secs 'systemctl suspend'" ;;
      esac
    done
    echo
    echo "before-sleep '$ROOT/bin/null-screensaver stop; $ROOT/bin/null-lock'"
  } > "$CONF"
}

# Enforce the ladder: setting one stage drags every LATER stage up with it, and
# the tool says so rather than leaving the user to notice.
set_stage() {
  local target=$1 secs=$2
  local -a names=(); mapfile -t names < <(stage_names)
  local seen=0 prev=0 changed=()
  local -a newvals=()
  for n in "${names[@]}"; do
    local v; v=$(current "$n")
    if [ "$n" = "$target" ]; then v=$secs; seen=1; fi
    if [ "$v" -le "$prev" ]; then
      v=$(( prev + 30 ))
      changed+=("$n -> ${v}s")
    fi
    newvals+=("$n:$v")
    prev=$v
  done
  [ "$seen" = 1 ] || { echo "null-idle: no such stage '$target'" >&2; exit 1; }
  STAGES=("${newvals[@]}")
  write_conf
  # The value it ACTUALLY took, which is not always the value asked for: a
  # stage that would land before the one ahead of it is raised. Reporting the
  # request rather than the result said "set lock to 120s" about a lock that
  # was then 270s, which is the panel lying about the thing it just did.
  local final; final=$(printf '%s\n' "${newvals[@]}" | sed -n "s/^$target://p")
  if [ "$final" = "$secs" ]; then
    echo "set $target to ${secs}s"
  else
    echo "set $target to ${final}s (asked for ${secs}s; the ladder allows no earlier)"
  fi
  if [ ${#changed[@]} -gt 0 ]; then
    # These may include the target itself, raised, as well as the stages after
    # it -- "later stages" named only half of what this list can contain.
    echo "adjusted to keep the ladder in order:"
    printf '  %s\n' "${changed[@]}"
  fi
}

case "${1:-show}" in
  show)
    printf '%-13s %8s\n' STAGE SECONDS
    while read -r n; do
      if [ "$n" = suspend ] && ! has_battery; then
        printf '  %-11s %8s   (not drawn: no battery)\n' "$n" "$NULL_UNMEASURED_LOCAL"
      else
        printf '  %-11s %8s\n' "$n" "$(current "$n")"
      fi
    done < <(stage_names)
    ;;
  set)   set_stage "${2:?stage}" "${3:?seconds}" ;;
  apply) write_conf; echo "wrote $CONF"
         pkill -x swayidle 2>/dev/null || true
         (swayidle -w -C "$CONF" >/dev/null 2>&1 &) ; echo "swayidle restarted" ;;
  state)
    # Read from the process, not from a flag. A remembered flag and a dead
    # daemon disagree the moment anything restarts.
    if pgrep -x swayidle >/dev/null 2>&1; then echo on; else echo off; fi
    ;;
  toggle)
    # Stopping the daemon suspends the WHOLE ladder -- dim, screensaver, lock,
    # screen off and suspend -- which is what "stop locking me out" means. The
    # configuration is untouched, so turning it back on restores every stage.
    if pgrep -x swayidle >/dev/null 2>&1; then
      for p in $(pgrep -x swayidle); do kill "$p"; done 2>/dev/null || true
      echo "idle ladder off (configuration untouched)"
    else
      setsid swayidle -w -C "$CONF" >/dev/null 2>&1 &
      echo "idle ladder on"
    fi
    ;;
  check)
    # The invariant, checkable (§10.4).
    #
    # Written with plain `if`, not `a && b && c`: under `set -e` a false
    # condition at the end of a loop body takes the whole loop down, and the
    # `a && b || c` form runs c when b merely returns non-zero. Both are how a
    # check comes to report nothing and look like it passed.
    prev=0; bad=0
    while read -r n; do
      if [ "$n" = suspend ]; then
        if ! has_battery; then continue; fi
      fi
      v=$(current "$n")
      if [ "$v" -le "$prev" ]; then
        echo "OUT OF ORDER: $n at ${v}s is not after the previous stage at ${prev}s"
        bad=1
      fi
      prev=$v
    done < <(stage_names)
    if [ "$bad" -eq 0 ]; then
      echo "PASS: the ladder is in order"
    else
      exit 1
    fi
    ;;
  *) echo "usage: null-idle [show|set STAGE SECONDS|apply|check]" >&2; exit 2 ;;
esac
