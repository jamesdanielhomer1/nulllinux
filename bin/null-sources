#!/usr/bin/env bash
# Check exact package/source inventory and one retrieval from a built ISO.
# These checks provide availability evidence, not distribution approval.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
check_manifest() {
  local manifest=$1 fail=0 pkgs sample nvr temporary
  [ -r "$manifest" ] || { echo "  source inventory MISSING" >&2; return 1; }
  if grep -q "WRITTEN OFFER" "$manifest"; then
    echo "  legacy written-offer text present; approval and fulfillment are not verified"
  else
    echo "  source inventory only; distribution arrangements require separate review"
  fi
  pkgs=$(awk -F '\t' '$1 ~ /^[a-zA-Z0-9].*\.(x86_64|noarch|i686)$/ {n++} END {print n+0}' "$manifest")
  echo "  packages listed $pkgs"
  [ "$pkgs" -gt 100 ] || { echo "  suspiciously few package rows" >&2; fail=1; }
  if ! awk -F '\t' '
    $1 ~ /^[a-zA-Z0-9].*\.(x86_64|noarch|i686)$/ {
      if (NF != 3 || $3 !~ /^[a-zA-Z0-9._+-]+-[0-9][^[:space:]]*\.src\.rpm$/) bad++
    }
    END {exit bad ? 1 : 0}' "$manifest"; then
    echo "  package row lacks an exact source package name" >&2
    fail=1
  fi
  sample=$(awk -F '\t' '
    $1 ~ /^[a-zA-Z0-9].*\.(x86_64|noarch|i686)$/ && $3 ~ /\.src\.rpm$/ {
      if (!first) first=$3
      if ($2 ~ /GPL/) {print $3; found=1; exit}
    }
    END {if (!found) print first}' "$manifest")
  if [ -n "$sample" ]; then
    nvr=${sample%.src.rpm}
    echo "  fetching exact source $sample"
    temporary=$(mktemp -d) || return 1
    if "$ROOT/bin/pkg" fetch-source "$nvr" "$temporary" && [ -s "$temporary/$sample" ]; then
      echo "  sample source retrieval passed: $sample"
    else
      echo "  exact source retrieval failed for $sample" >&2
      fail=1
    fi
    rm -rf -- "$temporary"
  else
    echo "  no source package available for a retrieval check" >&2
    fail=1
  fi
  if [ "$fail" -eq 0 ]; then
    echo "Inventory structure and one exact source retrieval passed."
    echo "This does not verify every package or approve public distribution."
  else
    echo "Source inventory/retrieval checks failed." >&2
  fi
  return "$fail"
}

ISO=${1:-}
[ -n "$ISO" ] || ISO=$(find /var/lib/nulllinux-iso -name '*.iso' 2>/dev/null | head -1)
[ -r "$ISO" ] || { echo "usage: null-sources <image.iso>" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo "null-sources: must be root -- this mounts the image" >&2; exit 1; }

MNT=$(mktemp -d) ; SQ=$(mktemp -d)
cleanup() {
  umount "$SQ" 2>/dev/null; umount "$MNT" 2>/dev/null
  rmdir "$SQ" "$MNT" 2>/dev/null
}
trap cleanup EXIT

echo "checking $ISO"
mount -o loop,ro "$ISO" "$MNT" 2>/dev/null || { echo "  cannot mount the image" >&2; exit 1; }

# The rootfs lives in a squashfs inside the image; the manifest is inside that.
sqfs=$(find "$MNT" -name 'squashfs.img' -o -name '*.squashfs' 2>/dev/null | head -1)
[ -n "$sqfs" ] || { echo "  no squashfs on the image" >&2; exit 1; }
mount -o loop,ro "$sqfs" "$SQ" 2>/dev/null || { echo "  cannot mount $sqfs" >&2; exit 1; }

# One more layer on a live image: squashfs holds a rootfs image.
root="$SQ"
inner=$(find "$SQ" -maxdepth 2 -name 'rootfs.img' -o -maxdepth 2 -name 'ext3fs.img' 2>/dev/null | head -1)
if [ -n "$inner" ]; then
  R=$(mktemp -d)
  if mount -o loop,ro "$inner" "$R" 2>/dev/null; then
    root="$R"; trap 'umount "$R" 2>/dev/null; rmdir "$R" 2>/dev/null; cleanup' EXIT
  fi
fi

check_manifest "$root/usr/share/nulllinux/SOURCES.txt"
