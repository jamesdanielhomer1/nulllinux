#!/usr/bin/env bash
# Verify the GPL source offer on a built ISO (NULL.md §0.5, docs/LICENSING.md).
#
# DISTRIBUTING GPL BINARIES IS AN OBLIGATION, NOT A FORMALITY. GPLv2 section 3
# and GPLv3 section 6 require the corresponding source to be available, and a
# note saying "it is on the internet" does not discharge it: the source must be
# for THIS build, and someone must actually be able to get it.
#
# So this checks three things that a written offer alone cannot:
#
#   1. the manifest is ON the image, generated by the image's own rpm database
#      rather than assembled beside it, so it cannot have drifted;
#   2. it records exact versions and source package names, because
#      "corresponding source" means the source for this build;
#   3. a source package named in it can ACTUALLY BE FETCHED right now.
#
# The third is the one that turns a claim into a check.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
ISO=${1:-}
[ -n "$ISO" ] || ISO=$(find /var/lib/nulllinux-iso -name '*.iso' 2>/dev/null | head -1)
[ -r "$ISO" ] || { echo "usage: null-sources <image.iso>" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo "null-sources: must be root -- this mounts the image" >&2; exit 1; }

MNT=$(mktemp -d) ; SQ=$(mktemp -d)
cleanup() {
  umount "$SQ" 2>/dev/null; umount "$MNT" 2>/dev/null
  rmdir "$SQ" "$MNT" 2>/dev/null
}
trap cleanup EXIT

echo "checking $ISO"
mount -o loop,ro "$ISO" "$MNT" 2>/dev/null || { echo "  cannot mount the image" >&2; exit 1; }

# The rootfs lives in a squashfs inside the image; the manifest is inside that.
sqfs=$(find "$MNT" -name 'squashfs.img' -o -name '*.squashfs' 2>/dev/null | head -1)
[ -n "$sqfs" ] || { echo "  no squashfs on the image" >&2; exit 1; }
mount -o loop,ro "$sqfs" "$SQ" 2>/dev/null || { echo "  cannot mount $sqfs" >&2; exit 1; }

# One more layer on a live image: squashfs holds a rootfs image.
root="$SQ"
inner=$(find "$SQ" -maxdepth 2 -name 'rootfs.img' -o -maxdepth 2 -name 'ext3fs.img' 2>/dev/null | head -1)
if [ -n "$inner" ]; then
  R=$(mktemp -d)
  if mount -o loop,ro "$inner" "$R" 2>/dev/null; then
    root="$R"; trap 'umount "$R" 2>/dev/null; rmdir "$R" 2>/dev/null; cleanup' EXIT
  fi
fi

MAN="$root/usr/share/nulllinux/SOURCES.txt"
fail=0
if [ -r "$MAN" ]; then
  echo "  manifest        present ($(wc -l < "$MAN") lines)"
else
  echo "  manifest        MISSING -- the image carries no source offer"; exit 1
fi

grep -q "WRITTEN OFFER" "$MAN" && echo "  written offer   present" \
  || { echo "  written offer   MISSING"; fail=1; }

pkgs=$(grep -cE '^[a-zA-Z0-9].*\.(x86_64|noarch|i686)\s' "$MAN" || true)
echo "  packages listed $pkgs"
[ "${pkgs:-0}" -gt 100 ] || { echo "                  suspiciously few -- is the manifest complete?"; fail=1; }

copyleft=$(grep -icE 'GPL|MPL|EPL|CDDL' "$MAN" || true)
echo "  copyleft rows   $copyleft"

# THE CHECK THAT MATTERS: take a GPL package the image actually ships and try
# to fetch its source. An offer that cannot be fulfilled is not an offer.
sample=$(grep -E 'GPL' "$MAN" | grep -oE '^[a-zA-Z0-9._+-]+-[0-9][^[:space:]]*\.(x86_64|noarch)' | head -1)
if [ -n "$sample" ]; then
  nvr=${sample%.*}
  echo "  fetching source for $nvr ..."
  tmp=$(mktemp -d)
  if dnf download --source --destdir "$tmp" "$nvr" >/dev/null 2>&1 \
     && ls "$tmp"/*.src.rpm >/dev/null 2>&1; then
    echo "                  OK -- $(ls "$tmp"/*.src.rpm | xargs -n1 basename) ($(du -h "$tmp"/*.src.rpm | cut -f1))"
  else
    echo "                  COULD NOT FETCH -- the offer cannot be fulfilled for this package"
    echo "                  (it may predate the current repositories; koji keeps older builds)"
    fail=1
  fi
  rm -rf "$tmp"
fi

echo
[ "$fail" -eq 0 ] && echo "the source offer on this image is complete and fulfillable" \
                  || echo "the source offer has PROBLEMS -- see above" >&2
exit $fail
