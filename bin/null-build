#!/usr/bin/env bash
# Build every derived asset, in dependency order (NULL.md §5, §11).
#
# THIS IS THE PIECE THAT NEVER EXISTED. There were twenty bake scripts and no
# statement anywhere of what order they run in -- the order lived in whoever
# had run them last. A distribution cannot be installed by recalling that.
#
# Each stage declares its inputs and outputs. A stage whose content receipt
# matches every input and output is skipped and says so, which makes this
# safe to re-run and cheap to resume: the expensive one is the hero, and
# nobody should pay for it twice by accident.
#
# It does NOT install anything and does not touch a running system. That is
# null-install's job, and keeping them apart is what lets this run on a build
# host that will never boot the result.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
cd "$ROOT"
FORCE=0; ONLY=""; SKIP_HERO=0
for a in "$@"; do
  case $a in
    --force)      FORCE=1 ;;
    --skip-hero)  SKIP_HERO=1 ;;
    --only=*)     ONLY=${a#--only=} ;;
    -h|--help)
      cat <<'USAGE'
usage: null-build [--force] [--skip-hero] [--only=STAGE]

  Builds every derived asset in dependency order. Re-runnable: a stage whose
  declared inputs and outputs match its saved content receipt is skipped.

  --skip-hero   use the analytic placeholder instead of raytracing the Kerr
                hero. Minutes instead of hours, and the desktop is complete
                except that the wallpaper is the placeholder.
USAGE
      exit 0 ;;
    *) echo "null-build: unknown flag '$a'" >&2; exit 2 ;;
  esac
done

STRIKE_IFACE=$(bin/machine get interface_strike) || exit 1
STRIKE_BAKE=$(bin/machine get bake_strike)       || exit 1

# A strike's file, from its name. ter-u* are the OTB bitmaps fontconfig sees;
# ter-1* are the PSF2 console fonts. Which one a strike is, is visible in its
# name, so it is read rather than configured.
# A strike has TWO NAMES and they are not interchangeable.
#
# `ter-u18n` is what fontconfig calls it, and is what the terminal and the GTK
# theme ask for. `ter-118n` is the same strike as a PSF2 console font, and is
# the only form the atlas and ramp bakers can read -- they parse PSF2 and
# nothing else. The profile stores the fontconfig name because that is the one
# other software needs; this converts it, which is a `u` for a `1`.
#
# Getting this wrong produces "not a PSF2 file (magic 00010000)", which is the
# atlas baker correctly refusing an OpenType bitmap.
strike_psf() {
  local n=$1
  case $n in
    ter-u*) n="ter-1${n#ter-u}" ;;
  esac
  echo "/usr/lib/kbd/consolefonts/$n.psf.gz"
}

fail=0
stage() {  # stage <name> <outputs...> -- <command...>
  local name=$1; shift
  local outs=() cmd=()
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do outs+=("$1"); shift; done
  shift || true
  cmd=("$@")
  if [ -n "$ONLY" ] && [ "$ONLY" != "$name" ]; then return 0; fi

  # Receipts cover source, data dependencies and every output member. Directory
  # mtimes and the first output's timestamp cannot certify a complete stage.
  local signature
  signature=$(python3 bake/build_state.py fingerprint "$name" "${outs[@]}" -- "${cmd[@]}") || {
    echo "  $name: cannot fingerprint inputs" >&2; fail=1; return 1;
  }
  if [ "$FORCE" -eq 0 ] && python3 bake/build_state.py fresh "$name" "$signature" \
      "${outs[@]}" -- "${cmd[@]}"; then
    printf '  %-22s up to date\n' "$name"
    return 0
  fi

  printf '  %-22s ' "$name"
  local log; log=$(mktemp)
  if "${cmd[@]}" >"$log" 2>&1 && python3 bake/build_state.py record "$name" "$signature" \
      "${outs[@]}" -- "${cmd[@]}" >>"$log" 2>&1; then
    printf 'ok\n'
  else
    printf 'FAILED\n'
    sed 's/^/      /' "$log" | tail -12
    fail=1
  fi
  rm -f "$log"
}

echo "null-build: $STRIKE_IFACE (interface) + $STRIKE_BAKE (bake)"
echo

echo "colour and glyphs"
stage palette   assets/palette.bin assets/palette.json -- \
  python3 bake/derive_palette.py
stage ramp-iface assets/ramp-interface.json -- \
  python3 bake/derive_ramp.py --font "$(strike_psf "$STRIKE_IFACE")" --out assets/ramp-interface.json
stage ramp-bake  assets/ramp-bake.json -- \
  python3 bake/derive_ramp.py --font "$(strike_psf "$STRIKE_BAKE")" --out assets/ramp-bake.json
stage atlas-iface assets/atlas-interface.bin -- \
  python3 bake/bake_atlas.py --font "$(strike_psf "$STRIKE_IFACE")" --out assets/atlas-interface.bin
stage atlas-bake  assets/atlas-bake.bin -- \
  python3 bake/bake_atlas.py --font "$(strike_psf "$STRIKE_BAKE")" --out assets/atlas-bake.bin
stage theme config/sway/colours.conf config/foot/foot.ini config/shell/colours.sh \
  config/vconsole/vtrgb config/nano/nanorc config/gtk-3.0/gtk.css \
  config/gtk-3.0/settings.ini config/gtk-4.0/gtk.css config/gtk-4.0/settings.ini -- \
  python3 bake/export_theme.py

echo
echo "the hero"

# PREBUILT ASSETS ARE PREFERRED, AND THAT IS NOT AN OPTIMISATION.
#
# Tracing is 0.39 s a frame on a discrete GPU and 28.27 s on software Vulkan --
# two minutes against two hours. On a machine with no real Vulkan device, which
# is most virtual machines and every headless install, baking is not slow, it
# is impractical. So a set shipped in the package is used when one matches.
#
# MATCHING MEANS THE BAKE STRIKE. The quantiser measures ink against the
# strike's own ramp, so a quantised hero belongs to one strike; a set built for
# 6x12 is simply wrong on a machine that chose 8x16. The strike is read from
# this machine's profile, so the match is exact or there is no match.
PREBUILT="assets/prebuilt/$STRIKE_BAKE"
if [ "$SKIP_HERO" -eq 0 ] && [ "$FORCE" -eq 0 ] && [ -d "$PREBUILT" ]; then
  printf '  %-22s ' prebuilt
  copied=0
  for f in master.cells target-2.cells target-4.cells tty.cells logo.cells ramp-bake.json; do
    [ -e "$PREBUILT/$f" ] && cp -a "$PREBUILT/$f" "assets/$f" && copied=$((copied+1))
  done
  if [ "$copied" -eq 6 ]; then
    printf 'ok  (%s files for %s -- the raytrace is not run)\n' "$copied" "$STRIKE_BAKE"
    SKIP_HERO=2      # 2 means "already have one", distinct from "asked to skip"
  else
    printf 'INCOMPLETE (%s of 6 files) -- baking instead\n' "$copied"
  fi
elif [ "$SKIP_HERO" -eq 0 ] && [ "$FORCE" -eq 0 ]; then
  echo "  (no prebuilt hero for $STRIKE_BAKE -- this machine bakes its own)"
fi

if [ "$SKIP_HERO" -eq 2 ]; then
  :   # the hero is in place; nothing below it needs to run
elif [ "$SKIP_HERO" -eq 1 ]; then
  build_placeholder() {
    python3 bake/placeholder.py --out assets/placeholder.hdrcells &&
    python3 bake/quantise.py --frames-dir assets/placeholder.hdrcells \
      --out assets/placeholder.cells
  }
  stage placeholder assets/placeholder.cells -- build_placeholder
  echo "  (hero skipped: the placeholder stands in for it)"
else
  # The GPU tracer is a Rust crate of its own and nothing else builds it. The
  # bake shells out to it, so a tree that has never built it fails at the most
  # expensive possible moment -- after the packages, the profile and the atlas.
  stage kerr-gpu bake/gpu/target/release/kerr-gpu -- \
    cargo build --locked --release --manifest-path bake/gpu/Cargo.toml
  stage hero assets/master.hdrcells -- python3 bake/bake.py --out assets/master.hdrcells

  # THE TONE CURVE IS SWEPT, NOT REMEMBERED.
  #
  # Appendix A lists the black point, the white point and the gamma as
  # "re-tuned per emission model" rather than as settled constants, so they
  # cannot be written down here: change the disk's emission and last run's
  # numbers are a curve fitted to a different picture.
  #
  # tune.py prints its recommendations best-first, each one already in the form
  # of the arguments the next two stages take, so the top line IS the answer
  # and is used as such rather than transcribed.
  if [ -z "$ONLY" ] || [ "$ONLY" = tone ]; then
    printf '  %-22s ' tone
    if TONE=$(python3 bake/tune.py --frames-dir assets/master.hdrcells 2>/dev/null \
              | grep -oE -- '--black-pct [0-9.]+ --white-pct [0-9.]+ --gamma [0-9.]+' | head -1) \
       && [ -n "$TONE" ]; then
      printf 'ok  (%s)\n' "$TONE"
    else
      printf 'FAILED -- no tone curve, so nothing below it can run\n'; fail=1; TONE=""
    fi
  fi

  if [ -n "${TONE:-}" ]; then
    stage quantise assets/master.cells -- \
      python3 bake/quantise.py --frames-dir assets/master.hdrcells --out assets/master.cells $TONE
    stage targets assets/target-2.cells assets/target-4.cells assets/tty.cells assets/logo.cells -- \
      python3 bake/derive_targets.py --master assets/master.hdrcells $TONE
  fi
fi

echo
echo "the renderer"
stage render render/target/release/render render/target/release/column -- \
  cargo build --locked --release --manifest-path render/Cargo.toml

echo
echo "surfaces derived from the above"
stage icons  assets/icons -- python3 bake/make_icons.py --out assets/icons
# The boot surfaces are RASTERISED FROM THE HERO'S TARGETS, so they cannot be
# built without one. This is not a missing feature of --skip-hero; it is what
# --skip-hero means, and saying so is better than a stack trace about a
# missing .cells file.
if [ "$SKIP_HERO" -eq 1 ]; then
  printf '  %-22s skipped: it rasterises the hero, and the hero was skipped\n' boot
else
  # SKIP_HERO=2 means a prebuilt hero was copied in, so the targets exist and
  # the boot surfaces can be rasterised from them exactly as after a bake.
  stage boot system/plymouth-theme system/sddm-theme -- python3 bake/make_boot_assets.py
fi

echo
if [ "$fail" -eq 0 ]; then echo "null-build: every stage succeeded"; else
  echo "null-build: STAGES FAILED -- the tree is not installable" >&2; fi
exit $fail
