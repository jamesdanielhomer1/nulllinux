#!/usr/bin/env bash
# Keyboard and pointer (NULL.md §8.4, §9.5).
#
# THE SOLE WRITER of config/sway/input.conf. Two tools editing one generated
# file is how one of them silently loses the other's setting, so keyboard and
# pointer live together here rather than in two tools that both know the
# format.
#
# The file IS the state. Nothing is remembered anywhere else, so nothing can
# drift from what sway actually reads.
#
# THE LAYOUT IS THREE SETTINGS, NOT ONE. The console reads KEYMAP from
# /etc/vconsole.conf, the greeter reads localectl's X11 layout, and the session
# reads the compositor's own input block. They are set separately and nothing
# makes them agree; a machine can be gb at the console and us in the session,
# and nothing complains until a password with a symbol in it stops working.
# Setting the layout here sets all three (§9.5).
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
CONF="$ROOT/config/sway/input.conf"
XKB_LST=/usr/share/X11/xkb/rules/evdev.lst

# Defaults are sway's own, so an unset value here means "as shipped".
DEF_LAYOUT=gb DEF_DELAY=600 DEF_RATE=25 DEF_TAP=enabled DEF_NATURAL=disabled DEF_SPEED=0

get() {  # key -> value, from the marker comments this file writes
  local v=""
  [ -r "$CONF" ] && v=$(sed -n "s/^# null-input $1 \(.*\)$/\1/p" "$CONF" | head -1)
  if [ -n "$v" ]; then echo "$v"; else
    case $1 in
      layout)  echo "$DEF_LAYOUT" ;;  delay) echo "$DEF_DELAY" ;;
      rate)    echo "$DEF_RATE" ;;    tap)   echo "$DEF_TAP" ;;
      natural) echo "$DEF_NATURAL" ;; speed) echo "$DEF_SPEED" ;;
    esac
  fi
  return 0
}

# The xkb description for a layout code -- "gb" is "English (UK)". Read from
# xkb's own table rather than written down here, because a list of ninety-nine
# layouts copied into a script is ninety-nine chances to be wrong.
layout_name() {
  awk -v want="$1" '/^! layout/{f=1;next} /^!/{f=0}
                    f && $1==want {$1=""; sub(/^ +/,""); print; exit}' "$XKB_LST" 2>/dev/null
}
layouts() {
  awk '/^! layout/{f=1;next} /^!/{f=0} f && NF {code=$1; $1="";
       sub(/^ +/,""); printf "%-8s %s\n", code, $0}' "$XKB_LST" 2>/dev/null | sort -u
}

write_conf() {
  local layout delay rate tap natural speed
  layout=$(get layout); delay=$(get delay); rate=$(get rate)
  tap=$(get tap); natural=$(get natural); speed=$(get speed)
  cat > "$CONF" <<CONF
# GENERATED by bin/null-input -- do not edit by hand.
#
# The layout here is ONE OF THREE places it is set. The console reads
# /etc/vconsole.conf and the greeter reads localectl; null-input sets all
# three together and verify/check-keyboard.sh asserts they still agree.

# null-input layout $layout
# null-input delay $delay
# null-input rate $rate
input type:keyboard {
    xkb_layout $layout
    repeat_delay $delay
    repeat_rate $rate
}

# null-input tap $tap
# null-input natural $natural
# null-input speed $speed
input type:touchpad {
    tap $tap
    natural_scroll $natural
    pointer_accel $speed
}

input type:pointer {
    natural_scroll $natural
    pointer_accel $speed
}
CONF
}

set_key() {  # key value -- rewrite the file with one value changed
  local k=$1 v=$2 layout delay rate tap natural speed
  layout=$(get layout); delay=$(get delay); rate=$(get rate)
  tap=$(get tap); natural=$(get natural); speed=$(get speed)
  case $k in
    layout) layout=$v ;; delay) delay=$v ;; rate) rate=$v ;;
    tap) tap=$v ;; natural) natural=$v ;; speed) speed=$v ;;
  esac
  cat > "$CONF" <<CONF
# GENERATED by bin/null-input -- do not edit by hand.
#
# The layout here is ONE OF THREE places it is set. The console reads
# /etc/vconsole.conf and the greeter reads localectl; null-input sets all
# three together and verify/check-keyboard.sh asserts they still agree.

# null-input layout $layout
# null-input delay $delay
# null-input rate $rate
input type:keyboard {
    xkb_layout $layout
    repeat_delay $delay
    repeat_rate $rate
}

# null-input tap $tap
# null-input natural $natural
# null-input speed $speed
input type:touchpad {
    tap $tap
    natural_scroll $natural
    pointer_accel $speed
}

input type:pointer {
    natural_scroll $natural
    pointer_accel $speed
}
CONF
}

apply() { swaymsg reload >/dev/null 2>&1 && echo "compositor reloaded" || echo "no compositor to reload"; }

set_layout() {
  local code=$1 name
  name=$(layout_name "$code")
  [ -n "$name" ] || { echo "null-input: no such layout '$code' (try: null-input layouts)" >&2; return 2; }
  set_key layout "$code"
  # The other two places, each reported, because a partial success here is the
  # exact condition that produces a machine that types differently depending on
  # which screen it is showing.
  if sed -i "s/^KEYMAP=.*/KEYMAP=\"$code\"/" /etc/vconsole.conf 2>/dev/null; then
    grep -q '^KEYMAP=' /etc/vconsole.conf || echo "KEYMAP=\"$code\"" >> /etc/vconsole.conf
    echo "console  /etc/vconsole.conf KEYMAP=$code"
  else
    echo "console  COULD NOT WRITE /etc/vconsole.conf (needs root)" >&2
  fi
  if localectl set-x11-keymap "$code" 2>/dev/null; then
    echo "greeter  localectl X11 layout=$code"
  else
    echo "greeter  COULD NOT SET localectl (needs root)" >&2
  fi
  echo "session  $CONF xkb_layout=$code"
  echo "layout is now $code -- $name"
  apply
}

case "${1:-show}" in
  show)
    printf '%-10s %s\n' layout "$(get layout)  $(layout_name "$(get layout)")"
    printf '%-10s %s\n' delay "$(get delay) ms"
    printf '%-10s %s\n' rate "$(get rate) /s"
    printf '%-10s %s\n' tap "$(get tap)"
    printf '%-10s %s\n' natural "$(get natural)"
    printf '%-10s %s\n' speed "$(get speed)"
    ;;
  get)      get "${2:?key}" ;;
  layouts)  layouts ;;
  name)     layout_name "${2:?code}" ;;
  layout)   set_layout "${2:?code}" ;;
  delay)    set_key delay "${2:?ms}"; apply ;;
  rate)     set_key rate "${2:?per second}"; apply ;;
  tap)      set_key tap "${2:?enabled|disabled}"; apply ;;
  natural)  set_key natural "${2:?enabled|disabled}"; apply ;;
  speed)    set_key speed "${2:?-1..1}"; apply ;;
  regenerate) write_conf; echo "wrote $CONF"; apply ;;
  -h|--help|help)
    cat <<'USAGE'
usage: null-input [show|get KEY|layouts|name CODE|layout CODE
                  |delay MS|rate PER_SECOND|tap enabled|disabled
                  |natural enabled|disabled|speed -1..1|regenerate]

  Sole writer of config/sway/input.conf. `layout` also sets the console
  keymap and the greeter's, which are separate settings that must agree.
USAGE
    ;;
  *) echo "null-input: unknown verb '$1'" >&2; exit 2 ;;
esac
