#!/usr/bin/env bash
# Keyboard and pointer (NULL.md §8.4, §9.5).
#
# THE SOLE WRITER of the per-user input file. Two tools editing one generated
# file is how one of them silently loses the other's setting, so keyboard and
# pointer live together here rather than in two tools that both know the format.
#
# A PERSON'S SETTINGS GO IN THEIR HOME, not in the checkout. This used to write
# $ROOT/config/sway/input.conf -- which an ordinary user cannot write (the
# install lives under /opt, owned by root), so changing the layout or the
# pointer speed from the settings panel simply failed for anyone but root, and
# for root it dirtied the tracked tree. It now writes
# ~/.config/nulllinux/input.conf, which sway includes AFTER the shipped baseline
# so it overrides -- exactly how the idle ladder was moved out of the checkout.
#
# The two files together ARE the state: the shipped one is the baseline every
# account gets, this one is a person's own changes. Nothing is remembered
# anywhere else, so nothing can drift from what sway actually reads.
#
# THE LAYOUT IS THREE SETTINGS, NOT ONE. The console reads KEYMAP from
# /etc/vconsole.conf, the greeter reads localectl's X11 layout, and the session
# reads the compositor's own input block. They are set separately and nothing
# makes them agree; a machine can be gb at the console and us in the session,
# and nothing complains until a password with a symbol in it stops working.
# Setting the layout here sets all three (§9.5).
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
# SHIP is the read-only baseline in the checkout; CONF is where a person's own
# changes go and is what this writes. sway includes SHIP then CONF.
SHIP="$ROOT/config/sway/input.conf"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nulllinux/input.conf"
XKB_LST=/usr/share/X11/xkb/rules/evdev.lst

# Defaults are sway's own, so an unset value here means "as shipped".
DEF_LAYOUT=gb DEF_DELAY=600 DEF_RATE=25 DEF_TAP=enabled DEF_NATURAL=disabled DEF_SPEED=0

get() {  # key -> value, from the marker comments these files write
  # The person's own file first, then the shipped baseline, then sway's default.
  local v=""
  [ -r "$CONF" ] && v=$(sed -n "s/^# null-input $1 \(.*\)$/\1/p" "$CONF" | head -1)
  [ -n "$v" ] || { [ -r "$SHIP" ] && v=$(sed -n "s/^# null-input $1 \(.*\)$/\1/p" "$SHIP" | head -1); }
  if [ -n "$v" ]; then echo "$v"; else
    case $1 in
      layout)  echo "$DEF_LAYOUT" ;;  delay) echo "$DEF_DELAY" ;;
      rate)    echo "$DEF_RATE" ;;    tap)   echo "$DEF_TAP" ;;
      natural) echo "$DEF_NATURAL" ;; speed) echo "$DEF_SPEED" ;;
    esac
  fi
  return 0
}

# The xkb description for a layout code -- "gb" is "English (UK)". Read from
# xkb's own table rather than written down here, because a list of ninety-nine
# layouts copied into a script is ninety-nine chances to be wrong.
layout_name() {
  awk -v want="$1" '/^! layout/{f=1;next} /^!/{f=0}
                    f && $1==want {$1=""; sub(/^ +/,""); print; exit}' "$XKB_LST" 2>/dev/null
}
layouts() {
  awk '/^! layout/{f=1;next} /^!/{f=0} f && NF {code=$1; $1="";
       sub(/^ +/,""); printf "%-8s %s\n", code, $0}' "$XKB_LST" 2>/dev/null | sort -u
}

valid_value() {
  case $1 in
    layout) [[ $2 =~ ^[a-zA-Z0-9_-]+$ ]] && [ -n "$(layout_name "$2")" ] ;;
    delay|rate) [[ $2 =~ ^[0-9]{1,5}$ ]] && (( 10#$2 <= 10000 )) ;;
    tap|natural) [[ $2 = enabled || $2 = disabled ]] ;;
    speed) [[ $2 =~ ^-?([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]] &&
           awk -v n="$2" 'BEGIN {exit !(n >= -1 && n <= 1)}' ;;
    *) return 1 ;;
  esac
}

write_conf() { set_key '' ''; }

set_key() {  # key value -- rewrite the file with one value changed
  local k=$1 v=$2 layout delay rate tap natural speed temp key
  [ ! -e "$CONF" ] || { [ -f "$CONF" ] && [ -r "$CONF" ]; } \
    || { echo "null-input: not a readable configuration file: $CONF" >&2; return 1; }
  if [ -n "$k" ] && ! valid_value "$k" "$v"; then
    echo "null-input: invalid $k value '$v'" >&2; return 2
  fi
  layout=$(get layout); delay=$(get delay); rate=$(get rate)
  tap=$(get tap); natural=$(get natural); speed=$(get speed)
  case $k in
    layout) layout=$v ;; delay) delay=$v ;; rate) rate=$v ;;
    tap) tap=$v ;; natural) natural=$v ;; speed) speed=$v ;;
  esac
  # Validate all persisted values as well, then replace the file atomically.
  for key in layout delay rate tap natural speed; do
    valid_value "$key" "${!key}" || { echo "null-input: invalid saved $key" >&2; return 2; }
  done
  mkdir -p "$(dirname "$CONF")" || return
  temp=$(mktemp "${CONF}.XXXXXX") || return
  if ! cat > "$temp" <<CONF
# GENERATED by bin/null-input -- do not edit by hand. Your own keyboard and
# pointer settings; sway includes this after the shipped baseline.
#
# The layout here is ONE OF THREE places it is set. The console reads
# /etc/vconsole.conf and the greeter reads localectl; null-input sets all
# three together and verify/check-keyboard.sh asserts they still agree.

# null-input layout $layout
# null-input delay $delay
# null-input rate $rate
input type:keyboard {
    xkb_layout $layout
    repeat_delay $delay
    repeat_rate $rate
}

# null-input tap $tap
# null-input natural $natural
# null-input speed $speed
input type:touchpad {
    tap $tap
    natural_scroll $natural
    pointer_accel $speed
}

input type:pointer {
    natural_scroll $natural
    pointer_accel $speed
}
CONF
  then rm -f -- "$temp"; return 1; fi
  if [ "${3:-publish}" = stage ]; then
    STAGED_CONF=$temp
  else
    mv -fT -- "$temp" "$CONF" || { rm -f -- "$temp"; return 1; }
  fi
}

apply() {
  if [ -z "${SWAYSOCK:-}" ]; then
    echo "saved for the next compositor session"
  elif swaymsg reload >/dev/null; then
    echo "compositor reloaded"
  else
    echo "null-input: saved, but compositor reload failed" >&2; return 1
  fi
}

set_layout() {
  local code=$1 name temp
  name=$(layout_name "$code")
  [ -n "$name" ] || { echo "null-input: no such layout '$code' (try: null-input layouts)" >&2; return 2; }
  # localed authorizes the system change and converts XKB to a console keymap.
  # XKB 'gb', for example, must not be blindly written as the console keymap.
  # Refusal is reported before changing the person's session settings.
  set_key layout "$code" stage || return
  temp=$STAGED_CONF
  localectl set-x11-keymap "$code" || {
    rm -f -- "$temp"
    echo "null-input: system keyboard change failed; session settings kept" >&2
    return 1
  }
  if ! mv -fT -- "$temp" "$CONF"; then
    rm -f -- "$temp"
    echo "null-input: system layout changed, but session settings could not be saved; retry after fixing $CONF" >&2
    return 1
  fi
  echo "layout is now $code -- $name (console keymap converted by localed)"
  apply
}

case "${1:-show}" in
  show)
    printf '%-10s %s\n' layout "$(get layout)  $(layout_name "$(get layout)")"
    printf '%-10s %s\n' delay "$(get delay) ms"
    printf '%-10s %s\n' rate "$(get rate) /s"
    printf '%-10s %s\n' tap "$(get tap)"
    printf '%-10s %s\n' natural "$(get natural)"
    printf '%-10s %s\n' speed "$(get speed)"
    ;;
  get)      get "${2:?key}" ;;
  layouts)  layouts ;;
  name)     layout_name "${2:?code}" ;;
  layout)   set_layout "${2:?code}" ;;
  delay)    set_key delay "${2:?ms}"; apply ;;
  rate)     set_key rate "${2:?per second}"; apply ;;
  tap)      set_key tap "${2:?enabled|disabled}"; apply ;;
  natural)  set_key natural "${2:?enabled|disabled}"; apply ;;
  speed)    set_key speed "${2:?-1..1}"; apply ;;
  regenerate) write_conf; echo "wrote $CONF"; apply ;;
  -h|--help|help)
    cat <<'USAGE'
usage: null-input [show|get KEY|layouts|name CODE|layout CODE
                  |delay MS|rate PER_SECOND|tap enabled|disabled
                  |natural enabled|disabled|speed -1..1|regenerate]

  Sole writer of ~/.config/nulllinux/input.conf (a person's own settings,
  which sway includes after the shipped baseline). `layout` also sets the
  console keymap and the greeter's, which are separate settings that must agree.
USAGE
    ;;
  *) echo "null-input: unknown verb '$1'" >&2; exit 2 ;;
esac
