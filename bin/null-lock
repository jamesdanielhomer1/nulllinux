#!/usr/bin/env bash
# Lock the screen, drawn like the greeter (NULL.md §8.5).
#
# TWO LOCKERS, ONE PREFERRED. The session-lock client (render/.../lock) draws the
# greeter's own hero and pass-panel through ext-session-lock-v1 and authenticates
# with PAM. swaylock is kept as the fallback: if the client is not built, the
# compositor lacks the protocol, or anything else goes wrong before the screen is
# locked, the screen must STILL lock -- an ugly lock beats an unlocked machine by
# a distance that does not need arguing.
#
# THE HANDSHAKE. The client prints "LOCKED" the instant the compositor has locked
# the session, then keeps running (drawing, taking the password) detached. This
# wrapper waits for that line and returns -- so `before-sleep` can lock and then
# let the machine suspend, exactly as swaylock's daemonize did. No line, or the
# client exits first, means it never locked, and we fall through to swaylock.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
CONF="$ROOT/config/swaylock/config"
LOCKBIN="$ROOT/render/target/release/lock"

case ${1:-} in
  -h|--help)
    echo "usage: null-lock [swaylock options]"
    echo
    echo "  Locks with the greeter-styled session-lock client if it is available,"
    echo "  else swaylock with $CONF. Options are passed to the swaylock fallback."
    exit 0 ;;
esac

# ALREADY LOCKED? Do nothing. A second lock would lose the race for the
# compositor's one-lock-at-a-time and then fall back and fight the first.
uid=$(id -u)
if pgrep -x -u "$uid" lock >/dev/null 2>&1 || pgrep -x -u "$uid" swaylock >/dev/null 2>&1; then
  exit 0
fi

# 1. The preferred locker, if it is built and no extra swaylock args were asked
#    for (those only make sense for the fallback).
if [ $# -eq 0 ] && [ -x "$LOCKBIN" ]; then
  # Detached in its own session so it survives this wrapper and swayidle; its
  # stdout is a pipe we read one line from to learn it has locked.
  exec 3< <(exec setsid env NULL_ROOT="$ROOT" "$LOCKBIN")
  if read -t 15 -r line <&3 && [ "$line" = LOCKED ]; then
    exec 3<&-        # stop reading; the locker keeps running
    exit 0
  fi
  exec 3<&- || true  # no LOCKED: it failed before locking -- fall through
  echo "null-lock: the session-lock client did not lock; falling back to swaylock" >&2
fi

# 2. Fallback: swaylock, in the palette, with the greeter's first frame.
command -v swaylock >/dev/null 2>&1 || {
  echo "null-lock: no session-lock client and no swaylock -- the screen CANNOT be locked" >&2
  exit 1
}
args=()
[ -r "$CONF" ] && args+=(-C "$CONF")
for img in /usr/share/sddm/themes/nullLinux/f00.png \
           "$ROOT/system/sddm-theme/f00.png"; do
  [ -r "$img" ] && { args+=(-i "$img" -s center); break; }
done
exec swaylock "${args[@]}" "$@"
