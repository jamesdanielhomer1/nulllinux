#!/usr/bin/env bash
# null-brand -- make the installed system say it is nullLinux.
#
# /etc/os-release is a SYMLINK into /usr/lib/os-release, which belongs to
# fedora-release-identity-basic.  Writing "> /etc/os-release" therefore writes
# straight through the link and corrupts an RPM-owned file: `rpm -V` fails, and
# the next fedora-release update silently reverts the branding.  systemd reads
# /etc/os-release first and only falls back to /usr/lib, so the supported way
# to do this is to REPLACE THE SYMLINK WITH A REAL FILE and leave /usr/lib
# exactly as the distribution shipped it.
#
# Trademark: a Fedora Remix may not present itself as Fedora.  So NAME is ours,
# the Fedora relationship is stated as a relationship, and no Fedora mark is
# used as if it were this project's own.
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}

# THE VERSION HAS ONE SOURCE, AND THIS TOOL IS NOT IT.
#
# This said VERSION=0.1.0, while bin/null-iso and bin/null-installer-iso read
# the version from packaging/nulllinux.spec. Two sources agree exactly until the
# first bump -- after which the medium is named nulllinux-0.2.0.iso and the
# system inside it says "nullLinux 0.1.0", and nothing notices, because each
# tool is consistent with itself. So the version is RESOLVED, in this order:
#
#   NULL_VERSION      the package's own %post passes %{version}, so an installed
#                     system is branded with the version that installed it --
#                     no lookup, and nothing to drift
#   installed package bin/pkg installed-version: the machine's real identity,
#                     for a later `null-brand apply` on an installed system,
#                     where the spec is not present (packaging/ does not ship)
#   the spec          a development checkout, where the package is not
#                     installed and the spec is the truth being built
#   last resort       so branding never fails outright. verify/check-branding.sh
#                     proves the chain above agrees with the spec, so the last
#                     resort is never silently what ships.
NAME=nulllinux
VERSION=""
VERSION_FROM=""
resolve_version() {
  local v nevra
  if [ -n "${NULL_VERSION:-}" ]; then
    VERSION=$NULL_VERSION; VERSION_FROM="NULL_VERSION"; return 0
  fi
  # installed-version prints the full NEVRA -- name-[epoch:]version-release.arch
  # -- and fails when the package is not installed.
  if nevra=$("$ROOT/bin/pkg" installed-version "$NAME" 2>/dev/null) \
     && [ "${nevra#"$NAME"-}" != "$nevra" ]; then
    v=${nevra#"$NAME"-}; v=${v#*:}; v=${v%%-*}
    if [ -n "$v" ]; then VERSION=$v; VERSION_FROM="installed package"; return 0; fi
  fi
  if [ -r "$ROOT/packaging/$NAME.spec" ] && command -v rpmspec >/dev/null 2>&1; then
    v=$(rpmspec -q --qf '%{version}\n' "$ROOT/packaging/$NAME.spec" 2>/dev/null | head -1)
    if [ -n "$v" ]; then VERSION=$v; VERSION_FROM="packaging/$NAME.spec"; return 0; fi
  fi
  VERSION=0.1.0; VERSION_FROM="last resort"
  return 0
}
resolve_version
URL=https://github.com/jamesdanielhomer1/nulllinux
SAVED=/usr/lib/os-release.fedora

die() { printf 'null-brand: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<USAGE
usage: null-brand [report|apply|revert]

  report   say what is set and what would change (default)
  apply    replace the /etc/os-release symlink with nullLinux branding
  revert   restore the distribution's own /etc/os-release
  version  print the version apply would brand with (report says where from)
USAGE
}

# The upstream release the remix is built from -- read from /usr/lib, which
# this tool never touches, so it stays right after branding.
upstream_id()   { ( . /usr/lib/os-release 2>/dev/null; echo "${ID:-fedora}" ); }
upstream_rel()  { ( . /usr/lib/os-release 2>/dev/null; echo "${VERSION_ID:-}" ); }
upstream_name() { ( . /usr/lib/os-release 2>/dev/null; echo "${NAME:-Fedora Linux}" ); }

current_pretty() { ( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}" ); }
current_id()     { ( . /etc/os-release 2>/dev/null; echo "${ID:-unknown}" ); }

branded() { [ "$(current_id)" = nulllinux ]; }

write_os_release() {
  local rel; rel=$(upstream_rel)
  local up;  up=$(upstream_name)
  # A real file, not a redirect through the symlink.
  rm -f /etc/os-release
  # NO COMMENTS IN THE OUTPUT.
  #
  # os-release is a machine-readable identity file that ends up on a stranger's
  # disk, and prose explaining a maintenance decision is not part of anyone's
  # identity. The reasons live here, in the tool that makes the file:
  #
  #   ID_LIKE   is not decoration. Everything that asks "what distribution is
  #             this" -- bin/pkg included -- has to keep finding fedora, or
  #             branding a machine breaks package management on it.
  #   VARIANT   states the remix relationship plainly, without claiming the
  #             mark: a Fedora Remix may not present itself as Fedora.
  cat > /etc/os-release <<OSREL
NAME="nullLinux"
VERSION="$VERSION"
ID=nulllinux
ID_LIKE=$(upstream_id)
VERSION_ID=$VERSION
PRETTY_NAME="nullLinux $VERSION"
VARIANT="$up $rel Remix"
VARIANT_ID=remix
ANSI_COLOR="0;38;2;255;120;0"
HOME_URL="$URL"
BUG_REPORT_URL="$URL/issues"
OSREL
  chmod 0644 /etc/os-release
}

do_report() {
  printf '  %-16s %s\n' "/etc/os-release" \
    "$([ -L /etc/os-release ] && echo 'symlink -> '"$(readlink /etc/os-release)" || echo 'regular file')"
  printf '  %-16s %s\n' "PRETTY_NAME" "$(current_pretty)"
  printf '  %-16s %s\n' "ID" "$(current_id)"
  printf '  %-16s %s\n' "upstream" "$(upstream_name) $(upstream_rel)"
  printf '  %-16s %s\n' "version" "$VERSION ($VERSION_FROM)"
  if branded; then
    echo "  branded; 'null-brand revert' restores $(upstream_name)"
  else
    echo "  not branded; 'null-brand apply' would set PRETTY_NAME=\"nullLinux $VERSION\""
  fi
}

do_apply() {
  [ "$(id -u)" = 0 ] || die "apply needs root"
  # Keep one copy of what the distribution shipped, so revert is exact even if
  # /usr/lib is later rewritten by an update.
  [ -e "$SAVED" ] || cp -f /usr/lib/os-release "$SAVED"
  write_os_release
  echo "  branded: $(current_pretty)"
}

do_revert() {
  [ "$(id -u)" = 0 ] || die "revert needs root"
  branded || { echo "  not branded; nothing to revert"; return 0; }
  rm -f /etc/os-release
  # Back to the symlink the distribution ships, not to a copy of it.
  ln -sf ../usr/lib/os-release /etc/os-release
  rm -f "$SAVED"
  echo "  reverted: $(current_pretty)"
}

case ${1:-report} in
  report) do_report ;;
  apply)  do_apply ;;
  revert) do_revert ;;
  version) printf '%s\n' "$VERSION" ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
