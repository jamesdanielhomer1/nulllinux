#!/usr/bin/env bash
# Build the nullLinux INSTALLER ISO -- Anaconda boot media (NULL.md §0.5).
#
# NOT THE LIVE IMAGE, AND FOR A REASON THAT WAS LEARNED THE HARD WAY.
#
# bin/null-iso builds a live image: it boots into the desktop so someone can
# look at it. Installing FROM that image cannot be automated on Fedora 44 --
# liveinst launches a web UI in Firefox and needs a display, and when driven
# with --text anaconda parses /usr/share/anaconda/interactive-defaults.ks
# rather than the kickstart it was handed. Four attempts and a shell inside the
# running image established that.
#
# THIS is what `inst.ks` was designed for. lorax's own summary of itself is
# "Create the Anaconda boot.iso": installer media, which boots the installer
# rather than a desktop, and for which unattended kickstart installation is the
# documented, supported path.
#
# The two images are complementary and both are wanted: one to try, one to
# install with.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
cd "$ROOT"
NAME=nulllinux
VERSION=$(rpmspec -q --qf '%{version}\n' packaging/$NAME.spec 2>/dev/null | head -1)
RELEASEVER=$("$ROOT/bin/pkg" distro-version 2>/dev/null || echo 44)
usage() { cat <<'U'
usage: null-installer-iso [--embed-only] [--yes]

  --embed-only   reuse the boot media already built, and only re-embed the
                 kickstart and the package repository. Seconds rather than
                 hours. Refuses if there is no media to reuse.
  --yes          do not ask before deleting existing boot media.

With no arguments this REBUILDS the boot media from scratch, which takes
hours and DELETES whatever is in the work directory first.
U
}

# AN UNRECOGNISED ARGUMENT MUST NOT START A MULTI-HOUR DESTRUCTIVE BUILD.
#
# This read only `$1 == --embed-only` and ignored everything else, so
# `null-installer-iso --help` printed no help: it fell through to the rebuild
# path, ran `rm -rf` over the boot media, and started lorax. Which is exactly
# what it did, and how the media it was about to reuse came to be deleted.
#
# Anything not understood is now an error, and -h prints the help it was asked
# for.
EMBED_ONLY=0
ASSUME_YES=0
while [ $# -gt 0 ]; do
  case $1 in
    --embed-only) EMBED_ONLY=1 ;;
    --yes|-y)     ASSUME_YES=1 ;;
    -h|--help)    usage; exit 0 ;;
    *) echo "null-installer-iso: unknown argument '$1'" >&2; echo >&2; usage >&2; exit 2 ;;
  esac
  shift
done

WORK=${NULL_ISO_WORK:-/var/lib/nulllinux-iso}
# Absolute, because lorax is run from inside it and every other path here is
# resolved before that cd.
case $WORK in /*) ;; *) WORK=$PWD/$WORK ;; esac
OUT="$WORK/installer"
# ONE MIRROR, CHOSEN AND CHECKED BEFORE THE BUILD STARTS.
#
# This used download.fedoraproject.org, which is a REDIRECTOR: it sends each
# request to a different mirror. Over the nine hundred packages a lorax run
# fetches, one incomplete mirror is enough to end it -- and it did, twice,
# both times on libev-4.33-15, which every other mirror has and which fetches
# in a third of a second by hand. Forty minutes of build, lost to a redirect.
#
# So: resolve ONE mirror from the metalink, prove it answers for both the
# metadata and an actual package, and hand lorax that. A mirror that fails the
# check is skipped before anything is downloaded rather than an hour into it.
MIRROR=${NULL_MIRROR:-}
if [ -z "$MIRROR" ]; then
  echo "choosing a mirror"
  ml="https://mirrors.fedoraproject.org/metalink?repo=fedora-$RELEASEVER&arch=x86_64"
  # A package that is small, ancient and universally present -- so a mirror
  # failing on it is missing content rather than merely lagging.
  probe="Packages/l/libev-4.33-15.fc$RELEASEVER.x86_64.rpm"
  for u in $(curl -s --max-time 30 "$ml" \
             | grep -oE 'https://[^<]+/Everything/x86_64/os/repodata/repomd\.xml' \
             | sed 's|/repodata/repomd\.xml$||' | head -8); do
    base=${u%/releases/*}; base=${base%/}
    root=${u%/repodata*}
    code_md=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$root/repodata/repomd.xml")
    code_pk=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -r 0-0 "$root/$probe")
    if [ "$code_md" = 200 ] && { [ "$code_pk" = 200 ] || [ "$code_pk" = 206 ]; }; then
      MIRROR=${u%/releases/*}
      echo "  $MIRROR"
      echo "  metadata $code_md, sample package $code_pk"
      break
    fi
    echo "  skipped $(printf '%s' "$u" | cut -d/ -f3): metadata $code_md, package $code_pk"
  done
fi
[ -n "$MIRROR" ] || { echo "null-installer-iso: no mirror answered for both metadata and packages" >&2; exit 1; }

command -v lorax >/dev/null 2>&1 || { echo "null-installer-iso: lorax is not installed" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || { echo "null-installer-iso: must be root" >&2; exit 1; }
[ -d packaging/repo/repodata ] || { echo "null-installer-iso: no local repository at packaging/repo" >&2
  echo "  Build the package first:  bin/null-package" >&2; exit 1; }

avail=$(df --output=avail -BG "$WORK" 2>/dev/null | tail -1 | tr -dc '0-9')
[ "${avail:-99}" -ge 15 ] || { echo "null-installer-iso: ${avail}G free; this wants 15G or more" >&2; exit 1; }

# lorax refuses to write into an existing directory rather than overwrite one,
# which is the right instinct and means this has to clear it deliberately.
# --embed-only MUST NOT DESTROY WHAT IT MEANS TO REUSE.
#
# This ran unconditionally, so the flag added to avoid a multi-hour rebuild
# deleted the freshly built media before discovering it was gone. Checked
# first, and refused loudly, rather than silently falling back to a rebuild
# that would look like the flag simply being slow.
if [ "$EMBED_ONLY" = 1 ]; then
  [ -f "$OUT/images/boot.iso" ] || {
    echo "null-installer-iso: --embed-only, but there is no boot media at" >&2
    echo "  $OUT/images/boot.iso -- build it first, without the flag." >&2
    exit 1
  }
else
  # SAY WHAT IS ABOUT TO BE DESTROYED, AND WHAT IT COST.
  #
  # Boot media is hours of build time and about a gigabyte of downloads. It is
  # not the kind of thing to delete on the way past.
  if [ -f "$OUT/images/boot.iso" ]; then
    echo "null-installer-iso: there is already boot media at"
    echo "  $OUT/images/boot.iso  ($(du -h "$OUT/images/boot.iso" | cut -f1), built $(date -r "$OUT/images/boot.iso" '+%Y-%m-%d %H:%M'))"
    echo
    echo "  A rebuild DELETES it and takes hours. If only the kickstart or the"
    echo "  package changed, --embed-only reuses it and takes seconds."
    echo
    if [ "$ASSUME_YES" != 1 ]; then
      # The prompt goes to STDERR, and BOTH ends are tested. With stdout piped
      # -- which is how anyone runs a build that takes hours -- a prompt on
      # stdout sits in the pipe buffer, and the script looks hung while it
      # waits for an answer to a question nobody was shown.
      if [ -t 0 ] && [ -t 2 ]; then
        printf '  delete it and rebuild? [y/N] ' >&2
        read -r reply
        case $reply in y|Y|yes) ;; *) echo "  nothing done."; exit 0 ;; esac
      else
        echo "  Not a terminal, so not guessing. Pass --yes to rebuild anyway," >&2
        echo "  or --embed-only to reuse what is there." >&2
        exit 3
      fi
    fi
  fi
  rm -rf "$OUT"
fi
mkdir -p "$WORK"

echo "building the nullLinux installer ISO ($NAME-$VERSION, Fedora $RELEASEVER)"
echo "  sources: $MIRROR + $ROOT/packaging/repo"
echo

# --isfinal: without it lorax marks the image as a pre-release and anaconda
#   shows a warning at every boot.
# --nomacboot: no Apple bootloader; it needs tooling this host does not have
#   and produces nothing usable on the hardware this targets.
# The package is NOT put on the image by lorax -- see the mkksiso step below,
#   which is what actually puts it there. lorax builds boot media and nothing
#   else; -s only tells it where to find packages for the RUNTIME image.
# Run lorax from the work directory, NOT from the checkout.  It writes an
# 88 MB debugdata/ dump of its dependency solver into the CWD, and from the
# checkout that lands in git -- which is exactly what happened once.
if [ "$EMBED_ONLY" = 1 ]; then
  echo "--embed-only: reusing the boot media already in $OUT"
  st=0
else
mkdir -p "$WORK/run"
( cd "$WORK/run" && \
# A PERSISTENT PACKAGE CACHE. lorax defaults to a temporary directory, so a
# build that dies on one interrupted download -- which is how this failed after
# downloading nine hundred packages -- throws all of them away and starts again
# from nothing. The cache makes a retry a retry rather than a repeat.
lorax -p "nullLinux" -v "$VERSION" -r "$RELEASEVER" \
  --cachedir "$WORK/dnfcache" \
  --isfinal --nomacboot \
  -s "$MIRROR/releases/$RELEASEVER/Everything/x86_64/os/" \
  -s "$MIRROR/updates/$RELEASEVER/Everything/x86_64/" \
  -s "file://$ROOT/packaging/repo" \
  --volid "nullLinux-inst-$VERSION" \
  --logfile "$WORK/lorax.log" \
  "$OUT" )
st=$?
fi

echo
if [ $st -eq 0 ] && iso=$(find "$OUT" -name 'boot.iso' | head -1) && [ -n "$iso" ]; then
  final="$WORK/$NAME-installer-$VERSION.iso"

  # THE BAKE HAS TO BE ON THE ISO, and it was not.
  #
  # lorax builds Anaconda BOOT media: a 1.2 GB runtime image and no packages at
  # all. Every package, this one included, was fetched over the network at
  # install time -- so the raytraced hero, the whole reason the package is 9 MB,
  # travelled separately from the thing that installs it. The ISO could not
  # install nullLinux on a machine that could not reach a repository we host,
  # which is most machines.
  #
  # A comment here claimed `-i nulllinux` put the package on the image. It did
  # not: there was no -i flag in the lorax call above, and the install test only
  # ever passed because the harness served packaging/repo over HTTP from the
  # build host. The comment described an intention; nothing implemented it.
  #
  # mkksiso is the supported way to add files and a kickstart to boot media --
  # it rebuilds the boot records rather than corrupting them, which hand-rolled
  # xorriso does not.
  if [ -d "$ROOT/packaging/repo" ] && ls "$ROOT/packaging/repo"/*.rpm >/dev/null 2>&1; then
    stage=$(mktemp -d "$WORK/embed.XXXX")
    mkdir -p "$stage/nulllinux"

    # --- the installer a person sees ---------------------------------------
    #
    # The ISO carries its own front end. anaconda's %pre runs on a console
    # before anything is written to disk, so bin/null-installer draws the
    # questions there -- in this system's colours, beside its hero -- and hands
    # anaconda the answers. Nobody sees an anaconda screen.
    #
    # THREE FILES, and no more. The installer environment is anaconda's
    # runtime: no render binary, no atlas, no cells file, no fzf. So the hero
    # travels as what it will be SHOWN as -- one frame, already ANSI --
    # rendered here by the same renderer every other surface uses, and the
    # picker falls back to a numbered list, which is why that fallback exists
    # and is tested.
    mkdir -p "$stage/nulllinux-installer"
    install -m 0755 "$ROOT/bin/null-installer" "$stage/nulllinux-installer/null-installer"
    install -m 0644 "$ROOT/lib/menu.sh"        "$stage/nulllinux-installer/menu.sh" 2>/dev/null || true

    # openvt, SHIPPED, because the installer environment does not have it.
    #
    # It finds the first FREE virtual terminal and runs a program on it. The
    # runtime has chvt -- proven by a boot -- and not openvt, because lorax
    # prunes what it installs. Without it the only console available is one
    # anaconda already runs a getty on, and a getty wins every keystroke: the
    # installer drew perfectly and then could not be answered.
    #
    # 24 KB, needs only libc, and the runtime is the same Fedora release this
    # is built on. Copied rather than depended on.
    if [ -x /usr/bin/openvt ]; then
      install -m 0755 /usr/bin/openvt "$stage/nulllinux-installer/openvt"
      echo "  shipping openvt ($(stat -c%s /usr/bin/openvt) bytes) -- the runtime has none"
    else
      echo "  no /usr/bin/openvt here to ship; the installer will fall back to tty6"
    fi
    hero_cells="$ROOT/assets/prebuilt/ter-118n/logo.cells"
    hero_atlas="$ROOT/assets/prebuilt/strikes/atlas-ter-118n.bin"
    if [ -r "$hero_cells" ] && [ -r "$hero_atlas" ] && [ -x "$ROOT/render/target/release/render" ] \
       && "$ROOT/render/target/release/render" --file "$hero_cells" --atlas "$hero_atlas" \
            still --frame 0 --out "$stage/nulllinux-installer/hero.ansi" >/dev/null 2>&1; then
      echo "  installer hero: $(wc -c < "$stage/nulllinux-installer/hero.ansi") bytes of ANSI"
    else
      echo "  no prebuilt hero for the installer -- it will show its name instead"
    fi
    cp -f "$ROOT/packaging/repo"/*.rpm "$stage/nulllinux/"
    createrepo_c -q "$stage/nulllinux" || { echo "createrepo_c failed" >&2; exit 1; }

    # The kickstart is the SAME file the test harness uses; only the repo URL
    # differs. Anaconda mounts the boot media at /run/install/repo, so the
    # directory added here is reachable from the installed system's own disc.
    # --- the interactive kickstart, DERIVED rather than written ------------
    #
    # It is packaging/nulllinux-install.ks with the ANSWERED lines removed and
    # a %pre that asks for them. Generated here rather than committed, so the
    # two cannot drift: what nullLinux IS is described once and answered two
    # ways -- by a person, or by the constants in that file for the unattended
    # test.
    ks="$stage/install.ks"
    # ALL THREE placeholders, not just ours. The base and updates URLs must be
    # concrete: anaconda does not reliably expand $releasever in a kickstart
    # `url` line, and reports "Error setting up repositories" without saying
    # which one or why.
    sed -e "s|NULLLINUX_REPO|file:///run/install/repo/nulllinux|" \
        -e "s|NULLLINUX_BASEURL|https://mirrors.fedoraproject.org/metalink?repo=fedora-$RELEASEVER\&arch=x86_64|" \
        -e "s|NULLLINUX_UPDATES|https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$RELEASEVER\&arch=x86_64|" \
        "$ROOT/packaging/$NAME-install.ks" > "$ks"

    # NOW MAKE IT ASK.
    #
    # The directives removed below are the ANSWERS: which disk, who you are,
    # where you are. They are constants in the unattended kickstart because a
    # test has nobody to ask. Here they go, replaced by a %pre that runs the
    # installer and an %include of what it writes.
    #
    # If the person declines, null-installer exits non-zero and writes NO file
    # -- so the %include fails and anaconda stops without having touched a
    # disk. That refusal path is the important one, and it is tested.
    python3 - "$ks" <<'ASK'
import re, sys
p = sys.argv[1]
s = open(p).read()

# sshpw goes too: it is a way into the INSTALLER for the test harness and has
# no business on media somebody boots.
for pat in (r'^ignoredisk .*$', r'^zerombr$', r'^clearpart .*$', r'^autopart .*$',
            r'^bootloader .*$', r'^network .*$', r'^timezone .*$', r'^keyboard .*$',
            r'^rootpw .*$', r'^user --name.*$', r'^sshpw .*$'):
    s = re.sub(pat, '', s, flags=re.M)

pre = (
 "# THE FACE, AND THEN THE MACHINERY.\n"
 "#\n"
 "# GENERATED by bin/null-installer-iso from packaging/nulllinux-install.ks:\n"
 "# the answered lines removed and this put in their place, so what nullLinux\n"
 "# IS is described once and answered two ways.\n"
 "%pre --interpreter=/bin/bash --log=/tmp/null-installer.log\n"
 "# A CONSOLE, BECAUSE %pre IS NOT GIVEN ONE.\n"
 "#\n"
 "# anaconda sends %pre's output to a log and its stdin is not a terminal, so\n"
 "# an interactive program started here draws nowhere and blocks for ever.\n"
 "# That is not theory: a real boot sat at 'Running pre-installation scripts'\n"
 "# with a blank screen and no way to tell why.\n"
 "#\n"
 "# tty6, because anaconda's own tmux owns tty1 and a shell is offered on\n"
 "# tty2. chvt puts the person in front of it and back afterwards.\n"
 "# DIAGNOSTICS TO THE SERIAL PORT, not just the log. %pre's log lives\n"
 "# inside the installer environment, which is exactly the machine you\n"
 "# cannot reach when the installer is the thing that is broken.\n"
 "exec 3>/dev/ttyS0 || exec 3>/dev/null\n"
 "log() { echo \"nullLinux: $*\" >&3; echo \"nullLinux: $*\"; }\n"
 "log \"--- what the installer environment offers ---\"\n"
 "log \"user=$(id -un) tty=$(tty 2>&1)\"\n"
 "log \"chvt=$(command -v chvt || echo none) fzf=$(command -v fzf || echo none)\"\n"
 "log \"tty6=$(ls -l /dev/tty6 2>&1)\"\n"
 "log \"disks=$(lsblk -dnpo NAME,SIZE,TYPE 2>&1 | tr '\\n' ' ')\"\n"

 "# A VT NOBODY ELSE IS ON.\n"
 "#\n"
 "# The first attempt bound the installer to /dev/tty6 and switched to it.\n"
 "# It DREW -- the hero, the questions, the one disk -- and then every\n"
 "# keystroke went to the login shell anaconda also runs there. tty6 has a\n"
 "# getty on it, and a getty wins.\n"
 "#\n"
 "# openvt finds the first FREE virtual terminal, runs the program with its\n"
 "# stdin, stdout and stderr on it, switches to it (-s) and waits (-w). It is\n"
 "# from kbd, the same package as the chvt already proven present here.\n"
 "INST=/run/install/repo/nulllinux-installer\n"
 "OPENVT=$INST/openvt\n"
 "[ -x \"$OPENVT\" ] || OPENVT=$(command -v openvt 2>/dev/null)\n"
 "if [ -n \"$OPENVT\" ] && [ -x \"$OPENVT\" ]; then\n"
 "  \"$OPENVT\" -s -w -- /usr/bin/env NULL_ROOT=$INST \\\n"
 "    $INST/null-installer --generate /tmp/nulllinux-answers.ks\n"
 "  rc=$?\n"
 "  log \"installer rc=$rc (openvt)\"\n"
 "elif [ -c /dev/tty6 ] && command -v chvt >/dev/null 2>&1; then\n"
 "  # No openvt: take tty6 and hope nothing else is on it. Kept because a\n"
 "  # cut-down runtime might have chvt and not openvt, and a worse console is\n"
 "  # better than none.\n"
 "  # Whatever holds tty6 has to go first, or it eats the answers.\n"
 "  for pid in $(ps -o pid= -t tty6 2>/dev/null); do kill \"$pid\" 2>/dev/null; done\n"
 "  sleep 1\n"
 "  chvt 6\n"
 "  NULL_ROOT=$INST $INST/null-installer --console /dev/tty6 \\\n"
 "    --generate /tmp/nulllinux-answers.ks\n"
 "  rc=$?\n"
 "  chvt 1\n"
 "  log \"installer rc=$rc (tty6)\"\n"
 "else\n"
 "  log 'no console for the installer; not proceeding'\n"
 "  rc=1\n"
 "fi\n"
 "log \"answers=$(ls -l /tmp/nulllinux-answers.ks 2>&1)\"\n"
 "\n"
 "# THE FILE IS THE VERDICT, not the wrapper's exit status.\n"
 "#\n"
 "# openvt returned 8 from a run that succeeded -- the installer has no such\n"
 "# exit path, so that number is the wrapper's, not the answer's. %pre would\n"
 "# have reported a completed install as a failure.\n"
 "#\n"
 "# What actually decides is whether the answers exist: the installer writes\n"
 "# them only after somebody typed the disk's name, and writes nothing at all\n"
 "# when they did not. The %include below then either finds a file or stops\n"
 "# the install. Asking the file is asking the thing that is true.\n"
 "if [ -s /tmp/nulllinux-answers.ks ]; then\n"
 "  log \"the answers were written (wrapper rc=$rc)\"\n"
 "  exit 0\n"
 "fi\n"
 "log \"no answers were written (wrapper rc=$rc); the %include will stop this\"\n"
 "exit 1\n"
 "%end\n"
 "\n"
 "%include /tmp/nulllinux-answers.ks\n"
 "\n")
s = s.replace('%packages', pre + '%packages', 1)
s = re.sub(r'\n{4,}', '\n\n\n', s)
open(p, 'w').write(s)
ASK
    grep -q '%include /tmp/nulllinux-answers.ks' "$ks" \
      || { echo "null-installer-iso: the interactive kickstart has no %include" >&2; exit 1; }
    for gone in '^clearpart ' '^user --name' '^rootpw ' '^sshpw '; do
      if grep -qE "$gone" "$ks"; then
        echo "null-installer-iso: '$gone' survived into the interactive kickstart" >&2; exit 1
      fi
    done
    echo "  the kickstart asks rather than assumes"
    # THE DEBUG KEY IS STRIPPED, not substituted. The kickstart carries a block
    # that drops an ssh key into root's authorized_keys so a test with no
    # console can get in, and says in its own comment that a real image would
    # not do that. verify/vm-iso-install.sh fills it in; a shipped ISO must not
    # have it at all -- shipping it with the placeholder left in would put the
    # literal string NULLLINUX_TEST_KEY in authorized_keys, which is harmless
    # only by accident.
    python3 - "$ks" <<'STRIP'
import re, sys
p = sys.argv[1]
s = open(p).read()
s = re.sub(r"\n# A way in, for a test that has no console.*?chmod 600 /root/\.ssh/authorized_keys\n",
           "\n# (the test-only ssh key block is stripped from shipped media)\n",
           s, flags=re.S)
open(p, "w").write(s)
STRIP

    # NOTHING SHIPS WITH A PLACEHOLDER IN IT. This caught the key block above:
    # the build had already run for hours and would otherwise have produced an
    # ISO that looked fine and carried a placeholder as a credential.
    if grep -q NULLLINUX_ "$ks"; then
      echo "null-installer-iso: a placeholder was left unsubstituted:" >&2
      grep -n NULLLINUX_ "$ks" >&2; exit 1
    fi

    echo "embedding the package (and the hero inside it) on the ISO"
    printf '  %s\n' "$(ls -1 "$stage/nulllinux"/*.rpm | xargs -n1 basename)"
    # mkksiso REFUSES to overwrite its output, and after a multi-hour lorax run
    # the failure it reports is "already exists" -- for a stale ISO from a
    # previous build. Written to a temporary name and moved into place, so the
    # final path only ever holds a complete image and a half-written one cannot
    # be mistaken for a finished one.
    tmpiso="$final.new"
    rm -f "$tmpiso"
    # BOTH directories. -a takes one path per flag, and giving it only the
    # package directory is how the installer came to be staged, referenced by
    # the kickstart, and absent from the medium -- the same shape as the
    # session entry that was written, wired in, and never shipped.
    # THE DEFAULT ENTRY IS "Install", NOT "Test this media & install".
    #
    # lorax writes set default="1", and entry 1 verifies the whole 1.2 GB
    # image before it will start. That is a fair default for a disc somebody
    # burned and scratched, and a poor one for the first thing a person sees.
    # The check is still there as entry 1, one keypress away.
    #
    # -R rewrites grub.cfg inside the image, which is mkksiso's own supported
    # way of doing it: editing an ISO by hand is how boot records get broken.
    if mkksiso --ks "$ks" -a "$stage/nulllinux" -a "$stage/nulllinux-installer" \
             -R 'set default="1"' 'set default="0"' \
               "$iso" "$tmpiso" >"$WORK/mkksiso.log" 2>&1 \
       && mv -f "$tmpiso" "$final"; then
      echo "  embedded"
    else
      echo "null-installer-iso: mkksiso FAILED -- $WORK/mkksiso.log" >&2
      tail -20 "$WORK/mkksiso.log" >&2
      rm -f "$tmpiso"
      exit 1
    fi
    rm -rf "$stage"
  else
    echo "no packaging/repo -- the ISO will have NO packages on it" >&2
    echo "  build one with bin/null-package first" >&2
    cp -f "$iso" "$final"
  fi

  echo "built: $final"
  echo "  $(du -h "$final" | cut -f1)"
  echo
  echo "This boots the INSTALLER, not a desktop. It carries its own copy of"
  echo "the nulllinux package, so the desktop and its hero need no network;"
  echo "the base Fedora packages still come from a mirror."
else
  echo "null-installer-iso: FAILED -- last lines of $WORK/lorax.log" >&2
  tail -25 "$WORK/lorax.log" 2>/dev/null >&2
fi
exit $st
