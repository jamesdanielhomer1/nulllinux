#!/usr/bin/env bash
# Build the nullLinux INSTALLER ISO -- Anaconda boot media (NULL.md §0.5).
#
# NOT THE LIVE IMAGE, AND FOR A REASON THAT WAS LEARNED THE HARD WAY.
#
# bin/null-iso builds a live image: it boots into the desktop so someone can
# look at it. Installing FROM that image cannot be automated on Fedora 44 --
# liveinst launches a web UI in Firefox and needs a display, and when driven
# with --text anaconda parses /usr/share/anaconda/interactive-defaults.ks
# rather than the kickstart it was handed. Four attempts and a shell inside the
# running image established that.
#
# THIS is what `inst.ks` was designed for. lorax's own summary of itself is
# "Create the Anaconda boot.iso": installer media, which boots the installer
# rather than a desktop, and for which unattended kickstart installation is the
# documented, supported path.
#
# The two images are complementary and both are wanted: one to try, one to
# install with.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
cd "$ROOT"
NAME=nulllinux
VERSION=$(rpmspec -q --qf '%{version}\n' packaging/$NAME.spec 2>/dev/null | head -1)
RELEASEVER=$("$ROOT/bin/pkg" distro-version 2>/dev/null || echo 44)
# Rebuilding the boot media takes hours; embedding takes seconds. When the
# only thing that changed is what goes ON the ISO, reuse the media.
EMBED_ONLY=0
[ "${1:-}" = "--embed-only" ] && { EMBED_ONLY=1; shift; }

WORK=${NULL_ISO_WORK:-/var/lib/nulllinux-iso}
# Absolute, because lorax is run from inside it and every other path here is
# resolved before that cd.
case $WORK in /*) ;; *) WORK=$PWD/$WORK ;; esac
OUT="$WORK/installer"
MIRROR=${NULL_MIRROR:-https://download.fedoraproject.org/pub/fedora/linux}

command -v lorax >/dev/null 2>&1 || { echo "null-installer-iso: lorax is not installed" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || { echo "null-installer-iso: must be root" >&2; exit 1; }
[ -d packaging/repo/repodata ] || { echo "null-installer-iso: no local repository at packaging/repo" >&2
  echo "  Build the package first:  bin/null-package" >&2; exit 1; }

avail=$(df --output=avail -BG "$WORK" 2>/dev/null | tail -1 | tr -dc '0-9')
[ "${avail:-99}" -ge 15 ] || { echo "null-installer-iso: ${avail}G free; this wants 15G or more" >&2; exit 1; }

# lorax refuses to write into an existing directory rather than overwrite one,
# which is the right instinct and means this has to clear it deliberately.
# --embed-only MUST NOT DESTROY WHAT IT MEANS TO REUSE.
#
# This ran unconditionally, so the flag added to avoid a multi-hour rebuild
# deleted the freshly built media before discovering it was gone. Checked
# first, and refused loudly, rather than silently falling back to a rebuild
# that would look like the flag simply being slow.
if [ "$EMBED_ONLY" = 1 ]; then
  [ -f "$OUT/images/boot.iso" ] || {
    echo "null-installer-iso: --embed-only, but there is no boot media at" >&2
    echo "  $OUT/images/boot.iso -- build it first, without the flag." >&2
    exit 1
  }
else
  rm -rf "$OUT"
fi
mkdir -p "$WORK"

echo "building the nullLinux installer ISO ($NAME-$VERSION, Fedora $RELEASEVER)"
echo "  sources: $MIRROR + $ROOT/packaging/repo"
echo

# --isfinal: without it lorax marks the image as a pre-release and anaconda
#   shows a warning at every boot.
# --nomacboot: no Apple bootloader; it needs tooling this host does not have
#   and produces nothing usable on the hardware this targets.
# The package is NOT put on the image by lorax -- see the mkksiso step below,
#   which is what actually puts it there. lorax builds boot media and nothing
#   else; -s only tells it where to find packages for the RUNTIME image.
# Run lorax from the work directory, NOT from the checkout.  It writes an
# 88 MB debugdata/ dump of its dependency solver into the CWD, and from the
# checkout that lands in git -- which is exactly what happened once.
if [ "$EMBED_ONLY" = 1 ]; then
  echo "--embed-only: reusing the boot media already in $OUT"
  st=0
else
mkdir -p "$WORK/run"
( cd "$WORK/run" && \
# A PERSISTENT PACKAGE CACHE. lorax defaults to a temporary directory, so a
# build that dies on one interrupted download -- which is how this failed after
# downloading nine hundred packages -- throws all of them away and starts again
# from nothing. The cache makes a retry a retry rather than a repeat.
lorax -p "nullLinux" -v "$VERSION" -r "$RELEASEVER" \
  --cachedir "$WORK/dnfcache" \
  --isfinal --nomacboot \
  -s "$MIRROR/releases/$RELEASEVER/Everything/x86_64/os/" \
  -s "$MIRROR/updates/$RELEASEVER/Everything/x86_64/" \
  -s "file://$ROOT/packaging/repo" \
  --volid "nullLinux-inst-$VERSION" \
  --logfile "$WORK/lorax.log" \
  "$OUT" )
st=$?
fi

echo
if [ $st -eq 0 ] && iso=$(find "$OUT" -name 'boot.iso' | head -1) && [ -n "$iso" ]; then
  final="$WORK/$NAME-installer-$VERSION.iso"

  # THE BAKE HAS TO BE ON THE ISO, and it was not.
  #
  # lorax builds Anaconda BOOT media: a 1.2 GB runtime image and no packages at
  # all. Every package, this one included, was fetched over the network at
  # install time -- so the raytraced hero, the whole reason the package is 9 MB,
  # travelled separately from the thing that installs it. The ISO could not
  # install nullLinux on a machine that could not reach a repository we host,
  # which is most machines.
  #
  # A comment here claimed `-i nulllinux` put the package on the image. It did
  # not: there was no -i flag in the lorax call above, and the install test only
  # ever passed because the harness served packaging/repo over HTTP from the
  # build host. The comment described an intention; nothing implemented it.
  #
  # mkksiso is the supported way to add files and a kickstart to boot media --
  # it rebuilds the boot records rather than corrupting them, which hand-rolled
  # xorriso does not.
  if [ -d "$ROOT/packaging/repo" ] && ls "$ROOT/packaging/repo"/*.rpm >/dev/null 2>&1; then
    stage=$(mktemp -d "$WORK/embed.XXXX")
    mkdir -p "$stage/nulllinux"
    cp -f "$ROOT/packaging/repo"/*.rpm "$stage/nulllinux/"
    createrepo_c -q "$stage/nulllinux" || { echo "createrepo_c failed" >&2; exit 1; }

    # The kickstart is the SAME file the test harness uses; only the repo URL
    # differs. Anaconda mounts the boot media at /run/install/repo, so the
    # directory added here is reachable from the installed system's own disc.
    ks="$stage/install.ks"
    # ALL THREE placeholders, not just ours. The base and updates URLs must be
    # concrete: anaconda does not reliably expand $releasever in a kickstart
    # `url` line, and reports "Error setting up repositories" without saying
    # which one or why.
    sed -e "s|NULLLINUX_REPO|file:///run/install/repo/nulllinux|" \
        -e "s|NULLLINUX_BASEURL|$MIRROR/releases/$RELEASEVER/Everything/x86_64/os/|" \
        -e "s|NULLLINUX_UPDATES|$MIRROR/updates/$RELEASEVER/Everything/x86_64/|" \
        "$ROOT/packaging/$NAME-install.ks" > "$ks"
    # THE DEBUG KEY IS STRIPPED, not substituted. The kickstart carries a block
    # that drops an ssh key into root's authorized_keys so a test with no
    # console can get in, and says in its own comment that a real image would
    # not do that. verify/vm-iso-install.sh fills it in; a shipped ISO must not
    # have it at all -- shipping it with the placeholder left in would put the
    # literal string NULLLINUX_TEST_KEY in authorized_keys, which is harmless
    # only by accident.
    python3 - "$ks" <<'STRIP'
import re, sys
p = sys.argv[1]
s = open(p).read()
s = re.sub(r"\n# A way in, for a test that has no console.*?chmod 600 /root/\.ssh/authorized_keys\n",
           "\n# (the test-only ssh key block is stripped from shipped media)\n",
           s, flags=re.S)
open(p, "w").write(s)
STRIP

    # NOTHING SHIPS WITH A PLACEHOLDER IN IT. This caught the key block above:
    # the build had already run for hours and would otherwise have produced an
    # ISO that looked fine and carried a placeholder as a credential.
    if grep -q NULLLINUX_ "$ks"; then
      echo "null-installer-iso: a placeholder was left unsubstituted:" >&2
      grep -n NULLLINUX_ "$ks" >&2; exit 1
    fi

    echo "embedding the package (and the hero inside it) on the ISO"
    printf '  %s\n' "$(ls -1 "$stage/nulllinux"/*.rpm | xargs -n1 basename)"
    # mkksiso REFUSES to overwrite its output, and after a multi-hour lorax run
    # the failure it reports is "already exists" -- for a stale ISO from a
    # previous build. Written to a temporary name and moved into place, so the
    # final path only ever holds a complete image and a half-written one cannot
    # be mistaken for a finished one.
    tmpiso="$final.new"
    rm -f "$tmpiso"
    if mkksiso --ks "$ks" -a "$stage/nulllinux" "$iso" "$tmpiso" >"$WORK/mkksiso.log" 2>&1 \
       && mv -f "$tmpiso" "$final"; then
      echo "  embedded"
    else
      echo "null-installer-iso: mkksiso FAILED -- $WORK/mkksiso.log" >&2
      tail -20 "$WORK/mkksiso.log" >&2
      rm -f "$tmpiso"
      exit 1
    fi
    rm -rf "$stage"
  else
    echo "no packaging/repo -- the ISO will have NO packages on it" >&2
    echo "  build one with bin/null-package first" >&2
    cp -f "$iso" "$final"
  fi

  echo "built: $final"
  echo "  $(du -h "$final" | cut -f1)"
  echo
  echo "This boots the INSTALLER, not a desktop. It carries its own copy of"
  echo "the nulllinux package, so the desktop and its hero need no network;"
  echo "the base Fedora packages still come from a mirror."
else
  echo "null-installer-iso: FAILED -- last lines of $WORK/lorax.log" >&2
  tail -25 "$WORK/lorax.log" 2>/dev/null >&2
fi
exit $st
