#!/usr/bin/env bash
# Launch an installed application (NULL.md §8.4).
#
# Reads the desktop entries the system already has rather than keeping a list.
# A list would be a second copy of what is installed, and it would be wrong the
# first time anything changed.
#
# NoDisplay entries are omitted: they exist precisely to say "do not offer me".
#
# THE APP IS LAUNCHED DETACHED, AND THE LAUNCHER THEN EXITS. This runs hosted in
# the column, so an `exec` into the app made the app the column's host process:
# it "stayed open" tied to the column, closing the column killed it, and a name
# with a space broke the command it built. Instead the command rides a hidden
# field (so a spaced name cannot corrupt it), the app is started in its own
# session with its streams detached, and this returns -- which frees the column
# and lets you open it again for the next app.
set -uo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
. "$ROOT/lib/menu.sh"
null_fzf_flags

DIRS=(/usr/share/applications /usr/local/share/applications
      "$HOME/.local/share/applications" /var/lib/flatpak/exports/share/applications)

# Built into a variable BEFORE the picker starts (§7.4): a slow producer piped
# into fzf leaves it in its loading state, and its spinner is braille.
#
# Each row is THREE tab-separated fields: the display (what the eye reads), a
# kind (term|gui), and the exec command. Only the display is shown (--with-nth),
# and the whole line comes back on accept, so the command is read from the line
# by position (after the last tab) -- a name with spaces cannot be mistaken for
# part of the command, and no fragile hidden-field return is relied on.
list=$(python3 - "${DIRS[@]}" <<'PY'
import configparser, os, sys
seen, rows = set(), []
for d in sys.argv[1:]:
    if not os.path.isdir(d):
        continue
    for f in sorted(os.listdir(d)):
        if not f.endswith(".desktop") or f in seen:
            continue
        seen.add(f)
        c = configparser.RawConfigParser(strict=False)
        try:
            c.read(os.path.join(d, f), encoding="utf-8")
            e = c["Desktop Entry"]
        except Exception:
            continue
        if e.get("NoDisplay", "false").lower() == "true":
            continue
        if e.get("Type", "Application") != "Application":
            continue
        name = e.get("Name", f[:-8])
        # Field codes are placeholders for files and URLs the launcher would
        # substitute; run with none, so they are stripped rather than passed on
        # as literal arguments.
        exe = " ".join(w for w in e.get("Exec", "").split() if not w.startswith("%"))
        if not exe:
            continue
        term = e.get("Terminal", "false").lower() == "true"
        display = "%-30s %s%s" % (name[:30], "[term] " if term else "", exe)
        rows.append("%s\t%s\t%s" % (display, "term" if term else "gui", exe))
for r in sorted(rows):
    print(r)
PY
)
[ -n "$list" ] || { echo "no desktop entries found" >&2; exit 1; }

pick=$(printf '%s\n' "$list" | fzf "${NULL_FZF[@]}" --prompt='run > ' \
         --delimiter='\t' --with-nth=1) || exit 0
[ -n "$pick" ] || exit 0

# fzf returns the WHOLE original line -- --with-nth changes only what is SHOWN,
# not what comes back. The line is  display<TAB>kind<TAB>exe , so the exe is
# everything after the last tab and the kind is the field before it, parsed with
# ${##}/${%} so a name or a command containing spaces is safe.
#
# NOT --accept-nth: with --with-nth in play, fzf evaluates accept-nth's field
# numbers against the SHOWN line -- which is field 1 alone -- so --accept-nth=2,3
# returned an empty string and the launcher exited having started nothing. That
# was "the launcher does not work": it drew, it took a pick, and then silently
# did nothing.
tab=$'\t'
exe=${pick##*"$tab"}
rest=${pick%"$tab"*}; kind=${rest##*"$tab"}
[ -n "${exe:-}" ] || exit 0

# DETACHED, so it outlives this launcher and the column that hosted it: its own
# session (setsid), its streams to /dev/null, backgrounded and disowned. A
# terminal app is wrapped in a foot window; a GUI app is run directly.
case $kind in
  term) setsid foot -e $exe </dev/null >/dev/null 2>&1 & ;;
  *)    setsid $exe        </dev/null >/dev/null 2>&1 & ;;
esac
disown 2>/dev/null || true
exit 0
