#!/usr/bin/env bash
# Build one source revision and one verified prebuilt set into the nullLinux RPM.
set -euo pipefail
ROOT=${NULL_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)}
cd "$ROOT"
ALLOW_DIRTY=0
for arg in "$@"; do
  case $arg in
    --allow-dirty) ALLOW_DIRTY=1 ;;
    -h|--help)
      echo "usage: null-package [--allow-dirty]"
      echo "  Packages HEAD. --allow-dirty acknowledges that working changes are excluded."
      exit 0 ;;
    *) echo "null-package: unknown argument '$arg'" >&2; exit 2 ;;
  esac
done
NAME=nulllinux
TOP=${NULL_RPM_TOP:-$ROOT/packaging/rpmbuild}
case $TOP in /*) ;; *) TOP=$ROOT/$TOP ;; esac
for tool in git rpmspec rpmbuild python3 tar gzip createrepo_c; do
  command -v "$tool" >/dev/null || { echo "null-package: $tool is not installed" >&2; exit 1; }
done
REV=$(git rev-parse --verify HEAD)
dirty=$(git status --porcelain --untracked-files=normal)
if [ -n "$dirty" ]; then
  echo "null-package: working changes will NOT be packaged; the source is HEAD ($REV):" >&2
  printf '%s\n' "$dirty" >&2
  [ "$ALLOW_DIRTY" = 1 ] || { echo "Commit first, or pass --allow-dirty to package HEAD." >&2; exit 1; }
fi
[ -d assets/prebuilt ] || { echo "null-package: assets/prebuilt is missing; run bin/null-prebake" >&2; exit 1; }
mkdir -p "$TOP"/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
work=$(mktemp -d "$TOP/package.XXXXXX")
stage=""
cleanup() {
  [ -z "$stage" ] || rm -rf -- "$stage"
  rm -rf -- "$work"
}
trap cleanup EXIT
# --allow-dirty never mixes an edited spec with an older source archive.
git show "$REV:packaging/$NAME.spec" > "$work/$NAME.spec"
VERSION=$(rpmspec -q --qf '%{version}\n' "$work/$NAME.spec" | head -1)
[ -n "$VERSION" ] || { echo "null-package: cannot read the committed version" >&2; exit 1; }
export SOURCE_DATE_EPOCH
SOURCE_DATE_EPOCH=$(git show -s --format=%ct "$REV")
echo "packaging $NAME-$VERSION from $REV"
git archive --format=tar --prefix="$NAME-$VERSION/" "$REV" \
  | gzip -n > "$TOP/SOURCES/$NAME-$VERSION.tar.gz"
mkdir -p "$work/source" "$work/prebuilt"
tar -xzf "$TOP/SOURCES/$NAME-$VERSION.tar.gz" -C "$work/source" --strip-components=1
tar --sort=name --mtime="@$SOURCE_DATE_EPOCH" --owner=0 --group=0 --numeric-owner \
  --mode='a=r,u+w,a+X' \
  -czf "$TOP/SOURCES/$NAME-prebuilt-$VERSION.tar.gz" assets/prebuilt
tar -xzf "$TOP/SOURCES/$NAME-prebuilt-$VERSION.tar.gz" -C "$work/prebuilt"
# Validate Source1 itself, not a directory another bake could change meanwhile.
python3 "$work/source/packaging/prebuilt.py" --source-root "$work/source" "$work/prebuilt"
python3 - "$work/source" "$work/$NAME.spec" <<'GEN'
import pathlib, re, sys
root, spec = map(pathlib.Path, sys.argv[1:])
want = set()
for line in (root / "packages/fedora/base.list").read_text().splitlines():
    if "build-only" not in line:
        want.update(line.split("#")[0].split())
text = spec.read_text()
block = "\n".join(f"Requires:       {name}" for name in sorted(want))
text, count = re.subn(r"(?ms)^Requires:.*?(?=\n\n)", block, text, count=1)
if count != 1:
    sys.exit("null-package: could not find the Requires block to regenerate")
spec.write_text(text)
GEN
cp "$work/$NAME.spec" "$TOP/SPECS/$NAME.spec"
python3 - "$TOP" "$REV" "$VERSION" <<'INFO'
import hashlib, json, pathlib, sys
top, revision, version = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
files = [top/"SOURCES"/f"nulllinux-{version}.tar.gz",
         top/"SOURCES"/f"nulllinux-prebuilt-{version}.tar.gz", top/"SPECS/nulllinux.spec"]
hashes = {}
for path in files:
    with path.open("rb") as f:
        hashes[path.name] = hashlib.file_digest(f, "sha256").hexdigest()
(top/"SOURCES/nulllinux-build-info.json").write_text(
    json.dumps({"source_commit": revision, "version": version, "sha256": hashes}, indent=2, sort_keys=True) + "\n")
INFO
mkdir -p "$work/RPMS"
if ! rpmbuild --define "_topdir $TOP" --define "_rpmdir $work/RPMS" \
     -bb "$TOP/SPECS/$NAME.spec" > "$TOP/build.log" 2>&1; then
  echo "rpmbuild FAILED -- last lines of $TOP/build.log:" >&2
  tail -20 "$TOP/build.log" >&2
  exit 1
fi
mapfile -d '' -t rpms < <(find "$work/RPMS" -type f -name "$NAME-*.rpm" -print0)
[ "${#rpms[@]}" -gt 0 ] || { echo "null-package: rpmbuild produced no $NAME RPM" >&2; exit 1; }
# Prepare the replacement repository before touching the last usable one.
# Historical RPM outputs never enter it.
stage=$(mktemp -d "$ROOT/packaging/.repo.XXXXXX")
if [ -d packaging/repo ]; then
  find packaging/repo -maxdepth 1 -type f -name '*.rpm' ! -name "$NAME-*.rpm" \
    -exec cp -- {} "$stage/" \;
fi
for artifact in "${rpms[@]}"; do
  arch=$(basename "$(dirname "$artifact")")
  mkdir -p "$TOP/RPMS/$arch"
  cp -- "$artifact" "$TOP/RPMS/$arch/"
  cp -- "$artifact" "$stage/"
  cmp -s -- "$artifact" "$stage/$(basename "$artifact")"
done
cp "$TOP/SOURCES/nulllinux-build-info.json" "$stage/BUILD-INFO.json"
createrepo_c -q "$stage"
previous=$(mktemp -d "$ROOT/packaging/.repo.previous.XXXXXX")
rmdir "$previous"
if [ -e packaging/repo ]; then mv -T -- packaging/repo "$previous"; fi
if ! mv -T -- "$stage" packaging/repo; then
  [ ! -d "$previous" ] || mv -T -- "$previous" packaging/repo
  echo "null-package: could not publish repository" >&2
  exit 1
fi
stage=""
[ ! -d "$previous" ] || rm -rf -- "$previous"
echo "built and published to packaging/repo:"
find packaging/repo -maxdepth 1 -name "$NAME-*.rpm" -printf '  %p  %s bytes\n'
echo "provenance: packaging/repo/BUILD-INFO.json"
