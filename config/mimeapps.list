# nullLinux -- default applications (NULL.md §8.4).
#
# GENERATED by regenerating this file; installed to /etc/xdg/mimeapps.list by
# bin/null-install, where it overrides the distribution's own choices (which
# name eog and evince -- viewers this system does not ship -- and otherwise
# fall through to the browser). A person's own choices live in
# ~/.config/mimeapps.list and win over this; bin/null-defaults writes them.
#
# Handlers are chosen for the palette: imv, zathura and mpv take their
# colours from a config file this system generates; a GTK/Qt default viewer
# would not. Do not hand-edit -- change bin/null-defaults' choices and
# regenerate.

[Default Applications]
text/html=org.mozilla.firefox.desktop
x-scheme-handler/http=org.mozilla.firefox.desktop
x-scheme-handler/https=org.mozilla.firefox.desktop
x-scheme-handler/about=org.mozilla.firefox.desktop
x-scheme-handler/unknown=org.mozilla.firefox.desktop
inode/directory=thunar.desktop
image/png=imv.desktop
image/jpeg=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
image/bmp=imv.desktop
image/tiff=imv.desktop
image/x-portable-pixmap=imv.desktop
image/x-xpixmap=imv.desktop
application/pdf=org.pwmt.zathura-pdf-mupdf.desktop
application/epub+zip=org.pwmt.zathura-pdf-mupdf.desktop
application/oxps=org.pwmt.zathura-pdf-mupdf.desktop
application/x-cbz=org.pwmt.zathura-pdf-mupdf.desktop
application/x-cbr=org.pwmt.zathura-pdf-mupdf.desktop
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/quicktime=mpv.desktop
video/x-msvideo=mpv.desktop
video/mpeg=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/ogg=mpv.desktop
audio/x-wav=mpv.desktop
audio/mp4=mpv.desktop
audio/aac=mpv.desktop
audio/x-vorbis+ogg=mpv.desktop
application/zip=xarchiver.desktop
application/x-tar=xarchiver.desktop
application/gzip=xarchiver.desktop
application/x-bzip2=xarchiver.desktop
application/x-xz=xarchiver.desktop
application/zstd=xarchiver.desktop
