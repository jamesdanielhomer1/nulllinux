# nox -- compositor configuration
#
# NULL.md §8.2 (window management) and §8.3 (the keys).
#
# EVERY binding carries a description on the preceding `#:` line. A binding
# with no description cannot appear in the generated keys list and cannot be
# audited, so verify/check_binds.py fails the build on any that lacks one.
#
# Bindings are audited by parsing this file and FOLLOWING ITS INCLUDES.
# Asking the compositor for its configuration text is not enough: that text
# does not expand includes (§8.1), so bindings behind one would go unaudited.

# WHERE THIS CHECKOUT LIVES, named once.
#
# It was written out thirty-three times across these files, which meant moving
# the checkout -- the whole of switching this session off root -- was thirty-
# three edits and any one of them could be missed silently, because sway does
# not complain about an exec that points at nothing.
set $null /opt/nulllinux

set $mod Mod4

# The interface strike, 10x18, giving 192x60 cells at 1920x1080 (§2.2).
# Pinned to a real strike: a size with no strike is silently SCALED here, and a
# scaled bitmap is the one thing this system exists to avoid (§9.3).
set $font pango:Terminus 12
font $font

include colours.conf
include input.conf
include layout.conf

# ---------------------------------------------------------------- window rules
#
# §8.2: TILING, AND NOTHING SPAWNS FLOATING. The exceptions are enumerated in
# full and this is the whole list. In particular there is deliberately NO rule
# positioning a window where the column will be -- that rule outlives the
# illusion it was written for and ends up opening things invisibly behind the
# column (§7.3).

#: (rule) A modal dialog is gone in seconds; tiling it reflows the layout twice
for_window [window_role="dialog"]      floating enable
for_window [window_role="menu"]        floating enable
for_window [window_type="dialog"]      floating enable

#: (rule) Picture-in-Picture: being above everything else is the entire feature
for_window [title="^Picture-in-Picture$"] floating enable, sticky enable

# A control is a mark and a rule, not a box (§7.1). No title bars, no gaps:
# line art is fine, filled chrome is not.
default_border none
default_floating_border normal 1
titlebar_padding 1
hide_edge_borders both

focus_follows_mouse no

# ---------------------------------------------------------------- the surfaces
#
# ONE BACKGROUND (§7.1), and this system's renderer IS it.
#
# The compositor spawns its own background helper unless told not to, and that
# helper draws on the SAME layer -- so it lands on top of our wallpaper and the
# screen shows a stock photograph while our surface animates invisibly beneath
# it. Nothing reports this: our process is running, drawing, and costing CPU.
# `-` is the documented way to disable it.
swaybg_command -

# The wallpaper is this system's own renderer, not a wallpaper tool: it draws
# the hero as text on the cell grid, suspends when a window covers it, stops
# when the output powers down, and halves its rate on battery (§6.4).
exec_always NULL_ROOT=$null $null/bin/null-wallpaper
exec_always NULL_ROOT=$null $null/bin/null-bar
exec_always NULL_ROOT=$null $null/bin/null-column
# The clipboard history is kept by a watcher, not by the picker: a picker only
# sees what is copied while it is open, which is never (§8.4).
exec_always NULL_ROOT=$null $null/bin/null-clipboard watch

# THE PER-USER HALF, and it needs a caller.
#
# null-install puts everything it can where the SYSTEM looks, so a new account
# gets this desktop by logging in. Two things cannot go there -- a browser's
# userChrome.css and two thunar keys thunar only ever writes per user -- and
# null-firstrun does those. Nothing invoked it: the joins it was written to
# perform were found missing on a freshly installed machine, they were moved
# into null-firstrun, and then NOTHING CALLED NULL-FIRSTRUN either. A tool with
# no caller is the same defect one level out, and it is only ever found on a
# machine that is not the one it was written on.
#
# `exec` rather than `exec_always`: it is per-account setup, not a service, and
# re-running it on every config reload would rewrite a browser profile while
# the browser is open. It is idempotent, cheap, and skips what is already done.
exec NULL_ROOT=$null $null/bin/null-firstrun

# Systemd session integration from the distribution. Taken deliberately, by
# literal path: these two files set up the user session, dbus activation and
# the portal. The distribution's BINDING files are deliberately NOT included --
# this system owns its keys, and importing an undescribed set would guarantee
# both collisions and bindings that cannot appear in the keys list.
include /etc/sway/config.d/10-systemd-cgroups.conf
include /etc/sway/config.d/10-systemd-session.conf

# ---------------------------------------------------------------------- the keys
#
# In bindings.conf, which follows Omarchy. Kept in its own file because the
# binding audit and the generated key list both read the configuration text,
# and a file that is only bindings is one that can be replaced wholesale when
# the bindings change without touching anything else (§8.3).
#
# LAYOUTS: there is deliberately no binding for stacking or tabbed. This
# desktop has two layouts -- dwindle (§8.2, bin/null-dwindle) and fullscreen
# -- and a key that produces a third is a key that produces a layout nobody
# asked for and then has to be undone.
include bindings.conf

# --- the idle ladder ---
#
# Generated by bin/null-idle, which is the only thing that edits it and which
# drags the later stages when an earlier one moves (§8.5).
# ---------------------------------------------------------------------------
# THE IDLE LADDER IS OFF, at James's request (2026-09-02), until he turns it
# back on. Nothing dims, blanks, locks, or suspends.
#
# It is commented out here rather than emptied in idle.conf, because the
# timings in idle.conf are still the ones he chose and should be there
# unchanged when this comes back. `exec_always` also means a reload restarts
# swayidle, so stopping the process alone would not have held.
#
# TO RESTORE: delete the '# ' from the line below and run `swaymsg reload`.
# Everything else about the ladder is untouched, so it returns as it was.
# ---------------------------------------------------------------------------
# exec_always pkill -x swayidle; swayidle -w -C $null/config/sway/idle.conf
