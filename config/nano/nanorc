##
## Colours BY NAME. In this system the sixteen ANSI slots are the
## palette: foot.ini is written from the same roles, and
## vt.default_red/grn/blu put them on every virtual console. So
## `blue` here is b9ccff, the accent, and `white` is ffefe6.
##
## The per-language syntax files nano ships are left alone. They live
## under /usr/share/nano and re-deriving them would mean re-deciding
## what a keyword is, which this system has no opinion about.

set titlecolor    black,blue
set statuscolor   black,white
set errorcolor    white,lightred
set promptcolor   white,black
set keycolor      blue,black
set functioncolor yellow,black
set numbercolor   lightblack,black
set scrollercolor lightblack
set selectedcolor black,blue
set spotlightcolor black,yellow
set stripecolor   lightblack
set minicolor     white,black

## A mark and a rule, not a box (7.1).
set linenumbers
set indicator

## What an editor should do without being asked for it.
set autoindent
set tabsize 4
set tabstospaces
set trimblanks
set softwrap
set atblanks
set mouse
set zap

## The shipped syntax files, so a .sh or a .py is coloured at all.
include "/usr/share/nano/*.nanorc"
